+    case 0x0D: h064_0abe(); break;
+    case 0x0E: h064_0b10(); break;
+    case 0x0F: h064_0c62(); break;
+    case 0x10: h064_0cc4(); break;
+    case 0x11: case 0x12: h064_0d4a(); break;
+    case 0x13: h064_0e40(); break;
+    case 0x14: h064_0e9c(); break;
+    case 0x15: h064_13ac(); break;
