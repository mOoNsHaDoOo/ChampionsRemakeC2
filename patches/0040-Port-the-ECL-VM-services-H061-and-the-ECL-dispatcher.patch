+    case 0x1D: h064_17bc(); break;
+    case 0x1E: h012_01fa(); break;
+    case 0x20: h064_0f90(); break;
+    case 0x21: case 0x37: h064_1004(); break;
+    case 0x22: h012_05d6(); break;
+    case 0x23: h012_0688(); break;
+    case 0x24: h012_0766(); break;
+    case 0x25: case 0x26: h012_0b18(); break;
+    case 0x27: h012_0bea(); break;
+    case 0x28: h012_14c8(); break;
+    case 0x29: h012_15ae(); break;
+    case 0x2A: h064_12ca(); break;
