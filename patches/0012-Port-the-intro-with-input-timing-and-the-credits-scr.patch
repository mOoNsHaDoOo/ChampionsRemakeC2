index b45b330..cace7f1 100644
--- a/src_c/readable/h049.c
+++ b/src_c/readable/h049.c
@@ -181,3 +181,65 @@ void draw_text_blitter(u16 col, u16 row, u16 fg, u16 bg, u16 len,
     }
     DisownBlitter();
 }
+
+/*
+ * PORT H049+$012A: copia la tile 8x8 id (dai cinque set: id 1..$2D nel set
+ * 0, poi $2E.., $74.., $BA.., $100..$127) nella cella (x, row) della
+ * griglia 40x25 della bitmap dest, piano per piano (dal 4 allo 0).  Il
+ * numero della tile nel set e' la colonna di 8 pixel nell'immagine.
+ */
+void draw_8x8_tile_raw(u16 x, u16 row, u16 id, struct BitMap *dest,
+                       struct GfxRecord **sets)
+{
+    struct GfxRecord *set;
+    struct BitMap *src;
+    s16 tile = (s16)id;
+    u16 src_bpr;
+    u16 dst_bpr;
+    u16 dst_off;
+    int n;
+    int plane;
+    int r;
+
+    if (tile < 0x2E) {
+        n = 0;
+        tile = (s16)(tile - 1);
+    } else if (tile < 0x74) {
+        n = 1;
+        tile = (s16)(tile - 0x2E);
+    } else if (tile < 0xBA) {
+        n = 2;
+        tile = (s16)(tile - 0x74);
+    } else if (tile < 0x100) {
+        n = 3;
+        tile = (s16)(tile - 0xBA);
+    } else if (tile < 0x128) {
+        n = 4;
+        tile = (s16)(tile - 0x100);
+    } else {
+        return;
+    }
+    set = sets[n];
+    if (set == NULL) {
+        return;
+    }
+    src = set->image;
+    src_bpr = src->BytesPerRow;
+    dst_bpr = dest->BytesPerRow;
+    dst_off = (u16)((u16)(dst_bpr * (u16)(row << 3)) + x);
+    for (plane = 4; plane >= 0; --plane) {
+        const u8 *s = (const u8 *)src->Planes[plane] + (s16)tile;
+        u8 *d = (u8 *)dest->Planes[plane] + dst_off;
+        u16 so = 0;
+        u16 dof = 0;
+
+        for (r = 0; r < 8; ++r) {
+            d[dof] = s[so];
+            so = (u16)(so + src_bpr);
+            dof = (u16)(dof + dst_bpr);
+        }
+    }
+    #if !COK_AMIGA
+    host_display_changed();
+#endif
+}
