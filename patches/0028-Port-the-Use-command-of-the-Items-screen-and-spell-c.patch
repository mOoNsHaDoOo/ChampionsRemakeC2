+/*
+ * PORT H033+$07A4: per un incantesimo della classe 2, e' gia' fra quelli
+ * in memoria (+$1F..+$57)?
+ */
+static u8 spell_in_memory(Character *c, u16 spell)
+{
+    u16 i;                              /* -$2(a5) */
+    u8 found;                           /* -$3(a5) */
+    u8 result;                          /* -$4(a5) */
+
+    spell = mask_byte((u8)spell, 0x7F);
+    result = 0;
+    if (SPELL_B(spell, 0) == 2) {
+        i = 1;
+        found = 0;
+        while (!found && i <= 0x39) {
+            if (mask_byte(c->b[0x1E + i], 0x7F) == spell) {
+                found = 1;
+            }
+            ++i;
+        }
+        result = found;
+    }
+    return result;
+}
