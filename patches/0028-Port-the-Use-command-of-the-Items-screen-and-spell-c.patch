+extern CokMenuItem *g_h085_spell_list;       /* H085+$01B2 */
+
+/* H085+$1B6 + livello * $16: "Special", "1st Level", ... "9th Level". */
+#define H085_LEVEL_NAME(level) \
+    ((const char *)&g_h085_bss[0x1B6 + (level) * 0x16])
+
+void h085_init(void);                        /* H085+$0664 */
+
+#endif
