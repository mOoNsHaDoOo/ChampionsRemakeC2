+
+## v54: suono sull'host (audio.device emulato con SDL2, solo con COK_AUDIO)
+
+**Stato del port**
+- Gli stub di gioco sono finiti; in unported.c restano solo quelli dell'audio, usati senza COK_AUDIO.
+- Le 25 routine senza marcatore PORT sono procedure annidate gia' incluse nei loro chiamanti (H066+$292C, H085+$3EE2), trampolini (H012, H013, H043, H061, H074) e corpi del runtime che il C ha gia' (H002, H015, H020, H045, H049 blitter, H074, H075).
+
+**Portato** (host/audio.c, solo con `make AUDIO=1`; la build Amiga usa il vero audio.device)
+- **audio.device** come i 4 canali di Paula:
+  - una coda di CMD_WRITE per canale (dati a 8 bit con segno, lunghezza, periodo e volume con ADIOF_PERVOL, cicli: 0 = senza fine);
+  - ADCMD_PERVOL cambia periodo e volume del suono in corso;
+  - ADCMD_FINISH interrompe il suono in corso e fa partire il seguente in coda;
+  - CMD_FLUSH svuota il canale.
+- **Mixer** nel callback di SDL a 44100 Hz stereo: clock PAL 3546895 Hz, volume 0..64, canali 0+3 a sinistra e 1+2 a destra.
+- **Richieste finite:** tornano alla loro porta solo nel thread principale (BeginIO e VBlank), sotto il lock dell'audio di SDL.
+- **Senza audio SDL:** le richieste si completano subito, come in v53.
+- **Differenza solo dell'host:** togliendo il server del VBlank (comando $FE, chiusura) i canali si svuotano, perche' H043 libera subito i campioni. Paula continuerebbe a leggerli senza danni; il callback dell'host no.
+
+**Prove** (ASan, driver "disk" di SDL che scrive l'uscita audio su file)
+- **Intro senza tasti:** la musica KRYNN suona per 44 secondi di fila (RMS medio circa 6000). Le frequenze dominanti sono note: 328 Hz (Mi4), 390 (Sol4), 490 (Si4), 519 (Do5), con le armoniche dispari delle onde quadre.
+- **Intro saltata e battaglia:** musica all'avvio e poi i suoni della battaglia.
+- **ASan:** pulito.
+- **Controlli:**
+  - build host senza audio e con `make AUDIO=1` senza warning;
+  - controllo C89 con COK_AUDIO;
+  - MinGW x86 e x64 (anche il controllo di sintassi con COK_AUDIO e gli header SDL);
+  - ctest 8/8.
+
+---
diff --git a/src_c/readable/host/audio.c b/src_c/readable/host/audio.c
index c6b043d..750ff7a 100644
--- a/src_c/readable/host/audio.c
+++ b/src_c/readable/host/audio.c
@@ -1,17 +1,52 @@
 /*
  * Host: audio.device ed Exec per il lettore SoundX (H043/H094), compilato
- * solo con COK_AUDIO.  Per ora e' muto: OpenDevice riesce, BeginIO
- * completa subito la richiesta (torna alla sua porta delle risposte).  Il
- * server del VBlank registrato gira a 50 Hz dal refresh del display (nel
- * thread principale, mai fra Disable ed Enable); Cause esegue subito
+ * solo con COK_AUDIO.
+ *
+ * audio.device e' emulato sopra SDL2 come i 4 canali di Paula: ogni
+ * canale ha la sua coda di CMD_WRITE (dati a 8 bit con segno, lunghezza,
+ * periodo, volume 0..64, cicli: 0 = senza fine); ADCMD_PERVOL cambia
+ * periodo e volume del suono in corso, ADCMD_FINISH lo interrompe (parte
+ * il seguente in coda), CMD_FLUSH svuota tutto.  Il mixer gira nel
+ * callback di SDL (clock PAL 3546895 Hz; canali 0 e 3 a sinistra, 1 e 2 a
+ * destra).  Le richieste finite tornano alle loro porte solo nel thread
+ * principale (BeginIO e VBlank), sotto il lock dell'audio.  Se SDL non
+ * apre l'audio ogni richiesta si completa subito, senza suono.
+ *
+ * Il server del VBlank registrato gira a 50 Hz dal refresh del display
+ * (thread principale, mai fra Disable ed Enable); Cause esegue subito
  * l'interrupt software.  Le porte hanno una coda vera.
  */
 #include "ndk.h"
 
 #ifdef COK_AUDIO
 #include <string.h>
+#include <SDL.h>
+
+#define PAULA_CLOCK     3546895.0
+#define OUT_RATE        44100
+#define QUEUE_LEN       16
+#define DONE_LEN        64
+
+#define CMD_WRITE_NUM   3
+#define CMD_FLUSH_NUM   8
+#define ADCMD_FINISH_NUM 11
+#define ADCMD_PERVOL_NUM 12
+#define ADIOF_PERVOL_FLAG 0x10
+
+typedef struct HostChannel {
+    struct IOAudio *queue[QUEUE_LEN];   /* [0] = in corso */
+    int count;
+    double pos;                         /* campione corrente */
+    UWORD period;
+    UWORD volume;
+    UWORD cycles_left;                  /* 0 = senza fine */
+} HostChannel;
 
 static struct Device s_audio_device;
+static SDL_AudioDeviceID s_dev;
+static HostChannel s_ch[4];
+static struct IOAudio *s_done[DONE_LEN];
+static int s_done_count;
 
 /* Coda di una porta: lista doppia con nodi sentinella come in Exec. */
 static void list_init_if_needed(struct List *l)
@@ -52,8 +87,132 @@ struct Message *host_port_get(struct MsgPort *port)
     return (struct Message *)n;
 }
 
+static void reply(struct IORequest *io)
+{
+    if (io->io_Message.mn_ReplyPort != NULL) {
+        host_port_put(io->io_Message.mn_ReplyPort, &io->io_Message);
+    }
+}
+
+/* Richiesta finita (nel callback o sotto lock): torna al thread principale. */
+static void mark_done(struct IOAudio *io, BYTE error)
+{
+    io->ioa_Request.io_Error = error;
+    if (s_done_count < DONE_LEN) {
+        s_done[s_done_count++] = io;
+    }
+}
+
+/* Avvia la scrittura in testa alla coda del canale. */
+static void start_head(HostChannel *c)
+{
+    struct IOAudio *io;
+
+    c->pos = 0.0;
+    if (c->count == 0) {
+        return;
+    }
+    io = c->queue[0];
+    if (io->ioa_Request.io_Flags & ADIOF_PERVOL_FLAG) {
+        c->period = io->ioa_Period;
+        c->volume = io->ioa_Volume;
+    }
+    c->cycles_left = io->ioa_Cycles;
+}
+
+/* Toglie la scrittura in corso (finita o interrotta) e avvia la seguente. */
+static void pop_head(HostChannel *c, BYTE error)
+{
+    int i;
+
+    if (c->count == 0) {
+        return;
+    }
+    mark_done(c->queue[0], error);
+    for (i = 1; i < c->count; ++i) {
+        c->queue[i - 1] = c->queue[i];
+    }
+    --c->count;
+    start_head(c);
+}
+
+static void SDLCALL mix(void *user, Uint8 *stream, int len)
+{
+    Sint16 *out = (Sint16 *)stream;
+    int frames = len / 4;
+    int f;
+    int k;
+
+    (void)user;
+    for (f = 0; f < frames; ++f) {
+        int left = 0;
+        int right = 0;
+
+        for (k = 0; k < 4; ++k) {
+            HostChannel *c = &s_ch[k];
+            struct IOAudio *io;
+            int s;
+
+            if (c->count == 0 || c->period == 0) {
+                continue;
+            }
+            io = c->queue[0];
+            if (io->ioa_Length == 0 || io->ioa_Data == NULL) {
+                pop_head(c, 0);
+                continue;
+            }
+            s = (int)(signed char)io->ioa_Data[(ULONG)c->pos] *
+                (c->volume > 64 ? 64 : c->volume);
+            if (k == 0 || k == 3) {
+                left += s;
+            } else {
+                right += s;
+            }
+            c->pos += PAULA_CLOCK / (double)c->period / (double)OUT_RATE;
+            while (c->count > 0 && c->pos >= (double)io->ioa_Length) {
+                c->pos -= (double)io->ioa_Length;
+                if (c->cycles_left == 0) {
+                    continue;           /* senza fine */
+                }
+                if (--c->cycles_left == 0) {
+                    pop_head(c, 0);
+                    break;
+                }
+            }
+        }
+        /* 2 canali * 127 * 64 per lato: in 16 bit con margine. */
+        out[f * 2] = (Sint16)(left * 2);
+        out[f * 2 + 1] = (Sint16)(right * 2);
+    }
+}
+
+/* Riporta alle loro porte le richieste finite (thread principale). */
+static void drain_done(void)
+{
+    int i;
+    struct IOAudio *done[DONE_LEN];
+    int n;
+
+    if (s_dev == 0) {
+        return;
+    }
+    SDL_LockAudioDevice(s_dev);
+    n = s_done_count;
+    for (i = 0; i < n; ++i) {
+        done[i] = s_done[i];
+    }
+    s_done_count = 0;
+    SDL_UnlockAudioDevice(s_dev);
+    for (i = 0; i < n; ++i) {
+        reply(&done[i]->ioa_Request);
+    }
+}
+
 BYTE OpenDevice(STRPTR name, ULONG unit, struct IORequest *io, ULONG flags)
 {
+    SDL_AudioSpec want;
+    SDL_AudioSpec have;
+
     (void)unit;
     (void)flags;
     if (strcmp((const char *)name, "audio.device") != 0) {
@@ -62,21 +221,109 @@ BYTE OpenDevice(STRPTR name, ULONG unit, struct IORequest *io, ULONG flags)
     }
     io->io_Device = &s_audio_device;
     io->io_Error = 0;
+    if (s_dev == 0 && SDL_InitSubSystem(SDL_INIT_AUDIO) == 0) {
+        memset(&want, 0, sizeof(want));
+        want.freq = OUT_RATE;
+        want.format = AUDIO_S16SYS;
+        want.channels = 2;
+        want.samples = 1024;
+        want.callback = mix;
+        memset(s_ch, 0, sizeof(s_ch));
+        s_done_count = 0;
+        s_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+        if (s_dev != 0) {
+            SDL_PauseAudioDevice(s_dev, 0);
+        }
+    }
     return 0;
 }
 
 void CloseDevice(struct IORequest *io)
 {
+    int k;
+
+    if (s_dev != 0) {
+        SDL_CloseAudioDevice(s_dev);
+        s_dev = 0;
+        for (k = 0; k < 4; ++k) {
+            while (s_ch[k].count > 0) {
+                pop_head(&s_ch[k], -2);     /* IOERR_ABORTED */
+            }
+        }
+        for (k = 0; k < s_done_count; ++k) {
+            reply(&s_done[k]->ioa_Request);
+        }
+        s_done_count = 0;
+    }
     io->io_Device = NULL;
 }
 
-/* Richiesta completata subito, senza suono. */
 void BeginIO(struct IORequest *io)
 {
+    struct IOAudio *a = (struct IOAudio *)io;
+    ULONG mask = (ULONG)(uintptr_t)io->io_Unit;
+    int k;
+
     io->io_Error = 0;
-    if (io->io_Message.mn_ReplyPort != NULL) {
-        host_port_put(io->io_Message.mn_ReplyPort, &io->io_Message);
+    if (s_dev == 0) {
+        reply(io);                      /* senza audio: subito */
+        return;
     }
+    SDL_LockAudioDevice(s_dev);
+    switch (io->io_Command) {
+    case CMD_WRITE_NUM:
+        for (k = 0; k < 4; ++k) {
+            if (mask & (1UL << k)) {
+                HostChannel *c = &s_ch[k];
+
+                if (c->count < QUEUE_LEN) {
+                    c->queue[c->count++] = a;
+                    if (c->count == 1) {
+                        start_head(c);
+                    }
+                } else {
+                    mark_done(a, -1);
+                }
+                break;
+            }
+        }
+        if (mask == 0) {
+            mark_done(a, -1);
+        }
+        break;
+    case ADCMD_PERVOL_NUM:
+        for (k = 0; k < 4; ++k) {
+            if ((mask & (1UL << k)) && s_ch[k].count > 0) {
+                s_ch[k].period = a->ioa_Period;
+                s_ch[k].volume = a->ioa_Volume;
+            }
+        }
+        mark_done(a, 0);
+        break;
+    case ADCMD_FINISH_NUM:
+        for (k = 0; k < 4; ++k) {
+            if (mask & (1UL << k)) {
+                pop_head(&s_ch[k], -2);
+            }
+        }
+        mark_done(a, 0);
+        break;
+    case CMD_FLUSH_NUM:
+        for (k = 0; k < 4; ++k) {
+            if (mask & (1UL << k)) {
+                while (s_ch[k].count > 0) {
+                    pop_head(&s_ch[k], -2);
+                }
+            }
+        }
+        mark_done(a, 0);
+        break;
+    default:
+        mark_done(a, 0);
+        break;
+    }
+    SDL_UnlockAudioDevice(s_dev);
+    drain_done();
 }
 
 static struct Interrupt *s_vblank_server;
@@ -92,10 +339,27 @@ void AddIntServer(LONG intnum, struct Interrupt *interrupt)
     }
 }
 
+/*
+ * Togliendo il server del VBlank H043 libera subito i campioni ($FE,
+ * chiusura): Paula continuerebbe a leggere quella memoria senza danni,
+ * il callback dell'host no, quindi qui i canali si svuotano.
+ */
 void RemIntServer(LONG intnum, struct Interrupt *interrupt)
 {
+    int k;
+
     if (intnum == 5 && s_vblank_server == interrupt) {
         s_vblank_server = NULL;
+        if (s_dev != 0) {
+            SDL_LockAudioDevice(s_dev);
+            for (k = 0; k < 4; ++k) {
+                while (s_ch[k].count > 0) {
+                    pop_head(&s_ch[k], -2);
+                }
+            }
+            SDL_UnlockAudioDevice(s_dev);
+            drain_done();
+        }
     }
 }
 
@@ -123,6 +387,9 @@ void host_audio_vblank(unsigned long now_ms)
 {
     int n = 0;
 
+    if (s_disabled == 0) {
+        drain_done();
+    }
     if (s_next_vblank == 0) {
         s_next_vblank = now_ms;
     }
