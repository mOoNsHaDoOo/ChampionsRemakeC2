+/* PORT H095+$18CC: (x, y) fuori dalla griglia 11x6 di schieramento? */
+static u8 outside_grid(s16 x, s16 y)
+{
+    if (x >= 0 && x < 0x0B) {
+        return 0;
+    }
+    if (y >= 0 && y < 6) {
+        return 0;
+    }
+    return 1;
+}
