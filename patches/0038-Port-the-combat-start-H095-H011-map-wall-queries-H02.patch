diff --git a/src_c/readable/h095.c b/src_c/readable/h095.c
index b5f23ed..bfd23c3 100644
--- a/src_c/readable/h095.c
+++ b/src_c/readable/h095.c
@@ -1,5 +1,19 @@
 /* H095: dati del modulo (tabelle di word). */
 #include "init_data.h"
+#include "h095.h"
+#include "globals.h"
+#include "h003_exec.h"
+#include "h008.h"
+#include "h011.h"
+#include "h029_gfx.h"
