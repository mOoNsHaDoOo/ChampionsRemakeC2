+    /* H006+$03E8: 29 coppie di long a $3244. */
+    for (s_i = 0; s_i <= 0x1C; ++s_i) {
+        H005_SET_L(0x3244 + s_i * 8, 0);
+        H005_SET_L(0x3244 + s_i * 8 + 4, 0);
+    }
+    /* H006+$041C: due voci da 6 byte a $27B0. */
+    for (s_i = 1; s_i <= 2; ++s_i) {
+        H005_B(0x27B0 + (s_i - 1) * 6) = 0xFF;
