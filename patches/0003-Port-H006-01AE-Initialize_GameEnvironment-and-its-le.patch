+    h030_0c10();
+    h008_139e();
+    h030_0256(0, 0x18, 0x0A, 0, 0x15, "Loading...Please Wait");
+
+    for (s_i = 0; s_i <= 4; ++s_i) {
+        H005_SET_L(0x3338 + s_i * 4, 0);
+    }
+    h034_0032(0xCA, 4);
+    h034_0032(0xCB, 0);
+    h006_00fa();
+
+    for (s_i = 0; s_i <= 0x0B; ++s_i) {
