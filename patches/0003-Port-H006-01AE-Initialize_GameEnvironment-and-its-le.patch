+
+    h029_0408(8, 1, 1, 0, &g_gfx_3334);
+    h029_0408(0x30, 3, 1, 0, &g_gfx_3d8a);
+    h029_0408(0x18, 3, 0x28, 1, &g_gfx_332c);
+    H005_SET_L(0x3D8E, 0);
+    h029_1346();
