diff --git a/src_c/readable/h049.c b/src_c/readable/h049.c
index 2fe274f..a677358 100644
--- a/src_c/readable/h049.c
+++ b/src_c/readable/h049.c
@@ -479,3 +479,65 @@ void mirror_gfx_record(struct GfxRecord *src, struct GfxRecord *dst)
     host_display_changed();
 #endif
 }
+
+/*
+ * PORT H049+$0014: come $012A ma con la maschera del set (piano 0 della
+ * BitMap +$0C): i pixel fuori dalla maschera restano quelli di dest.  Il
+ * byte della maschera usa il passo di riga dell'immagine.
+ */
+void draw_8x8_tile_masked(u16 x, u16 row, u16 id, struct BitMap *dest,
+                          struct GfxRecord **sets)
+{
+    struct GfxRecord *set;
+    struct BitMap *src;
+    const u8 *mask;
+    s16 tile = (s16)id;
+    u16 src_bpr;
+    u16 dst_bpr;
+    u16 dst_off;
+    int n;
+    int plane;
+    int r;
+
+    if (tile < 0x2E) {
+        n = 0;
+        tile = (s16)(tile - 1);
+    } else if (tile < 0x74) {
+        n = 1;
+        tile = (s16)(tile - 0x2E);
+    } else if (tile < 0xBA) {
+        n = 2;
+        tile = (s16)(tile - 0x74);
+    } else if (tile < 0x100) {
+        n = 3;
+        tile = (s16)(tile - 0xBA);
+    } else if (tile < 0x128) {
+        n = 4;
+        tile = (s16)(tile - 0x100);
+    } else {
+        return;
+    }
+    set = sets[n];
+    if (set == NULL) {
+        return;
+    }
+    src = set->image;
+    src_bpr = src->BytesPerRow;
+    mask = (const u8 *)set->mask->Planes[0] + (s16)tile;
+    dst_bpr = dest->BytesPerRow;
+    dst_off = (u16)((u16)(dst_bpr * (u16)(row << 3)) + x);
+    for (plane = 4; plane >= 0; --plane) {
+        const u8 *s = (const u8 *)src->Planes[plane] + (s16)tile;
+        u8 *d = (u8 *)dest->Planes[plane] + dst_off;
+        u16 so = 0;
+        u16 dof = 0;
+
+        for (r = 0; r < 8; ++r) {
+            u8 m = mask[so];
+
+            d[dof] = (u8)((s[so] & m) | (d[dof] & (u8)~m));
+            so = (u16)(so + src_bpr);
+            dof = (u16)(dof + dst_bpr);
+        }
+    }
+}
