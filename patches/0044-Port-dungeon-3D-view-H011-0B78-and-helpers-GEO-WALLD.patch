--- a/src_c/readable/h010_input.c
+++ b/src_c/readable/h010_input.c
@@ -1,4 +1,5 @@
 /* H010: input Intuition, conversione degli eventi, uscita ed errori. */
+#include <stdio.h>
 #include "h010_input.h"
 #include "character.h"
 #include "h053.h"
@@ -224,3 +225,22 @@ void quit_game(void)
     free_game_resources();
     h015_runtime_exit(0);
 }
+
+/*
+ * PORT H010+$0360: scrive il testo (copiato, al piu' len caratteri, fino
+ * allo zero) e va a capo sulla console del processo: il writeln del
+ * runtime (H020+$085A e $082E).  Qui con stdio.
+ */
+void console_writeln(u16 len, const char *text)
+{
+    char buf[0x102];
+    u16 i;
+
+    for (i = 0; i < len && i < sizeof(buf) - 1 && text[i] != '\0'; ++i) {
+        buf[i] = text[i];
+    }
+    buf[i] = '\0';
+    fputs(buf, stdout);
+    fputc('\n', stdout);
+    fflush(stdout);
+}
