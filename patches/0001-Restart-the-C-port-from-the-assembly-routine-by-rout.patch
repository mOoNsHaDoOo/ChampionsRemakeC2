@@ -1,186 +0,0 @@
-/*
- * Caricamento DAX lato host (Windows/macOS/Linux).
- *
- * Il percorso Amiga e' gia' implementato in resources.c:
- * dax_load_block() (H028+$0DD8) usa dos_Open/dos_Read/dos_Seek,
- * AllocMem e dax_rle_decode().
- *
- * Questo modulo e' quindi solo host: legge il file con stdio e riusa
- * dax_rle_decode(), cosi' la VM ECL puo' essere inizializzata anche
- * senza AmigaOS.  Non viene incluso nella build SAS/C (smakefile).
- */
-
-#include "cok/platform.h"
-
-#if !COK_AMIGA
-
-#include <stdio.h>
-#include <stdlib.h>
-#include <string.h>
-
-#include "cok.h"
-#include "cok/resources.h"
-
-static uint8_t *host_read_file(const char *path, size_t *out_size)
-{
-    FILE *file;
-    long length;
-    uint8_t *data;
-
-    if (out_size != NULL) {
-        *out_size = 0;
-    }
-    file = fopen(path, "rb");
-    if (file == NULL) {
-        printf("load file %s fallito\n", path);
-        return NULL;
-    }
-    if (fseek(file, 0, SEEK_END) != 0) {
-        printf("load file %s fallito\n", path);
-        fclose(file);
-        return NULL;
-    }
-    length = ftell(file);
-    if (length < 0 || fseek(file, 0, SEEK_SET) != 0) {
-        printf("load file %s fallito\n", path);
-        fclose(file);
-        return NULL;
-    }
-    data = (uint8_t *)malloc((size_t)length);
-    if (data == NULL) {
-        printf("load file %s fallito (memoria)\n", path);
-        fclose(file);
-        return NULL;
-    }
-    if (length > 0 && fread(data, 1, (size_t)length, file) != (size_t)length) {
-        printf("load file %s fallito\n", path);
-        free(data);
-        fclose(file);
-        return NULL;
-    }
-    fclose(file);
-    if (out_size != NULL) {
-        *out_size = (size_t)length;
-    }
-    return data;
-}
-
-static uint8_t *host_read_data_file(const char *path, size_t *out_size)
-{
-    static const char *prefixes[] = {
-        "",
-        "orig/COK/",
-        "../orig/COK/",
-        "../../orig/COK/",
-        "../../../orig/COK/",
-        "../../../../orig/COK/",
-        "../../../../../orig/COK/",
-        "../COK/",
-        "../../COK/",
-        "data/",
-        "../data/"
-    };
-    const char *env = getenv("COK_DATA_DIR");
-    char candidate[1024];
-    unsigned i;
-    uint8_t *data;
-
-    data = host_read_file(path, out_size);
-    if (data != NULL) {
-        return data;
-    }
-    if (env != NULL && env[0] != '\0') {
-        snprintf(candidate, sizeof(candidate), "%s/%s", env, path);
-        data = host_read_file(candidate, out_size);
-        if (data != NULL) {
-            return data;
-        }
-    }
-    for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); ++i) {
-        snprintf(candidate, sizeof(candidate), "%s%s", prefixes[i], path);
-        if (strcmp(candidate, path) == 0) {
-            continue;
-        }
-        data = host_read_file(candidate, out_size);
-        if (data != NULL) {
-            return data;
-        }
-    }
-    return NULL;
-}
-
-uint8_t *cok_host_dax_load_block(const char *path, uint8_t wanted_id,
-                                 uint16_t *out_size)
-{
-    size_t file_size = 0;
-    uint8_t *file_data;
-    uint16_t table_size;
-    uint16_t entries;
-    size_t data_start;
-    uint16_t i;
-
-    if (out_size != NULL) {
-        *out_size = 0;
-    }
-    file_data = host_read_data_file(path, &file_size);
-    if (file_data == NULL || file_size < 2) {
-        free(file_data);
-        return NULL;
-    }
-
-    table_size = (uint16_t)(file_data[0] | (file_data[1] << 8));
-    entries = (uint16_t)(table_size / 9);
-    data_start = (size_t)2 + table_size;
-    if (data_start > file_size) {
-        free(file_data);
-        return NULL;
-    }
-
-    for (i = 0; i < entries; ++i) {
-        const uint8_t *record = file_data + 2 + (size_t)i * 9;
-        uint32_t rel;
-        uint16_t size;
-        uint16_t packed;
-        uint8_t *output;
-
-        if (record[0] != wanted_id) {
-            continue;
-        }
-        rel = (uint32_t)record[1] |
-              ((uint32_t)record[2] << 8) |
-              ((uint32_t)record[3] << 16) |
-              ((uint32_t)record[4] << 24);
-        size = (uint16_t)(record[5] | (record[6] << 8));
-        packed = (uint16_t)(record[7] | (record[8] << 8));
-        if (data_start + rel + packed > file_size) {
-            free(file_data);
-            return NULL;
-        }
-        output = (uint8_t *)malloc(size ? size : 1);
-        if (output == NULL) {
-            free(file_data);
-            return NULL;
-        }
-        if (dax_rle_decode(file_data + data_start + rel, packed,
-                           output, size) != 0) {
-            free(output);
-            free(file_data);
-            return NULL;
-        }
-        free(file_data);
-        if (out_size != NULL) {
-            *out_size = size;
-        }
-        return output;
-    }
-
-    free(file_data);
-    return NULL;
-}
-
-#else
-/*
- * Build Amiga: il caricamento DAX e' in resources.c (H028+$0DD8).
- * ecl_loader.c non fa parte degli oggetti dello smakefile.
- */
-#endif
