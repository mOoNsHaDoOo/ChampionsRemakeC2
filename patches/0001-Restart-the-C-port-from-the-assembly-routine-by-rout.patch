-static uint32_t audio_event_ticks(uint8_t data, uint16_t tempo)
-{
-    uint32_t ticks;
-
-    if (tempo == 0) {
-        tempo = 15360;
-    }
-    ticks = (1536000UL / (uint32_t)tempo) >> (data & 7);
-    if ((data & 0x08) != 0) {
-        ticks = (ticks * 3u) / 2u;
-    }
-    switch ((data >> 4) & 3) {
-    case 1: ticks = (ticks * 2u) / 3u; break;
-    case 2: ticks = (ticks * 4u) / 5u; break;
-    case 3: ticks = (ticks * 6u) / 7u; break;
-    default: break;
-    }
-    if (ticks == 0) {
-        ticks = 1;
-    }
-    return ticks;
-}
