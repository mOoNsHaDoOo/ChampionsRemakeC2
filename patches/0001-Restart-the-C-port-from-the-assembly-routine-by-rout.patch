-static uint16_t party_menu_visible(uint16_t *out, int has_char, int has_party,
-                                   int can_train)
-{
-    uint16_t count = 0;
-    uint16_t i;
-
-    for (i = 0; i < PARTY_MENU_COUNT; ++i) {
-        if (party_item_visible(i, has_char, has_party, can_train)) {
-            out[count] = i;
-            ++count;
-        }
-    }
-    return count;
-}
