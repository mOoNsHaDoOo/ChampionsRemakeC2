- * Sequenza verificata nel sorgente:
- *   1. attesa iniziale (H007+$064E con 1);
- *   2. fino a 3 cicli: scrn1b, scrn2, text1, text2, crediti;
- *   3. ogni schermata resta circa 3 secondi o fino a un tasto.
- * gothic.lbm viene caricato come font, non mostrato.
- */
-void intro_run(void)
-{
-#if COK_AMIGA
-    int loop;
-
-    (void)audio_init();
-
-    /* H030+$0C10: carica il font, non lo blitta a schermo. */
