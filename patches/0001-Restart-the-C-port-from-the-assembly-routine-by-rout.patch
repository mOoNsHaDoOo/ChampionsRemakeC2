-    SetAPen(rp, (UBYTE)pen);
-    SetDrMd(rp, 0); /* JAM1: solo il pen primario, sfondo intatto */
-
-    line_x = x;
-    line_y = y;
-    col = 0;
-
-    for (i = 0; text[i] != '\0' && (maxlen <= 0 || i < maxlen); ++i) {
-        uint8_t ch = (uint8_t)text[i];
-        uint16_t idx;
-        uint16_t off;
-        const uint8_t *src;
-        WORD sx;
-
-        /*
-         * Le stringhe del livello leggibile usano '\n' per separare
