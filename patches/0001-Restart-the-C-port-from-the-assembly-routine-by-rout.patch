-/* H094+$0576..$0614: envelope di volume. */
-static void audio_env_volume_tick(EnvState *e)
-{
-    int guard;
-
-    if (!e->active) {
-        return;
-    }
-    if (e->count > 0u) {
-        --e->count;
-        e->current = (int16_t)(e->current + e->delta);
-        if (e->count > 0u) {
-            return;
-        }
-    }
-    for (guard = 0; guard < 64; ++guard) {
-        int b1;
-        int b2;
-        int target;
-
-        if (e->ptr == NULL || e->ptr >= e->end) {
-            e->active = 0;
-            return;
-        }
-        b1 = *e->ptr++;
-        if (b1 == 0xFF) {
-            b2 = (e->ptr < e->end) ? *e->ptr : 0;
-            if (b2 == 0) {
-                e->ended = 1;
-            }
-            e->active = 0;
-            e->ptr = NULL;
-            return;
-        }
-        if (b1 == 0xFE) {
-            if (e->ptr >= e->end) {
-                e->active = 0;
-                return;
-            }
-            b2 = *e->ptr++;
-            {
-                uint32_t off = (uint32_t)(e->ptr - e->base);
-                uint32_t back = (uint32_t)((b2 + 1) * 2);
-
-                if (off < back) {
-                    e->active = 0;
-                    return;
-                }
-                e->ptr = e->base + (off - back);
-            }
-            continue;
-        }
-        if (e->ptr >= e->end) {
-            e->active = 0;
-            return;
-        }
-        b2 = *e->ptr++;
-        if (b2 & 0x80) {
-            target = (int)e->current + ((b2 - 0xC0) << 8);
-        } else {
-            target = (64 * b2) >> 6;
-        }
-        if (b1 == 0) {
-            e->current = (int16_t)target;
-            continue;
-        }
-        e->count = (uint8_t)b1;
-        if (b1 == 1) {
-            e->current = (int16_t)target;
-            e->delta = 0;
-        } else {
-            e->delta = (int16_t)((target - (int)e->current) / b1);
-        }
-        return;
-    }
-    e->active = 0;
-}
