-/*
- * H030+$0718 (chiamato da H013+$2A64): inserimento del nome.  Il nome
- * originale e' al massimo 14 caratteri (campo da 15 byte con NUL).
- *
- * Il campo di inserimento e' sulla riga 24 (in basso), subito dopo
- * l'etichetta "Character name: " (16 caratteri, colonne 0..15): il
- * testo digitato parte quindi dalla colonna 16.  H030+$0718 disegna il
- * buffer con riga = $18 (24) via UI_DrawText, non a meta' schermo.
- */
-void ui_read_name(char *buffer, uint16_t maxlen)
-{
-    uint16_t length = 0;
-    RastPort *rp;
-
-    if (buffer == NULL || maxlen == 0) {
-        return;
-    }
-    buffer[0] = '\0';
-    for (;;) {
-        uint8_t key;
-
-        ui_restore_game_palette();
-        ui_install_game_pointer(10);
-        rp = ui_get_rastport();
-        if (rp != NULL) {
-            ui_rect_fill(rp, 0, 0, 319, 199, 0);
-            ui_draw_menu_frame(rp, 1);
-            ui_rect_fill(rp, 16 * 8, 24 * 8, 30 * 8, 24 * 8 + 7, 0x0F);
-        }
-        (void)text_font_draw("Character name: ", 0, 24 * 8, (int16_t)0x0D, 16);
-        (void)text_font_draw(buffer, 16 * 8, 24 * 8, (int16_t)0x00,
-                             (int16_t)length);
-
-        key = ui_wait_key();
-        if (key == 0x0D) {
-            break;
-        }
-        if (key == 0x08 || key == 0x7F) {
-            if (length > 0) {
-                --length;
-                buffer[length] = '\0';
-            }
-            continue;
-        }
-        if (key == 0x1B) {
-            break;
-        }
-        if (key >= 0x20 && key < 0x7F && length + 1 < maxlen) {
-            buffer[length++] = (char)key;
-            buffer[length] = '\0';
-        }
-    }
-    if (length == 0) {
-        strncpy(buffer, "New Character", maxlen - 1);
-        buffer[maxlen - 1] = '\0';
-    }
-}
