-void party_menu(void)
-{
-    uint16_t selected = 0;
-    uint8_t key;
-
-    for (;;) {
-        uint16_t visible[PARTY_MENU_COUNT];
-        uint16_t count;
-        int has_char = (G_CURRENT_CHAR != NULL);
-        int has_party = (G_PARTY_HEAD != NULL);
-        int can_train = party_training_available();
-
-        count = party_menu_visible(visible, has_char, has_party, can_train);
-        if (count == 0) {
-            return;
-        }
-        if (selected >= count) {
-            selected = (uint16_t)(count - 1);
-        }
-
-        party_menu_draw(selected, has_char, has_party, can_train);
-        key = ui_wait_key();
-        {
-            int16_t mx, my;
-            if (ui_mouse_take(&mx, &my)) {
-                int row = my / 8;
-
-                if (row >= 12 && row < 12 + (int)count) {
-                    uint16_t hit = (uint16_t)(row - 12);
-
-                    /* H008+$1E44: prima evidenzia, poi conferma. */
-                    if (hit == selected) {
-                        key = 0x0D;
-                    } else {
-                        selected = hit;
-                        continue;
-                    }
-                } else if (row == 24 && mx >= 0 && mx < 7 * 8) {
-                    key = 0x0D;                 /* Select */
-                } else {
-                    continue;
-                }
-            }
-        }
-
-        if (key == COK_KEY_UP) {
-            if (selected == 0) {
-                selected = (uint16_t)(count - 1);
-            } else {
-                --selected;
-            }
-            continue;
-        }
-        if (key == 0x4D) {
-            ++selected;
-            if (selected >= count) {
-                selected = 0;
-            }
-            continue;
-        }
-
-        /* Invio seleziona la voce evidenziata. */
-        if (key == 0x0D) {
-            key = party_menu_items[visible[selected]].key;
-        } else {
-            /* Tasto lettera: accettato solo se la voce e' visibile. */
-            uint16_t pos;
-            int found = 0;
-
-            for (pos = 0; pos < count; ++pos) {
-                if (party_menu_items[visible[pos]].key == key) {
-                    found = 1;
-                    break;
-                }
-            }
-            if (!found) {
-                continue;
-            }
-        }
-
-        /* BEGIN Adventuring richiede almeno un personaggio nel party. */
-        if (key == 'B' && !has_party) {
-            continue;
-        }
-
-        switch (key) {
-        case 'C': party_create_character(); break;
-        case 'D': party_drop_character(); break;
-        case 'M': party_modify_character(); break;
-        case 'T': party_train_character(); break;
-        case 'K': party_knight_change(); break;
-        case 'V': party_view_character(); break;
-        case 'A': party_add_character(); break;
-        case 'R': party_remove_character(); break;
-        case 'L': party_load_game(); break;
-        case 'S': party_save_game(); break;
-        case 'B': return;                 /* BEGIN Adventuring */
-        case 'E': party_exit_to_workbench(); return;
-        default: break;
-        }
-    }
-}
