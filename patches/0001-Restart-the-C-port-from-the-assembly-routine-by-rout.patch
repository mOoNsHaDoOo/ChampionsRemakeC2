-    cok_icon_blit_composed(rp, 24, 48,
-                           cok_icon_ready_body(old_state),
-                           cok_icon_head_cell(old_state),
-                           old_state->size, old_remap);
-    cok_icon_blit_composed(rp, 96, 48,
-                           cok_icon_action_body(old_state),
-                           cok_icon_head_cell(old_state),
-                           old_state->size, old_remap);
-    cok_icon_blit_composed(rp, 24, 96,
-                           cok_icon_ready_body(new_state),
-                           cok_icon_head_cell(new_state),
-                           new_state->size, new_remap);
-    cok_icon_blit_composed(rp, 96, 96,
-                           cok_icon_action_body(new_state),
-                           cok_icon_head_cell(new_state),
-                           new_state->size, new_remap);
-
-    cok_icon_border(rp, 24, 48, 0x0F);
-    cok_icon_border(rp, 96, 48, 0x0F);
-    cok_icon_border(rp, 24, 96, 0x0F);
-    cok_icon_border(rp, 96, 96, 0x0F);
-
-    (void)text_font_draw("old", 64, 48, (int16_t)0x0F, 0);
-    (void)text_font_draw("new", 64, 96, (int16_t)0x0F, 0);
-    (void)text_font_draw("ready   action", 24, 80, (int16_t)0x0F, 0);
-    (void)text_font_draw("ready   action", 24, 128, (int16_t)0x0F, 0);
