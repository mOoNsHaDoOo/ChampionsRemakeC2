-/*
- * Champions of Krynn - foglio di tile 8x8 (H034/H044/H049).
- *
- * I record 0xCA/0xCB dei file 8X8D*.DAA hanno un header di 9 byte seguito
- * dai piani del bitmap.  H049+$012A copia 8 byte per riga da un piano
- * sorgente a un piano di destinazione; il codice del tile e' la colonna
- * (offset in byte) nel foglio.  Il bordo dei menu H044+$01C2 usa il record
- * 0xCA, che contiene 38 colonne da 8x8 pixel su 4 piani.
- */
-
-#include <string.h>
-
-#include "cok/platform.h"
-
-#if !COK_AMIGA
-#include <stdlib.h>
-#endif
-
-#include "cok.h"
-#include "cok/resources.h"
-#include "cok/tile8.h"
-
-#define TILE8_HEADER_SIZE   9u
-#define TILE8_HEIGHT        8u
-#define TILE8_PLANES        4u
-
-Tile8Sheet *tile8_sheet_load_daa(const char *path, uint8_t wanted_id)
-{
-    uint8_t *payload;
-    uint16_t size;
-    uint32_t data_size;
-    uint32_t plane_size;
-    uint16_t bytes_per_row;
-    Tile8Sheet *sheet;
-#if COK_AMIGA
-    /* SAS/C riserva "chip" come qualificatore: usiamo chip_ptr. */
-    uint8_t *chip_ptr;
-#endif
-
-    if (path == NULL) {
-        return NULL;
-    }
-    size = 0;
-    payload = cok_daa_load_block(path, wanted_id, &size);
-    if (payload == NULL || size <= TILE8_HEADER_SIZE) {
-        if (payload != NULL) {
-            cok_daa_free(payload, size);
-        }
-        return NULL;
-    }
-
-    data_size = (uint32_t)size - TILE8_HEADER_SIZE;
-    plane_size = (uint32_t)TILE8_HEIGHT * TILE8_PLANES;
-    if ((data_size % plane_size) != 0) {
-        cok_daa_free(payload, size);
-        return NULL;
-    }
-    bytes_per_row = (uint16_t)(data_size / plane_size);
-    if (bytes_per_row == 0) {
-        cok_daa_free(payload, size);
-        return NULL;
-    }
-
-#if COK_AMIGA
-    sheet = (Tile8Sheet *)AllocMem((ULONG)sizeof(*sheet), MEMF_CLEAR);
-#else
-    sheet = (Tile8Sheet *)calloc(1, sizeof(*sheet));
-#endif
-    if (sheet == NULL) {
-        cok_daa_free(payload, size);
-        return NULL;
-    }
-#if COK_AMIGA
-    /*
-     * H029+$0A0E/H029+$091E: i piani decompressi vengono copiati
-     * nelle BitMap allocate con AllocRaster, cioe' in CHIP RAM.
-     * Conserviamo il foglio direttamente in CHIP.
-     */
-    chip_ptr = (uint8_t *)AllocMem((ULONG)size, MEMF_CHIP);
-    if (chip_ptr == NULL) {
-        cok_daa_free(payload, size);
-        FreeMem(sheet, (ULONG)sizeof(*sheet));
-        return NULL;
-    }
-    memcpy(chip_ptr, payload, size);
-    cok_daa_free(payload, size);
-    payload = chip_ptr;
-#endif
-    sheet->storage = payload;
-    sheet->storage_size = size;
-    sheet->planes = payload + TILE8_HEADER_SIZE;
-    sheet->bytes_per_row = bytes_per_row;
-    sheet->height = TILE8_HEIGHT;
-    sheet->planes_count = TILE8_PLANES;
-    sheet->tile_count = (uint8_t)(bytes_per_row > 255u ? 255u : bytes_per_row);
-    return sheet;
-}
-
-void tile8_sheet_free(Tile8Sheet *sheet)
-{
-    if (sheet == NULL) {
-        return;
-    }
-    if (sheet->storage != NULL) {
-        cok_daa_free(sheet->storage, sheet->storage_size);
-    }
-#if COK_AMIGA
-    FreeMem(sheet, (ULONG)sizeof(*sheet));
-#else
-    free(sheet);
-#endif
-}
-
-void tile8_draw(RastPort *rp, const Tile8Sheet *sheet,
-                uint16_t tile_column, uint16_t cell_x, uint16_t cell_y)
-{
-#if COK_AMIGA
-    BitMap *bitmap;
-    uint16_t row;
-    uint8_t plane;
-    uint32_t plane_size;
-    uint32_t dst_base;
-
-    if (rp == NULL || sheet == NULL || sheet->planes == NULL) {
-        return;
-    }
-    bitmap = (BitMap *)rp->BitMap;
-    if (bitmap == NULL || bitmap->BytesPerRow == 0) {
-        return;
-    }
-    if (tile_column >= sheet->bytes_per_row) {
-        return;
-    }
-    if (cell_x >= bitmap->BytesPerRow) {
-        return;
-    }
-
-    plane_size = (uint32_t)sheet->bytes_per_row * sheet->height;
-    dst_base = (uint32_t)cell_y * 8u * bitmap->BytesPerRow + cell_x;
-
-    for (plane = 0; plane < sheet->planes_count; ++plane) {
-        const uint8_t *src;
-        uint8_t *dst;
-
-        if (plane >= bitmap->Depth || bitmap->Planes[plane] == NULL) {
-            break;
-        }
-        src = sheet->planes + (uint32_t)plane * plane_size + tile_column;
-        dst = (uint8_t *)bitmap->Planes[plane] + dst_base;
-        for (row = 0; row < sheet->height; ++row) {
-            dst[(uint32_t)row * bitmap->BytesPerRow] =
-                src[(uint32_t)row * sheet->bytes_per_row];
-        }
-    }
-#else
-    (void)rp;
-    (void)sheet;
-    (void)tile_column;
-    (void)cell_x;
-    (void)cell_y;
-#endif
-}
