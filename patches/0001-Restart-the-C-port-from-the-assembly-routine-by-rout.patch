-/*
- * Voice8Header (chunk VHDR, 20 byte) del FORM 8SVX:
- *   +0x00 oneShotHiSamples (ULONG)
- *   +0x04 repeatHiSamples  (ULONG)
- *   +0x08 samplesPerHiCycle (ULONG)
- *   +0x0C samplesPerSec    (UWORD)
- *   +0x0E ctOctave         (UBYTE)
- *   +0x0F sCompression     (UBYTE: 0 none, 1 FibDelta)
- *   +0x10 volume           (Fixed 0..0x10000)
- * `vhdr` punta all'ID chunk "VHDR": i dati iniziano a vhdr+8.
- */
-static void audio_vhdr_parse(const uint8_t *vhdr, uint16_t *rate,
-                             uint8_t *compression, uint32_t *volume,
-                             uint32_t *one_shot, uint32_t *repeat)
-{
-    if (rate != NULL) {
-        *rate = audio_be16(vhdr + 8u + 12u);
-    }
-    if (compression != NULL) {
-        *compression = vhdr[8u + 15u];
-    }
-    if (volume != NULL) {
-        *volume = audio_be32(vhdr + 8u + 16u);
-    }
-    if (one_shot != NULL) {
-        *one_shot = audio_be32(vhdr + 8u + 0u);
-    }
-    if (repeat != NULL) {
-        *repeat = audio_be32(vhdr + 8u + 4u);
-    }
-}
-
-/*
- * Fibonacci-delta (8SVX sCmpFibDelta=1): da `n` byte sorgente (pad + valore
- * iniziale + 4-bit delta) produce 2*(n-2) campioni a 8 bit.
- */
-static const int8_t audio_fib_delta[16] = {
-    -34, -21, -13, -8, -5, -3, -2, -1, 0, 1, 2, 3, 5, 8, 13, 21
-};
-
-static uint32_t audio_fibdelta_unpack(const uint8_t *src, uint32_t n,
-                                      uint8_t *dst, uint32_t max_out)
-{
-    int8_t x;
-    uint32_t i;
-    uint32_t lim;
-
-    if (n < 2u) {
-        return 0u;
-    }
-    lim = (n - 2u) * 2u;
-    if (lim > max_out) {
-        lim = max_out;
-    }
-    x = (int8_t)src[1u];
-    for (i = 0; i < lim; ++i) {
-        uint8_t d = src[2u + (i >> 1)];
-        d = (i & 1u) ? (d & 0x0Fu) : (d >> 4);
-        x = (int8_t)(x + audio_fib_delta[d]);
-        dst[i] = (uint8_t)x;
-    }
-    return lim;
-}
