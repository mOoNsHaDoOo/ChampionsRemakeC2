-/*
- * Champions of Krynn - parser IFF/ILBM in C leggibile.
- *
- * Ricostruisce H086 (parser FORM/LIST/PROP/CAT), H087 (BMHD/CMAP/BODY)
- * e H088 (ByteRun1).
- */
-
-#include <string.h>
-#include "cok/platform.h"
-#if !COK_AMIGA
-#include <stdlib.h>
-#endif
-
-#include "cok.h"
-#include "cok/iff.h"
-#include "cok/resources.h"
-
-#define ID_FORM 0x464F524Du
-#define ID_ILBM 0x494C424Du
-#define ID_BMHD 0x424D4844u
-#define ID_CMAP 0x434D4150u
-#define ID_BODY 0x424F4459u
-#define ID_LIST 0x4C495354u
-#define ID_PROP 0x50524F50u
-#define ID_CAT  0x43415420u
-
-static uint32_t read_be32(const uint8_t *p)
-{
-    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
-           ((uint32_t)p[2] << 8) | p[3];
-}
-
-static uint16_t read_be16(const uint8_t *p)
-{
-    return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
-}
-
-/* H086: attraversa chunk FORM/LIST/PROP/CAT. */
-const uint8_t *iff_find_chunk(const uint8_t *data, size_t size, uint32_t wanted,
-                              uint32_t *out_size)
-{
-    size_t pos = 0;
-
-    while (pos + 8 <= size) {
-        uint32_t id = read_be32(data + pos);
-        uint32_t len = read_be32(data + pos + 4);
-        const uint8_t *payload = data + pos + 8;
-
-        if (pos + 8 + len > size) {
-            return NULL;
-        }
-        if (id == wanted) {
-            if (out_size != NULL) {
-                *out_size = len;
-            }
-            return payload;
-        }
-        pos += 8 + ((len + 1) & ~1u); /* chunk allineati a 2 */
-    }
-    return NULL;
-}
-
-/*
- * H087+H088: carica un ILBM.
- * BODY e' memorizzato per righe e per piano: per ogni riga, un blocco
- * ByteRun1 per ciascun piano.
- */
-int ilbm_load(const uint8_t *data, size_t size, IlbmImage *image)
-{
-    uint32_t form_size;
-    uint32_t bmhd_size;
-    uint32_t cmap_size;
-    uint32_t body_size;
-    const uint8_t *bmhd;
-    const uint8_t *cmap;
-    const uint8_t *body;
-    uint32_t pos;
-    uint16_t bytes_per_row;
-    uint16_t total_planes;
-    uint16_t i;
-    uint16_t y;
-    uint16_t plane;
-    uint8_t *scratch;
-
-    if (image == NULL || size < 12) {
-        return -1;
-    }
-    if (read_be32(data) != ID_FORM || read_be32(data + 8) != ID_ILBM) {
-        return -1;
-    }
-    form_size = read_be32(data + 4);
-    if (form_size < 4u || form_size + 8u > size) {
-        return -1;
-    }
-
-    bmhd = iff_find_chunk(data + 12, form_size - 4, ID_BMHD, &bmhd_size);
-    cmap = iff_find_chunk(data + 12, form_size - 4, ID_CMAP, &cmap_size);
-    body = iff_find_chunk(data + 12, form_size - 4, ID_BODY, &body_size);
-    if (bmhd == NULL || bmhd_size < 20 || body == NULL) {
-        return -1;
-    }
-
-    image->width       = read_be16(bmhd + 0);
-    image->height      = read_be16(bmhd + 2);
-    image->depth       = bmhd[8];
-    image->masking     = bmhd[9];
-    image->compression = bmhd[10];
-
-    if (image->width == 0u || image->height == 0u ||
-        image->width > 2048u || image->height > 2048u ||
-        image->depth == 0u || image->depth > 8u ||
-        image->compression > 1u) {
-        return -1;
-    }
-
-    image->colors = 0;
-    if (cmap != NULL) {
-        image->colors = (uint16_t)(cmap_size / 3);
-        if (image->colors > 256u) {
-            image->colors = 256u;
-        }
-        for (i = 0; i < image->colors; ++i) {
-            image->palette[i][0] = cmap[i * 3 + 0];
-            image->palette[i][1] = cmap[i * 3 + 1];
-            image->palette[i][2] = cmap[i * 3 + 2];
-        }
-    }
-
-#if COK_AMIGA
-    image->bitmap = (BitMap *)AllocMem(sizeof(BitMap), MEMF_CLEAR);
-#else
-    image->bitmap = (BitMap *)calloc(1, sizeof(BitMap));
-#endif
-    if (image->bitmap == NULL) {
-        return -1;
-    }
-    bytes_per_row = (uint16_t)((image->width + 15u) / 16u * 2u);
-    image->bitmap->BytesPerRow = bytes_per_row;
-    image->bitmap->Rows = image->height;
-    image->bitmap->Depth = (uint8_t)image->depth;
-
-    for (i = 0; i < image->depth; ++i) {
-#if COK_AMIGA
-        image->bitmap->Planes[i] = AllocRaster(image->width, image->height);
-#else
-        image->bitmap->Planes[i] = calloc(1, (size_t)bytes_per_row * image->height);
-#endif
-        if (image->bitmap->Planes[i] == NULL) {
-            ilbm_free(image);
-            return -1;
-        }
-        memset(image->bitmap->Planes[i], 0,
-               (size_t)bytes_per_row * image->height);
-    }
-
-    /*
-     * ILBM con masking=mskHasMask: nel BODY c'e' un piano di maschera in
-     * piu' dopo i piani colore.  Va consumato, altrimenti tutte le righe
-     * successive vengono lette fuori fase.  Il piano maschera non serve
-     * al blit a schermo intero, quindi lo decodifichiamo in uno scratch.
-     */
-    total_planes = (uint16_t)image->depth;
-    scratch = NULL;
-    if (image->masking == 1) {
-        total_planes++;
-#if COK_AMIGA
-        scratch = (uint8_t *)AllocMem(bytes_per_row, MEMF_CLEAR);
-#else
-        scratch = (uint8_t *)malloc(bytes_per_row);
-#endif
-        if (scratch == NULL) {
-            ilbm_free(image);
-            return -1;
-        }
-    }
-
-    pos = 0;
-    for (y = 0; y < image->height; ++y) {
-        for (plane = 0; plane < total_planes; ++plane) {
-            uint8_t *dst;
-
-            if (plane < image->depth) {
-                dst = (uint8_t *)image->bitmap->Planes[plane] +
-                      (size_t)y * bytes_per_row;
-            } else {
-                dst = scratch;
-            }
-            if (pos + 1 > body_size) {
-                goto decode_fail;
-            }
-            if (image->compression == 1) {
-                /* ByteRun1: la riga compressa termina quando sono prodotti
-                 * bytes_per_row byte. */
-                size_t written = 0;
-                while (written < bytes_per_row && pos + 1 < body_size) {
-                    int8_t c = (int8_t)body[pos++];
-                    if (c >= 0) {
-                        size_t n = (size_t)c + 1;
-                        if (pos + n > body_size || written + n > bytes_per_row) {
-                            goto decode_fail;
-                        }
-                        memcpy(dst + written, body + pos, n);
-                        pos += n;
-                        written += n;
-                    } else if (c != -128) {
-                        size_t n = (size_t)(1 - c);
-                        if (pos >= body_size || written + n > bytes_per_row) {
-                            goto decode_fail;
-                        }
-                        memset(dst + written, body[pos++], n);
-                        written += n;
-                    }
-                }
-                if (written != bytes_per_row) {
-                    goto decode_fail;
-                }
-            } else {
-                if (pos + bytes_per_row > body_size) {
-                    goto decode_fail;
-                }
-                memcpy(dst, body + pos, bytes_per_row);
-                pos += bytes_per_row;
-            }
-        }
-    }
-
-    if (scratch != NULL) {
-#if COK_AMIGA
-        FreeMem(scratch, bytes_per_row);
-#else
-        free(scratch);
-#endif
-    }
-    return 0;
-
-decode_fail:
-    if (scratch != NULL) {
-#if COK_AMIGA
-        FreeMem(scratch, bytes_per_row);
-#else
-        free(scratch);
-#endif
-    }
-    ilbm_free(image);
-    return -1;
-}
-
-void ilbm_free(IlbmImage *image)
-{
-    uint16_t i;
-
-    if (image == NULL || image->bitmap == NULL) {
-        return;
-    }
-    for (i = 0; i < image->bitmap->Depth; ++i) {
-        if (image->bitmap->Planes[i] != NULL) {
-#if COK_AMIGA
-            FreeRaster(image->bitmap->Planes[i],
-                       image->bitmap->BytesPerRow * 8,
-                       image->bitmap->Rows);
-#else
-            free(image->bitmap->Planes[i]);
-#endif
-        }
-    }
-#if COK_AMIGA
-    FreeMem(image->bitmap, sizeof(BitMap));
-#else
-    free(image->bitmap);
-#endif
-    image->bitmap = NULL;
-}
