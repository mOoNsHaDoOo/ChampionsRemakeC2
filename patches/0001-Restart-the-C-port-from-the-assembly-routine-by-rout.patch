-/* Copia un blocco di forma d'onda ciclica nel buffer della richiesta. */
-static uint32_t audio_fill_loop(AudioVoice *v, AudioRequest *r)
-{
-    uint32_t j;
-    uint32_t length = v->cycle;
-    uint32_t stride = 1u;
-
-    if (r == NULL || r->buffer == NULL) {
-        return 0u;
-    }
-
-    if (v->sample != NULL && length != 0u) {
-        stride = v->sample->length / length;
-        if (stride == 0u) {
-            stride = 1u;
-        }
-    }
-    if (length < 2u || length > AUDIO_REQUEST_SAMPLES) {
-        return 0u;
-    }
-    for (j = 0; j < length; ++j) {
-        if (v->sample != NULL) {
-            r->buffer[j] = (int8_t)v->sample->data[j * stride];
-        } else {
-            r->buffer[j] = audio_fallback_wave[j & 63u];
-        }
-    }
-    return length;
-}
-
-static void audio_voice_send_loop(AudioVoice *v)
-{
-    AudioRequest *r;
-    uint32_t chunk;
-
-    if (v->channel >= AUDIO_CHANNELS) {
-        return;
-    }
-    r = audio_req_get();
-    if (r == NULL) {
-        return;
-    }
-    chunk = audio_fill_loop(v, r);
-    if (r->buffer == NULL || chunk == 0u) {
-        return;
-    }
-    audio_req_send(r, v->channel, CMD_WRITE, ADIOF_PERVOL, r->buffer,
-                   chunk, v->period, v->volume, 0);
-    ++audio_notes_started;
-    /* cycles=0: il device ripete il ciclo; non serve un nuovo write. */
-    v->buf_end = 0xFFFFFFFFUL;
-}
-
-static void audio_voice_send_oneshot(AudioVoice *v)
-{
-    AudioRequest *r;
-
-    if (v->data == NULL || v->data_len == 0u ||
-        v->channel >= AUDIO_CHANNELS) {
-        return;
-    }
-    r = audio_req_get();
-    if (r == NULL) {
-        return;
-    }
-    if (v->owned != NULL) {
-        r->owned = v->owned;
-        r->owned_size = v->owned_size;
-        v->owned = NULL;
-        v->owned_size = 0;
-    }
-    audio_req_send(r, v->channel, CMD_WRITE, ADIOF_PERVOL, v->data,
-                   v->data_len, v->period, v->volume, 1);
-    ++audio_notes_started;
-    v->buf_end = v->note_end;
-    v->data_len = 0u;
-}
-
-static void audio_voice_pervol(AudioVoice *v)
-{
-    AudioRequest *r;
-
-    if (v == NULL || !v->used || v->channel >= AUDIO_CHANNELS) {
-        return;
-    }
-    r = audio_req_get();
-    if (r != NULL) {
-        audio_req_send(r, v->channel, ADCMD_PERVOL, ADIOF_PERVOL,
-                       NULL, 0, v->period, v->volume, 0);
-    }
-}
-
-static void audio_voice_env_service(AudioVoice *v)
-{
-    int env_active;
-
-    if (v == NULL || !v->used) {
-        return;
-    }
-    if (v->vol_env.active) {
-        audio_env_volume_tick(&v->vol_env);
-        {
-            int vol = v->vol_env.current;
-            if (vol < 0) {
-                vol = 0;
-            }
-            if (vol > 64) {
-                vol = 64;
-            }
-            v->volume = (uint8_t)vol;
-        }
-    }
-    if (v->ptch_env.active) {
-        audio_env_period_tick(&v->ptch_env);
-        {
-            uint16_t p = (uint16_t)v->ptch_env.current;
-            if (p < 124u) {
-                p = 124u;
-            }
-            v->period = p;
-        }
-    }
-    if (v->vol_env.ended || v->ptch_env.ended) {
-        (void)audio_voice_release(v, 1);
-        return;
-    }
-    env_active = (v->vol_env.active || v->ptch_env.active);
-    if (env_active) {
-        audio_voice_pervol(v);
-    }
-}
