-#else
-static uint8_t *host_read_daa_file(const char *path, size_t *out_size)
-{
-    static const char *prefixes[] = {
-        "",
-        "orig/COK/",
-        "../orig/COK/",
-        "../../orig/COK/",
-        "../../../orig/COK/",
