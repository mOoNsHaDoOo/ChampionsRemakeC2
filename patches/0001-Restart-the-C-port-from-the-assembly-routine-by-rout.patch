-/*
- * H008+$01FC
- *
- * Mostra titolo e opzione, abilita IDCMP e restituisce il tasto premuto.
- * I dieci argomenti originali sono geometria/flag della finestra; qui sono
- * mantenuti per compatibilita' con il chiamante.
- */
-static uint8_t ui_request_choice_impl(uint8_t *result,
-                                      uint8_t arg1, uint8_t arg2,
-                                      uint16_t arg3, uint16_t arg4,
-                                      uint16_t arg5,
-                                      const char *option, uint16_t arg6,
-                                      const char *title, uint16_t arg7,
-                                      int hotkeys)
-{
-    uint8_t key;
-    uint16_t option_col;
-    uint16_t selected;
-    uint16_t words;
-
-    (void)arg1; (void)arg2;
-    (void)arg4; (void)arg6;
-
-    ui_set_window_idcmp();
-
-    /*
-     * H042+$0254: il menu ricarica i 32 colori da H005+$52AE prima di
-     * disegnare.  Senza questo passaggio restano attivi i colori
-     * dell'ultima immagine dell'introduzione.
-     */
-    ui_restore_game_palette();
-    /* H008+$0986: fuori dalla mappa il puntatore e' l'indice 0x0A (spada). */
-    ui_install_game_pointer(10);
-
-    /*
-     * H008+$03C8: l'opzione parte dalla colonna strlen(title).
-     * Il titolo originale termina con uno spazio, quindi la prima
-     * colonna dell'opzione e' proprio strlen(title).
-     */
-    option_col = (title != NULL) ? (uint16_t)strlen(title) : 0;
-    words = ui_word_count(option);
-    selected = 0;
-
-    ui_choice_draw(title, option, option_col, arg3, arg4, arg5, arg7,
-                   selected, hotkeys);
-
-    for (;;) {
-        key = ui_wait_key();
-        {
-            int16_t mx, my;
-            if (ui_mouse_take(&mx, &my)) {
-                uint16_t wi = 0;
-                uint16_t wi_start = 0;
-                int hit = -1;
-
-                /* H008+$1E4E: le opzioni sono sulla riga 24. */
-                if (my / 8 != 24) {
-                    continue;
-                }
-                while (option[wi_start] != '\0') {
-                    uint16_t ws;
-                    uint16_t wl;
-                    while (option[wi_start] == ' ') ++wi_start;
-                    if (option[wi_start] == '\0') break;
-                    ws = wi_start;
-                    while (option[wi_start] != '\0' && option[wi_start] != ' ') ++wi_start;
-                    wl = (uint16_t)(wi_start - ws);
-                    if (mx >= (int16_t)((option_col + ws) * 8) &&
-                        mx < (int16_t)((option_col + ws + wl) * 8)) {
-                        hit = (int)wi;
-                        break;
-                    }
-                    ++wi;
-                }
-                if (hit >= 0) {
-                    uint16_t start;
-
-                    if ((uint16_t)hit == selected) {
-                        /* H008+$1E44: click sulla parola selezionata. */
-                        start = ui_word_start(option, selected);
-                        key = (uint8_t)option[start];
-                        if (key >= 'a' && key <= 'z') key = (uint8_t)(key & 0x5F);
-                        break;
-                    }
-                    /* Il primo click evidenzia soltanto la parola. */
-                    selected = (uint16_t)hit;
-                    ui_choice_draw(title, option, option_col, arg3, arg4,
-                                   arg5, arg7, selected, hotkeys);
-                }
-                continue;
-            }
-        }
-
-        if ((key == UI_KEY_LEFT || key == UI_KEY_UP) && words > 0) {
-            if (selected == 0) {
-                selected = (uint16_t)(words - 1);
-            } else {
-                --selected;
-            }
-            ui_choice_draw(title, option, option_col, arg3, arg4, arg5,
-                           arg7, selected, hotkeys);
-            continue;
-        }
-        if ((key == UI_KEY_RIGHT || key == UI_KEY_DOWN) && words > 0) {
-            ++selected;
-            if (selected >= words) {
-                selected = 0;
-            }
-            ui_choice_draw(title, option, option_col, arg3, arg4, arg5,
-                           arg7, selected, hotkeys);
-            continue;
-        }
-        if (key == 0x0D && words > 0) {
-            uint16_t start = ui_word_start(option, selected);
-            key = (uint8_t)option[start];
-            if (key >= 'a' && key <= 'z') {
-                key = (uint8_t)(key & 0x5F);
-            }
-        }
-        break;
-    }
-
-    if (result != NULL) {
-        *result = key;
-    }
-    return key;
-}
