-static void audio_music_step(uint16_t ticks)
-{
-    uint8_t i;
-
-    if (!audio_device_open || !audio_pool_port_open) {
-        return;
-    }
-    audio_time += ticks;
-
-    for (i = 0; i < AUDIO_SLOTS; ++i) {
-        AudioVoice *v = &audio_voices[i];
-
-        if (!v->used) {
-            continue;
-        }
-        if (v->stopping) {
-            (void)audio_voice_release(v, 1);
-            continue;
-        }
-        audio_voice_env_service(v);
-        if (!v->used || v->stopping) {
-            continue;
-        }
-        if (audio_time >= v->note_end) {
-            (void)audio_voice_release(v, 1);
-            continue;
-        }
-        if (audio_time >= v->buf_end) {
-            if (v->oneshot) {
-                audio_voice_send_oneshot(v);
-            } else if (v->cycle != 0u) {
-                audio_voice_send_loop(v);
-            }
-        }
-    }
-
-    for (i = 0; audio_music_loaded && i < audio_track_count; ++i) {
-        audio_track_update(&audio_tracks[i], audio_time);
-    }
-}
