-    { 'T', "Train Character" },
-    { 'K', "Knight Change Classes" },
-    { 'V', "View Character" },
-    { 'A', "Add Character to Party" },
-    { 'R', "Remove Character from Party" },
-    { 'L', "Load Saved Game" },
-    { 'S', "Save Current Game" },
-    { 'B', "BEGIN Adventuring" },
-    { 'E', "Exit to Workbench" }
-};
-
-#define PARTY_MENU_COUNT    ((uint16_t)(sizeof(party_menu_items) / sizeof(party_menu_items[0])))
-#define COK_KEY_UP          0x4C
-#define COK_KEY_DOWN        0x4D
