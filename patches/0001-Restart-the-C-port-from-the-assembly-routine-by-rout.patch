-/* ---------------------------------------------------------------- */
-/* Main: H001+$0058                                                  */
-/* ---------------------------------------------------------------- */
-
-void game_main(void)
-{
-    char choice;
-
-    /* H005 e i buffer ECL devono esistere prima di ogni accesso G_*. */
-    game_memory_init();
-
-    /*
-     * Inizializzazione: tabelle, prefisso dati, ambiente, introduzione.
-     * H004+$0C28 prepara le tabelle; H006+$01AE allocca stato e risorse;
-     * H007+$09D8 carica le immagini introduttive e avvia l'audio.
-     */
-    tables_init();
-    cok_select_volume_prefix();
-    game_env_init();
-    intro_run();
-
-    /* Prompt iniziale: "Champions of Krynn v1.0" / "Play Demo". */
-    G_PROMPT_TIMEOUT = 3000;
-    G_PROMPT_KEY = 'D';
-    choice = (char)ui_request_choice_hotkeys(
-        (uint8_t *)&choice,
-        0, 0, 0x0F, 0x0A, 0x0D,
-        "Play Demo", 9,
-        "Champions of Krynn v1.0 ", 0x18);
-    G_PROMPT_TIMEOUT = 0;
-    G_PROMPT_KEY = 0;
-
-    for (;;) {
-        char upper;
-
-        /* Normalizza la risposta: 'd' e 'D' selezionano la demo. */
-        upper = choice;
-        if (upper >= 'a' && upper <= 'z') {
-            upper = (char)(upper & 0x5F);
-        }
-        G_DEMO_FLAG = (upper == 'D');
-
-        if (G_DEMO_FLAG) {
-            /* Ramo demo: gruppo risorse 2 e scenario iniziale 9. */
-            G_RESOURCE_GROUP = 2;
-            G_DEMO_SCENARIO = 9;
-            /*
-             * La demo originale parte con un party precaricato.  Nel
-             * livello leggibile, se non c'e' ancora un party, ne creiamo
-             * uno minimo per non entrare nello scenario senza personaggi.
-             */
-            if (G_PARTY_HEAD == NULL) {
-                party_create_character();
-            }
-        } else {
-            /*
-             * Ramo normale: verifica della distribuzione.
-             * H009+$010C restituisce un byte; H009+$0000 contiene la word
-             * di controllo $3F8F. In caso di fallimento viene mostrato
-             * l'errore di input H010+$0332.
-             */
-            if (!check_distribution()) {
-                fatal_input_error();
-            }
-            if (H009_G->check_word != 0x3F8F) {
-                fatal_input_error();
-            }
-
-            G_RESOURCE_GROUP = 1;
-            party_menu();
-
-            /*
-             * H013+$4BFC ritorna solo con BEGIN Adventuring.  Exit passa
-             * da H010+$0332 (fatal_input_error) e non deve entrare nello
-             * scenario.  Se non c'e' un party valido si torna al menu.
-             */
-            if (G_EXIT_REQUEST) {
-                return;
-            }
-            if (G_PARTY_HEAD == NULL) {
-                continue;
-            }
-        }
-
-        /*
-         * Carica la vista corrente con le quattro coordinate di H005+$2826.
-         * Poi entra nel ciclo dello scenario e, al ritorno, esegue la pulizia.
-         */
-        world_view_load(G_VIEW_0, G_VIEW_1, G_VIEW_2, G_VIEW_3);
-        scenario_main_loop();
-        session_cleanup();
-
-        /*
-         * Dopo una partita demo si torna all'introduzione e si ripropone
-         * il prompt con timeout 1000. Nel ramo normale il ciclo riparte
-         * direttamente dal menu del party.
-         */
-        if (G_DEMO_FLAG) {
-            G_RESOURCE_GROUP = 0;
-            intro_run();
-
-            G_PROMPT_TIMEOUT = 1000;
-            G_PROMPT_KEY = 'D';
-            choice = (char)ui_request_choice_hotkeys(
-                (uint8_t *)&choice,
-                0, 0, 0x0F, 0x0A, 0x0D,
-                "Play Demo", 9,
-                "Champions of Krynn v1.0 ", 0x18);
-            G_PROMPT_TIMEOUT = 0;
-            G_PROMPT_KEY = 0;
-        }
-
-        /*
-         * L'assembly azzera D2 e salta sempre a H001+$0168: il main non
-         * ritorna. L'uscita avviene tramite i percorsi di errore/exit.
-         */
-    }
-}
