-extern void combat_actor_turn(CombatActor *actor); /* H059+$1498 */
-extern void combat_apply_damage(CombatActor *actor); /* H096 */
-extern void combat_check_end(void);          /* H097 */
-
-/* H062+$156C..$15B4: somma di Rand(facce)+1 per ogni dado, a 16 bit. */
-uint16_t combat_roll_dice(uint16_t count, uint16_t faces)
-{
-    uint16_t sum = 0;
-    uint16_t i;
-
-    if (faces == 0u) {
-        return 0;
-    }
-    for (i = 0; i < count; ++i) {
-        sum = (uint16_t)(sum + (uint16_t)(rand() % faces) + 1u);
-    }
-    return sum;
-}
-
-/* H096+$043E..$0486: dado + bonus, risultato conservato a 8 bit. */
-int combat_base_damage(const CharacterRecord *ch, int attack_index)
-{
-    int value;
-
-    if (ch == NULL || attack_index < 0 || attack_index > 1) {
-        return 0;
-    }
-    value = (int)combat_roll_dice(ch->attack_dice[attack_index],
-                                  ch->attack_faces[attack_index]);
-    value += (int)ch->attack_bonus[attack_index];
-    return (int)(uint8_t)value;
-}
-
-/* H005+$2392: tabella di puntatori agli attori. */
-static CombatActorTable *combat_actors(void)
-{
-    return (CombatActorTable *)(void *)((uint8_t *)H005_G + 0x2392);
-}
-
-/* H059+$1782 */
-void combat_begin(void)
-{
-    H005_G->native_context = 5; /* contesto nativo = combattimento */
-    combat_prepare_actors();
-}
-
-/* H059+$1498 + ciclo di H059+$1782 */
-void combat_round(void)
-{
-    CombatActorTable *table = combat_actors();
-    int i;
-
-    for (i = 0; i < COMBAT_ACTOR_SLOTS; ++i) {
-        CombatActor *actor = table->actors[i];
-        if (actor == NULL) {
-            continue;
-        }
-        if (actor->runtime_link == 0) {
-            continue;
-        }
-        combat_actor_turn(actor);
-        combat_apply_damage(actor);
-        combat_check_end();
-    }
-}
-
-/* Condizione di fine: nessun attore con link runtime. */
-int combat_finished(void)
-{
-    CombatActorTable *table = combat_actors();
-    int i;
-
-    for (i = 0; i < COMBAT_ACTOR_SLOTS; ++i) {
-        if (table->actors[i] != NULL && table->actors[i]->runtime_link != 0) {
-            return 0;
-        }
-    }
-    return 1;
-}
