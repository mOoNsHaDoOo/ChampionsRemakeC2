-static void cok_icon_adjust_u16(uint16_t *value, uint16_t max,
-                                const char *title,
-                                const CokIconState *old_state,
-                                const CokIconState *state)
-{
-    for (;;) {
-        uint8_t key;
-
-        cok_icon_screen(old_state, state);
-        key = ui_request_choice(NULL, 0, 0, 0x0F, 0x0A, 0x0D,
-                                cok_icon_adjust_menu, 0, title,
-                                (uint16_t)strlen(title));
-        if (key == 'N') {
-            *value = (uint16_t)((*value + 1u) % max);
-        } else if (key == 'P') {
-            *value = (uint16_t)((*value == 0) ? (max - 1u) : (*value - 1u));
-        } else {
-            break;
-        }
-    }
-}
-
-static void cok_icon_adjust_nibble(CokIconState *state, uint16_t part,
-                                   int high, const char *title,
-                                   const CokIconState *old_state)
-{
-    for (;;) {
-        uint8_t value;
-        uint8_t key;
-        uint8_t *nibble = &state->pair[part];
-
-        value = high ? (uint8_t)((*nibble >> 4) & 0x0F) :
-                       (uint8_t)(*nibble & 0x0F);
-        cok_icon_screen(old_state, state);
-        key = ui_request_choice(NULL, 0, 0, 0x0F, 0x0A, 0x0D,
-                                cok_icon_adjust_menu, 0, title,
-                                (uint16_t)strlen(title));
-        if (key == 'N') {
-            value = (uint8_t)((value + 1u) % 16u);
-        } else if (key == 'P') {
-            value = (uint8_t)((value == 0) ? 15u : (value - 1u));
-        } else {
-            break;
-        }
-        if (high) {
-            *nibble = (uint8_t)((*nibble & 0x0F) | (value << 4));
-        } else {
-            *nibble = (uint8_t)((*nibble & 0xF0) | value);
-        }
-    }
-}
