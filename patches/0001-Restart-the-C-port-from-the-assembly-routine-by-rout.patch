-/*
- * H066+$1640/H066+$1B0E: i personaggi sono file da 426 byte.
- * Il percorso originale e' quello di salvataggio; qui usiamo SAVE/.
- */
-#define COK_CHAR_EXT ".CHR"
-#define COK_CHAR_MAX 16
-
-static void cok_sanitize_name(const char *src, char *dst, size_t size)
-{
-    size_t i = 0;
-
-    while (src != NULL && src[i] != '\0' && i + 1 < size) {
-        char c = src[i];
-        if (c == '/' || c == ':' || c == '\\') {
-            c = '_';
-        }
-        dst[i] = c;
-        ++i;
-    }
-    dst[i] = '\0';
-}
-
-static void cok_save_dir(char *out, size_t size)
-{
-    const char *resolved = cok_data_path("SAVE", out, size);
-
-    /* Su host cok_data_path non scrive nel buffer: copiamo il risultato. */
-    if (out != NULL && size != 0 && resolved != out) {
-        strncpy(out, resolved != NULL ? resolved : "SAVE", size);
-        out[size - 1] = '\0';
-    }
-}
-
-static void cok_ensure_save_dir(void)
-{
-    char dir[512];
-
-    cok_save_dir(dir, sizeof(dir));
-#if COK_AMIGA
-    (void)dos_CreateDir((CONST_STRPTR)dir);
-#elif defined(_WIN32)
-    (void)_mkdir(dir);
-#else
-    (void)mkdir(dir, 0777);
-#endif
-}
-
-static void cok_character_path(const char *name, char *out, size_t size)
-{
-    char clean[32];
-    char rel[64];
-
-    cok_sanitize_name(name, clean, sizeof(clean));
-    snprintf(rel, sizeof(rel), "SAVE/%s%s", clean, COK_CHAR_EXT);
-    (void)cok_data_path(rel, out, size);
-}
-
-static void cok_free_character(CharacterRecord *ch)
-{
-    if (ch == NULL) {
-        return;
-    }
-#if COK_AMIGA
-    FreeMem(ch, sizeof(*ch));
-#else
-    free(ch);
-#endif
-}
-
-static int cok_has_char_ext(const char *name)
-{
-    size_t n;
-
-    if (name == NULL) {
-        return 0;
-    }
-    n = strlen(name);
-    if (n <= 4) {
-        return 0;
-    }
-    return (name[n - 4] == '.' &&
-            (name[n - 3] == 'C' || name[n - 3] == 'c') &&
-            (name[n - 2] == 'H' || name[n - 2] == 'h') &&
-            (name[n - 1] == 'R' || name[n - 1] == 'r'));
-}
-
-static uint16_t cok_list_characters(char names[][32], uint16_t max,
-                                    const char **items)
-{
-    char dir[512];
-    uint16_t count = 0;
-
-    cok_ensure_save_dir();
-    cok_save_dir(dir, sizeof(dir));
-#if COK_AMIGA
-    {
-        BPTR lock;
-        FileInfoBlock fib;
-
-        lock = dos_Lock((CONST_STRPTR)dir, ACCESS_READ);
-        if (lock != 0) {
-            if (dos_Examine(lock, &fib)) {
-                while (count < max && dos_ExNext(lock, &fib)) {
-                    if (fib.fib_DirEntryType < 0 &&
-                        cok_has_char_ext(fib.fib_FileName)) {
-                        size_t n = strlen(fib.fib_FileName);
-                        size_t copy = n - 4;
-                        if (copy >= 32) copy = 31;
-                        memcpy(names[count], fib.fib_FileName, copy);
-                        names[count][copy] = '\0';
-                        items[count] = names[count];
-                        ++count;
-                    }
-                }
-            }
-            dos_UnLock(lock);
-        }
-    }
-#elif defined(_WIN32)
-    {
-        char pattern[512];
-        intptr_t handle;
-        struct _finddata_t ent;
-
-        snprintf(pattern, sizeof(pattern), "%s/*",
-                 dir[0] ? dir : ".");
-        handle = _findfirst(pattern, &ent);
-        if (handle != -1) {
-            do {
-                if (count < max && cok_has_char_ext(ent.name)) {
-                    size_t n = strlen(ent.name);
-                    size_t copy = n - 4;
-                    if (copy >= 32) copy = 31;
-                    memcpy(names[count], ent.name, copy);
-                    names[count][copy] = '\0';
-                    items[count] = names[count];
-                    ++count;
-                }
-            } while (_findnext(handle, &ent) == 0);
-            _findclose(handle);
-        }
-    }
-#else
-    {
-        DIR *d = opendir(dir[0] ? dir : ".");
-        struct dirent *ent;
-        if (d != NULL) {
-            while (count < max && (ent = readdir(d)) != NULL) {
-                if (cok_has_char_ext(ent->d_name)) {
-                    size_t n = strlen(ent->d_name);
-                    size_t copy = n - 4;
-                    if (copy >= 32) copy = 31;
-                    memcpy(names[count], ent->d_name, copy);
-                    names[count][copy] = '\0';
-                    items[count] = names[count];
-                    ++count;
-                }
-            }
-            closedir(d);
-        }
-    }
-#endif
-    return count;
-}
