-static int manifest_name_valid(const char *name)
-{
-    size_t i;
-
-    for (i = 0; i < 42; ++i) {
-        unsigned char c = (unsigned char)name[i];
-
-        if (c == 0) {
-            return i != 0;
-        }
-        if (c == '/' || c == ':' || c == '\\') {
-            return 0;
-        }
-    }
-    return 0;                           /* nessun terminatore nei 42 byte */
