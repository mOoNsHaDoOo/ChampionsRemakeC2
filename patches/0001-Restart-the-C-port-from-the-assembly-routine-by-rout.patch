-/*
- * H010+$042E: converte il raw key Amiga in ASCII, come si aspetta
- * UI_RequestChoice (H001 confronta il risultato con 'D').
- * Layout Amiga: 0x20='A' .. 0x39='Z', 0x01='1' .. 0x0A='0'.
- */
-static uint8_t ui_rawkey_to_ascii(uint16_t code)
-{
-    /* Mappa raw Amiga: riga Q, riga A, riga Z (non A..Z lineare). */
-    static const char row_q[] = "QWERTYUIOP";
-    static const char row_a[] = "ASDFGHJKL";
-    static const char row_z[] = "ZXCVBNM,.";
-
-    if (code >= 0x10 && code <= 0x19) {
-        return (uint8_t)row_q[code - 0x10];
-    }
-    if (code >= 0x20 && code <= 0x28) {
-        return (uint8_t)row_a[code - 0x20];
-    }
-    if (code >= 0x31 && code <= 0x39) {
-        return (uint8_t)row_z[code - 0x31];
-    }
-    if (code >= 0x01 && code <= 0x0A) {
-        if (code == 0x0A) {
-            return (uint8_t)'0';
-        }
-        return (uint8_t)('1' + (code - 0x01));
-    }
-    if (code == 0x40) {
-        return (uint8_t)' ';
-    }
-    if (code == 0x41) {
-        return (uint8_t)0x08; /* Backspace */
-    }
-    if (code == 0x42) {
-        return (uint8_t)0x09; /* Tab */
-    }
-    if (code == 0x44) {
-        return (uint8_t)0x0D; /* Return */
-    }
-    if (code == 0x45) {
-        return (uint8_t)0x1B; /* Escape */
-    }
-    if (code == 0x46) {
-        return (uint8_t)0x7F; /* Delete */
-    }
-    return (uint8_t)(code & 0x7F);
-}
-
-/* H010: attesa tasto tramite Intuition. */
-uint8_t ui_wait_key(void)
-{
-    struct Window *win = (struct Window *)G_WINDOW;
-    IntuiMessage *msg;
-    uint8_t key = 0x0D; /* Return */
-
-    if (win == NULL || win->UserPort == NULL) {
-        return key;
-    }
-
-    /* Scarta un eventuale click rimasto pendente da un'attesa precedente. */
-    g_mouse_pending = 0;
-
-    for (;;) {
-        /*
-         * Polling a 1 tick (20 ms): mantiene vivo il loop musicale anche
-         * quando il gioco e' fermo in un menu.  GetMsg non blocca.
-         */
-        msg = (IntuiMessage *)GetMsg(win->UserPort);
-        if (msg == NULL) {
-            dos_Delay(1);
-            audio_music_update(1);
-            continue;
-        }
-
-        if (msg->Class == IDCMP_RAWKEY) {
-            /* Bit 7 = rilascio del tasto: va ignorato. */
-            if ((msg->Code & 0x80) != 0) {
-                ReplyMsg(msg);
-                continue;
-            }
-            key = ui_rawkey_to_ascii(msg->Code);
-            ReplyMsg(msg);
-            return key;
-        }
-        if (msg->Class == IDCMP_MOUSEBUTTONS) {
-            /*
-             * H010+$08E2: IECODE_LBUTTON (0x68) vale Return, IECODE_RBUTTON
-             * (0x69) vale Escape.  Il rilascio (0xE8/0xE9) va ignorato.
-             */
-            if (msg->Code == SELECTDOWN) {
-                g_mouse_x = msg->MouseX;
-                g_mouse_y = msg->MouseY;
-                g_mouse_pending = 1;
-                ReplyMsg(msg);
-                return 0x0D;
-            }
-            if (msg->Code == MENUDOWN) {
-                ReplyMsg(msg);
-                return 0x1B;
-            }
-            ReplyMsg(msg);
-            continue;
-        }
-        ReplyMsg(msg);
-    }
-}
-
-/*
- * H007+$064E: attesa a tempo con polling degli eventi.
- * L'originale fa Delay(5) per (arg*10) volte e interrompe se H005+$5305
- * diventa diverso da zero.  Qui usiamo direttamente la coda IDCMP.
- */
-uint8_t ui_wait_key_timeout(uint16_t loops)
-{
-#if COK_AMIGA
-    struct Window *win = (struct Window *)G_WINDOW;
-    IntuiMessage *msg;
-    uint16_t i;
-
-    if (win == NULL || win->UserPort == NULL) {
-        dos_Delay((ULONG)loops * 5u);
-        return 0;
-    }
-    for (i = 0; i < (uint16_t)(loops * 10u); ++i) {
-        dos_Delay(5);
-        audio_music_update(5);
-        while ((msg = (IntuiMessage *)GetMsg(win->UserPort)) != NULL) {
-            if (msg->Class == IDCMP_RAWKEY ||
-                msg->Class == IDCMP_MOUSEBUTTONS ||
-                msg->Class == IDCMP_CLOSEWINDOW) {
-                ReplyMsg(msg);
-                return 1;
-            }
-            ReplyMsg(msg);
-        }
-    }
-    return 0;
-#else
-    (void)loops;
-    return 0;
-#endif
-}
-
-void ui_set_window_idcmp(void)
-{
-    ULONG flags = IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS | IDCMP_CLOSEWINDOW;
-    if (G_WINDOW != NULL) {
-        ui_modify_idcmp(G_WINDOW, flags);
-    }
-}
-
-/* Uscita reale dal processo AmigaDOS. */
-void runtime_exit(void)
-{
-    dos_Exit(0);
-}
-
-/* Ripristino video: attende il frame e il blitter. */
-void graphics_restore(void)
