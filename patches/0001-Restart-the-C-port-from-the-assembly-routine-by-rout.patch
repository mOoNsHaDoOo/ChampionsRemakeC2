-
-static uint8_t ecl_read_byte(const EclVm *vm, uint16_t logical_pc)
-{
-    uint16_t offset = (uint16_t)(logical_pc - ECL_PC_BASE);
-
-    if (offset >= ECL_PROGRAM_SIZE) {
-        return 0; /* EXIT: PC fuori dal buffer ECL */
-    }
-    return ecl_program(vm)[offset];
-}
-
-static uint16_t ecl_read_word_be(const uint8_t *base, uint16_t offset)
-{
-    return (uint16_t)((base[offset] << 8) | base[offset + 1]);
-}
-
-/* H061+$1F3C: (alto << 8 | basso) - $4B00 */
-uint16_t ecl_decode_address(uint8_t high, uint8_t low)
-{
-    return (uint16_t)((((uint16_t)high << 8) | low) - ECL_ADDR_BIAS);
-}
-
-static uint16_t ecl_operand_address(const EclOperand *op)
-{
-    return ecl_decode_address(op->value, op->control);
-}
-
-/*
- * H061+$3244: stringa a 6 bit, 4 caratteri per 3 byte.
- * 0x20 = spazio, altrimenti ASCII(valore + 0x40).
- */
-void ecl_decode_string_6bit(const uint8_t *packed, uint16_t count, char *out)
-{
-    uint16_t produced = 0;
-    uint32_t bit = 0;
-    uint32_t total_bits = (uint32_t)count * 8u;
-
-    /* H061+$3244: count e' il numero di byte compressi, non di caratteri.
-     * I codici sono letti MSB-first; 0 viene scartato, 1..31 -> +$40,
-     * 32..63 restano invariati.  Massimo 255 caratteri + NUL. */
-    while (bit + 6u <= total_bits && produced < 255u) {
-        uint32_t v = 0;
-        int k;
-
-        for (k = 0; k < 6; ++k) {
-            uint32_t b = bit + (uint32_t)k;
-            v = (v << 1) |
-                ((packed[b >> 3] >> (7u - (b & 7u))) & 1u);
-        }
-        bit += 6u;
-        if (v != 0u) {
-            out[produced++] = (v < 32u) ? (char)(v + 0x40u) : (char)v;
-        }
-    }
-    out[produced] = '\0';
-}
-
-/*
- * H061+$1670: legge un operando.
- * Restituisce 1 se riconosciuto, 0 se il descrittore non e' gestito.
- */
-int ecl_read_operand(EclVm *vm, EclOperand *op)
-{
-    uint16_t off = (uint16_t)(vm->pc - ECL_PC_BASE);
-    uint8_t desc;
-    uint8_t control;
-
-    memset(op, 0, sizeof(*op));
-    if ((uint32_t)off + 1u >= ECL_PROGRAM_SIZE) {
-        vm->halted = 1;
-        return 0;
-    }
-    desc = vm->program[off];
-    control = vm->program[off + 1];
-    op->descriptor = desc;
-    op->control = control;
-    vm->pc = (uint16_t)(vm->pc + 2);
-
-    if (desc == ECL_DESC_WORD || desc == ECL_DESC_ADDR || desc == ECL_DESC_WORD2 ||
-        desc == ECL_DESC_ADDR_ALT || desc == ECL_DESC_BYTE_ALT) {
-        op->value = ecl_read_byte(vm, vm->pc);
-        vm->pc++;
-        return 1;
-    }
-
-    if (desc == ECL_DESC_STRING || desc == ECL_DESC_STRING_ALT) {
-        uint16_t bytes = control;      /* H061: il control byte e' il conteggio byte */
-        uint8_t packed[255];
-        uint16_t i;
-
-        if (control == 0) {
-            return 1;                  /* stringa runtime/vuota */
-        }
-        if ((uint32_t)off + 2u + (uint32_t)bytes > ECL_PROGRAM_SIZE) {
-            vm->halted = 1;
-            return 0;
-        }
-        for (i = 0; i < bytes; ++i) {
-            packed[i] = ecl_read_byte(vm, (uint16_t)(vm->pc + i));
-        }
-        ecl_decode_string_6bit(packed, bytes, (char *)op->string);
-        vm->pc = (uint16_t)(vm->pc + bytes);
-        return 1;
-    }
-
-    return 1; /* descrittori 0x00 e 0x06..0x7F: nessun byte extra */
-}
-
-/* H061+$184E: valutazione semplificata. */
-int16_t ecl_eval_operand(EclVm *vm, const EclOperand *op)
-{
-    uint16_t address;
-
-    switch (op->descriptor) {
-    case ECL_DESC_BYTE:
-    case ECL_DESC_WORD:
-        return op->control;
-
-    case ECL_DESC_ADDR:
-    case ECL_DESC_STRING:
-    case ECL_DESC_BYTE_ALT:
-        address = ecl_operand_address(op);
-        if (address < ECL_ADDR_END_STATE_A) {
-            return (int16_t)ecl_read_word_be(G_STATE_A, address);
-        }
-        if (address >= ECL_ADDR_STATE_C && address < ECL_ADDR_STATE_B) {
-            return (int16_t)ecl_read_word_be(G_STATE_C, address - ECL_ADDR_STATE_C);
-        }
-        if (address >= ECL_ADDR_STATE_B && address < ECL_ADDR_END_STATE_B) {
-            return (int16_t)ecl_read_word_be(G_STATE_B, address - ECL_ADDR_STATE_B);
-        }
-        return 0;
-
-    case ECL_DESC_WORD2:
-    case ECL_DESC_ADDR_ALT:
-        return (int16_t)(((uint16_t)op->value << 8) | op->control);
-
-    default:
-        (void)vm;
-        return 0;
-    }
-}
-
-static void ecl_store_word(uint16_t address, uint16_t value)
-{
-    if (address < ECL_ADDR_END_STATE_A) {
-        G_STATE_A[address] = (uint8_t)(value >> 8);
-        G_STATE_A[address + 1] = (uint8_t)value;
-    } else if (address >= ECL_ADDR_STATE_C && address < ECL_ADDR_STATE_B) {
-        uint16_t o = address - ECL_ADDR_STATE_C;
-        G_STATE_C[o] = (uint8_t)(value >> 8);
-        G_STATE_C[o + 1] = (uint8_t)value;
-    } else if (address >= ECL_ADDR_STATE_B && address < ECL_ADDR_END_STATE_B) {
-        uint16_t o = address - ECL_ADDR_STATE_B;
-        G_STATE_B[o] = (uint8_t)(value >> 8);
-        G_STATE_B[o + 1] = (uint8_t)value;
-    }
-}
-
-static void ecl_push(EclVm *vm, uint16_t return_pc)
-{
-    if (vm->stack_depth < ECL_STACK_MAX) {
-        vm->stack[vm->stack_depth].return_pc = return_pc;
-        vm->stack_depth++;
-    }
-}
-
-static uint16_t ecl_pop(EclVm *vm)
-{
-    if (vm->stack_depth == 0) {
-        return 0;
-    }
-    vm->stack_depth--;
-    return vm->stack[vm->stack_depth].return_pc;
-}
-
-/* Tabella dei conteggi usata dal helper H061+$3E80 (parziale). */
-static const uint8_t ecl_operand_count[66] = {
-    0,1,1,2,3,3,3,3,2,2,1,3,3,0,1,2,2,1,1,0,
-    4,0,0,0,0,0,0,0,0,1,6,2,1,3,2,4,0,0,0,8,
-    3,14,3,0,6,1,5,3,3,0,1,0,1,3,1,3,1,1,0,3,
-    1,0,0,1,1,2
-};
-
-void ecl_skip_next(EclVm *vm)
-{
-    uint8_t op = ecl_read_byte(vm, vm->pc);
-    uint8_t n = (op < 66) ? ecl_operand_count[op] : 0;
-    uint8_t i;
-    vm->pc++;
-    for (i = 0; i < n; ++i) {
-        EclOperand tmp;
-        if (!ecl_read_operand(vm, &tmp)) {
-            break;
-        }
-    }
-}
-
-void ecl_dispatch(EclVm *vm)
-{
-    EclOperand a, b, c;
-    uint8_t op = ecl_read_byte(vm, vm->pc);
-
-    vm->opcode = op;
-    /* H061+$1670 consuma l'opcode prima degli operandi. */
-    vm->pc = (uint16_t)(vm->pc + 1);
-
-    switch (op) {
-    case ECL_OP_EXIT:
-        vm->exit_request = 1;
-        vm->halted = 1;
-        break;
-
-    case ECL_OP_GOTO:
-        ecl_read_operand(vm, &a);
-        vm->pc = ecl_operand_address(&a);
-        break;
-
-    case ECL_OP_GOSUB:
-        ecl_read_operand(vm, &a);
-        ecl_push(vm, vm->pc);
-        vm->pc = ecl_operand_address(&a);
-        break;
-
-    case ECL_OP_COMPARE: {
-        int16_t x, y;
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        x = ecl_eval_operand(vm, &a);
-        y = ecl_eval_operand(vm, &b);
-        vm->compare_result = (x < y) ? -1 : (x > y ? 1 : 0);
-        break;
-    }
-
-    case ECL_OP_ADD: case ECL_OP_SUBTRAT: case ECL_OP_DIVIDE: case ECL_OP_MULTIPLY: {
-        int16_t x, y;
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        ecl_read_operand(vm, &c);
-        x = ecl_eval_operand(vm, &a);
-        y = ecl_eval_operand(vm, &b);
-        switch (op) {
-        case ECL_OP_ADD: x = (int16_t)(x + y); break;
-        case ECL_OP_SUBTRAT: x = (int16_t)(y - x); break;
-        case ECL_OP_DIVIDE: x = (y != 0) ? (int16_t)(x / y) : 0; break;
-        case ECL_OP_MULTIPLY: x = (int16_t)(x * y); break;
-        }
-        ecl_store_word(ecl_operand_address(&c), (uint16_t)x);
-        break;
-    }
-
-    case ECL_OP_RANDOM: {
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        (void)a; (void)b;
-        break;
-    }
-
-    case ECL_OP_SAVE: {
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        if ((a.descriptor >= 0x80) || (b.descriptor >= 0x80)) {
-            /* copia stringa nel buffer H061+$52 */
-        } else {
-            ecl_store_word(ecl_operand_address(&a), (uint16_t)ecl_eval_operand(vm, &b));
-        }
-        break;
-    }
-
-    case ECL_OP_PRINT: case ECL_OP_PRINTCLEAR: {
-        ecl_read_operand(vm, &a);
-        if (a.descriptor == 0x80 || a.descriptor == 0x04) {
-            ecl_native_print((const char *)a.string, op == 18);
-        } else {
-            char buf[16];
-            int n = ecl_eval_operand(vm, &a);
-            /* formattazione numerica: il dettaglio originale e' in H030 */
-            (void)n; (void)buf;
-        }
-        break;
-    }
-
-    case ECL_OP_RETURN:
-        vm->pc = ecl_pop(vm);
-        if (vm->pc == 0) {
-            vm->halted = 1;
-        }
-        break;
-
-    case ECL_OP_IF_EQ: case ECL_OP_IF_NE: case ECL_OP_IF_LT: case ECL_OP_IF_GT: case ECL_OP_IF_LE: case ECL_OP_IF_GE: {
-        bool take;
-        switch (op) {
-        case ECL_OP_IF_EQ: take = (vm->compare_result == 0); break;
-        case ECL_OP_IF_NE: take = (vm->compare_result != 0); break;
-        case ECL_OP_IF_LT: take = (vm->compare_result < 0); break;
-        case ECL_OP_IF_GT: take = (vm->compare_result > 0); break;
-        case ECL_OP_IF_LE: take = (vm->compare_result <= 0); break;
-        default: take = (vm->compare_result >= 0); break;
-        }
-        if (!take) {
-            ecl_skip_next(vm);
-        }
-        break;
-    }
-
-    case ECL_OP_LOAD_FILES:
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        ecl_read_operand(vm, &c);
-        ecl_native_load_files(a.control, b.control, c.control);
-        break;
-
-    case ECL_OP_LOAD_PIECES:
-        ecl_read_operand(vm, &a);
-        ecl_read_operand(vm, &b);
-        ecl_read_operand(vm, &c);
-        ecl_native_load_pieces(a.control, b.control, c.control);
-        break;
-
-    case ECL_OP_COMBAT:
-        ecl_native_combat();
-        break;
-
-    case ECL_OP_VERTICAL_MENU: case ECL_OP_HORIZONTAL_MENU:
-        ecl_native_menu(op);
-        break;
-
-    default: {
-        /*
-         * Handler non ancora portato nel C leggibile: consuma comunque gli
-         * operandi secondo H061+$3E80, altrimenti il PC resta sul primo
-         * byte dell'operando e il flusso ECL si desincronizza.
-         */
-        uint8_t n = (op < 66) ? ecl_operand_count[op] : 0;
-        uint8_t i;
-        EclOperand tmp;
-
-        for (i = 0; i < n; ++i) {
-            if (!ecl_read_operand(vm, &tmp)) {
-                break;
-            }
-        }
-        ecl_native_unknown(op);
-        break;
-    }
-    }
-}
-
-/* H012+$018A: ciclo di esecuzione. */
-void ecl_run(EclVm *vm, uint16_t entry)
-{
-    vm->pc = entry;
-    vm->halted = 0;
-
-    while (!vm->halted && !vm->exit_request) {
-        ecl_dispatch(vm);
-    }
-}
