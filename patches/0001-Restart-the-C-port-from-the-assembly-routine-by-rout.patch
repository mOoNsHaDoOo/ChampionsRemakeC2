-/*
- * Champions of Krynn - record oggetti e mostri (H028/H066).
- */
-
-#include <string.h>
-
-#include "cok.h"
-#include "cok/character_exec.h"
-#include "cok/records.h"
-
-/* ITEM1/ITEM2: il primo byte e' la lunghezza del nome. */
-int item_record_parse(const uint8_t *data, ItemRecord *out)
-{
-    if (data == NULL || out == NULL) {
-        return -1;
-    }
-    out->length = data[0];
-    if (out->length >= sizeof(out->name)) {
-        return -1;
-    }
-    memcpy(out->name, data + 1, out->length);
-    out->name[out->length] = '\0';
-    return 0;
-}
-
-/* MON1CHA/MON2CHA: nome con prefisso di lunghezza. */
-int monster_record_parse(const uint8_t *data, MonsterRecord *out)
-{
-    if (data == NULL || out == NULL) {
-        return -1;
-    }
-    out->name_length = data[0];
-    if (out->name_length > 15) {
-        return -1;
-    }
-    memcpy(out->name, data + 1, out->name_length);
-    out->name[out->name_length] = '\0';
-    if (out->name_length < 15) {
-        memset(out->name + out->name_length, 0, 15u - out->name_length);
-    }
-    memcpy(out->data, data + 16, sizeof(out->data));
-    return 0;
-}
-
-/* H066+$1FDA: record mostro 409 -> runtime 426. */
-int monster_record_to_character(const MonsterRecord *monster,
-                                CharacterRecord *ch)
-{
-    uint8_t raw[MONSTER_RECORD_BYTES];
-
-    if (monster == NULL || ch == NULL) {
-        return -1;
-    }
-    memset(raw, 0, sizeof(raw));
-    raw[0] = monster->name_length;
-    memcpy(raw + 1, monster->name, 15);
-    memcpy(raw + 16, monster->data, sizeof(monster->data));
-    monster_to_character(raw, ch);
-    return 0;
-}
-
-/* Ricerca per nome nei record ITEM. */
-int item_record_find(const uint8_t *data, size_t size, const char *name,
-                     ItemRecord *out)
-{
-    size_t off;
-
-    for (off = 0; off + ITEM_RECORD_BYTES <= size;
-         off += ITEM_RECORD_BYTES) {
-        if (item_record_parse(data + off, out) == 0 &&
-            strcmp(out->name, name) == 0) {
-            return 0;
-        }
-    }
-    return -1;
-}
