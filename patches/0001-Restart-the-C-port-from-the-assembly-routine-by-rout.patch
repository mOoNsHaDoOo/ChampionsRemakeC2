-
-    vm->entries.periodic = entry[0];
-    vm->entries.after_input = entry[1];
-    vm->entries.timed = entry[2];
-    vm->entries.conditional = entry[3];
-    vm->entries.initial = entry[4];
-
-    vm->start_pc = vm->entries.initial;
