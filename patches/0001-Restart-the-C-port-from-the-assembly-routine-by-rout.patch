-/* H010+$0332: percorso di errore/uscita. */
-void fatal_input_error(void)
-{
-    audio_shutdown();
-    graphics_restore();
-    graphics_free_scene();
-    input_shutdown();
-    runtime_exit();
-}
-
-/* H011+$04A6: salva le quattro coordinate della vista. */
-void world_view_load(uint16_t arg1, uint16_t arg2, uint16_t arg3, uint16_t arg4)
-{
-    (void)arg3;
-    (void)arg4;
-
-    G_VIEW_3 = (uint8_t)arg2;          /* H005+$2829 */
-    G_VIEW_2 = (uint8_t)(arg2 >> 8);   /* H005+$2828 */
-    G_VIEW_1 = (uint8_t)arg1;          /* H005+$2827 */
-    G_VIEW_0 = (uint8_t)(arg1 >> 8);   /* H005+$2826 */
-}
