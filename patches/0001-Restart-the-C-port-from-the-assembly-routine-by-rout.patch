index 117c819..0000000
--- a/src_c/readable/inventory.c
+++ /dev/null
@@ -1,312 +0,0 @@
-/*
- * Champions of Krynn - inventario e denaro (livello leggibile).
- *
- * Ricostruisce H063/H065/H067: liste di oggetti, equipaggiamento,
- * monete, gemme e gioielli.
- */
-
-#include <string.h>
-#include <stdio.h>
-
-#include "cok.h"
-#include "cok/inventory.h"
-
-static PartyMoney party_money;
-
-/* ---------------------------------------------------------------- */
-/* Puntatori host a 64 bit: tabelle laterali per teste e next.      */
-/* ---------------------------------------------------------------- */
-
-#define ITEM_LINK_MAX   512
-#define EFFECT_LINK_MAX 128
-#define HEAD_LINK_MAX    32
-
-typedef struct ItemLink {
-    const ItemNode *node;
-    ItemNode       *next;
-} ItemLink;
-
-typedef struct EffectLink {
-    const EffectNode *node;
-    EffectNode       *next;
-} EffectLink;
-
-typedef struct ItemHeadLink {
-    const CharacterRecord *ch;
-    ItemNode              *head;
-} ItemHeadLink;
-
-typedef struct EffectHeadLink {
-    const CharacterRecord *ch;
-    EffectNode            *head;
-} EffectHeadLink;
-
-static ItemLink       item_links[ITEM_LINK_MAX];
-static unsigned       item_link_count;
-static EffectLink     effect_links[EFFECT_LINK_MAX];
-static unsigned       effect_link_count;
-static ItemHeadLink   item_heads[HEAD_LINK_MAX];
-static unsigned       item_head_count;
-static EffectHeadLink effect_heads[HEAD_LINK_MAX];
-static unsigned       effect_head_count;
-
-ItemNode *item_next(const ItemNode *item)
-{
-    unsigned i;
-
-    if (item == NULL) {
-        return NULL;
-    }
-    for (i = 0; i < item_link_count; ++i) {
-        if (item_links[i].node == item) {
-            return item_links[i].next;
-        }
-    }
-    return (ItemNode *)(uintptr_t)item->next;
-}
-
-void item_set_next(ItemNode *item, ItemNode *next)
-{
-    unsigned i;
-
-    if (item == NULL) {
-        return;
-    }
-    for (i = 0; i < item_link_count; ++i) {
-        if (item_links[i].node == item) {
-            item_links[i].next = next;
-            item->next = (uint32_t)(uintptr_t)next;
-            return;
-        }
-    }
-    if (item_link_count < ITEM_LINK_MAX) {
-        item_links[item_link_count].node = item;
-        item_links[item_link_count].next = next;
-        ++item_link_count;
-    }
-    item->next = (uint32_t)(uintptr_t)next;
-}
-
-ItemNode *item_head_get(const CharacterRecord *ch)
-{
-    unsigned i;
-
-    if (ch == NULL) {
-        return NULL;
-    }
-    for (i = 0; i < item_head_count; ++i) {
-        if (item_heads[i].ch == ch) {
-            return item_heads[i].head;
-        }
-    }
-    return (ItemNode *)(uintptr_t)ch->items;
-}
-
-void item_set_head(CharacterRecord *ch, ItemNode *item)
-{
-    unsigned i;
-
-    if (ch == NULL) {
-        return;
-    }
-    for (i = 0; i < item_head_count; ++i) {
-        if (item_heads[i].ch == ch) {
-            item_heads[i].head = item;
-            ch->items = (uint32_t)(uintptr_t)item;
-            return;
-        }
-    }
-    if (item_head_count < HEAD_LINK_MAX) {
-        item_heads[item_head_count].ch = ch;
-        item_heads[item_head_count].head = item;
-        ++item_head_count;
-    }
-    ch->items = (uint32_t)(uintptr_t)item;
-}
-
-EffectNode *effect_next(const EffectNode *fx)
-{
-    unsigned i;
-
-    if (fx == NULL) {
-        return NULL;
-    }
-    for (i = 0; i < effect_link_count; ++i) {
-        if (effect_links[i].node == fx) {
-            return effect_links[i].next;
-        }
-    }
-    return (EffectNode *)(uintptr_t)fx->next;
-}
-
-void effect_set_next(EffectNode *fx, EffectNode *next)
-{
-    unsigned i;
-
-    if (fx == NULL) {
-        return;
-    }
-    for (i = 0; i < effect_link_count; ++i) {
-        if (effect_links[i].node == fx) {
-            effect_links[i].next = next;
-            fx->next = (uint32_t)(uintptr_t)next;
-            return;
-        }
-    }
-    if (effect_link_count < EFFECT_LINK_MAX) {
-        effect_links[effect_link_count].node = fx;
-        effect_links[effect_link_count].next = next;
-        ++effect_link_count;
-    }
-    fx->next = (uint32_t)(uintptr_t)next;
-}
-
-EffectNode *effect_head_get(const CharacterRecord *ch)
-{
-    unsigned i;
-
-    if (ch == NULL) {
-        return NULL;
-    }
-    for (i = 0; i < effect_head_count; ++i) {
-        if (effect_heads[i].ch == ch) {
-            return effect_heads[i].head;
-        }
-    }
-    return (EffectNode *)(uintptr_t)ch->effects;
-}
-
-void effect_set_head(CharacterRecord *ch, EffectNode *fx)
-{
-    unsigned i;
-
-    if (ch == NULL) {
-        return;
-    }
-    for (i = 0; i < effect_head_count; ++i) {
-        if (effect_heads[i].ch == ch) {
-            effect_heads[i].head = fx;
-            ch->effects = (uint32_t)(uintptr_t)fx;
-            return;
-        }
-    }
-    if (effect_head_count < HEAD_LINK_MAX) {
-        effect_heads[effect_head_count].ch = ch;
-        effect_heads[effect_head_count].head = fx;
-        ++effect_head_count;
-    }
-    ch->effects = (uint32_t)(uintptr_t)fx;
-}
-
-/* Lista oggetti: next a ItemNode+0x2C. */
-void item_add(CharacterRecord *ch, ItemNode *item)
-{
-    ItemNode *cur;
-
-    if (ch == NULL || item == NULL) {
-        return;
-    }
-    item_set_next(item, NULL);
-    if (item_head_get(ch) == NULL) {
-        item_set_head(ch, item);
-        return;
-    }
-    cur = item_head_get(ch);
-    while (item_next(cur) != NULL) {
-        cur = item_next(cur);
-    }
-    item_set_next(cur, item);
-}
-
-int item_remove(CharacterRecord *ch, ItemNode *item)
-{
-    ItemNode *cur;
-
-    if (ch == NULL || item == NULL || item_head_get(ch) == NULL) {
-        return -1;
-    }
-    if (item_head_get(ch) == item) {
-        item_set_head(ch, item_next(item));
-        item_set_next(item, NULL);
-        return 0;
-    }
-    cur = item_head_get(ch);
-    while (item_next(cur) != NULL) {
-        ItemNode *next = item_next(cur);
-        if (next == item) {
-            item_set_next(cur, item_next(item));
-            item_set_next(item, NULL);
-            return 0;
-        }
-        cur = next;
-    }
-    return -1;
-}
-
-ItemNode *item_find(CharacterRecord *ch, const char *name)
-{
-    ItemNode *cur;
-
-    if (ch == NULL) {
-        return NULL;
-    }
-    cur = item_head_get(ch);
-    while (cur != NULL) {
-        if (strncmp(cur->name, name, sizeof(cur->name)) == 0) {
-            return cur;
-        }
-        cur = item_next(cur);
-    }
-    return NULL;
-}
-
-/* H067: valore in "copper pieces" come unita' di conto. */
-uint32_t money_total_copper(void)
-{
-    return party_money.platinum * COIN_COPPER_PER_PLATINUM +
-           party_money.steel    * COIN_COPPER_PER_STEEL +
-           party_money.silver   * COIN_COPPER_PER_SILVER +
-           party_money.bronze   * COIN_COPPER_PER_BRONZE +
-           party_money.copper   * COIN_COPPER_PER_COPPER;
-}
-
-void money_add(PartyMoney amount)
-{
-    party_money.platinum += amount.platinum;
-    party_money.steel    += amount.steel;
-    party_money.silver   += amount.silver;
-    party_money.bronze   += amount.bronze;
-    party_money.copper   += amount.copper;
-    party_money.gems     += amount.gems;
-    party_money.jewelry  += amount.jewelry;
-}
-
-int money_sub(PartyMoney amount)
-{
-    if (money_total_copper() < (amount.platinum * COIN_COPPER_PER_PLATINUM +
-                                amount.steel * COIN_COPPER_PER_STEEL +
-                                amount.silver * COIN_COPPER_PER_SILVER +
-                                amount.bronze * COIN_COPPER_PER_BRONZE +
-                                amount.copper * COIN_COPPER_PER_COPPER)) {
-        return -1;
-    }
-    party_money.platinum -= amount.platinum;
-    party_money.steel    -= amount.steel;
-    party_money.silver   -= amount.silver;
-    party_money.bronze   -= amount.bronze;
-    party_money.copper   -= amount.copper;
-    party_money.gems     -= amount.gems;
-    party_money.jewelry  -= amount.jewelry;
-    return 0;
-}
-
-/* H063: stato sintetico della scheda personaggio. */
-void character_status_line(const CharacterRecord *ch, char *out, size_t size)
-{
-    if (ch == NULL || out == NULL || size == 0) {
-        return;
-    }
-    snprintf(out, size, "%s  Liv %u  Classe %u  PF %u",
-             ch->name, ch->level, ch->klass,
-             (unsigned)ch->unknown_1c);
-}
diff --git a/src_c/readable/io.c b/src_c/readable/io.c
