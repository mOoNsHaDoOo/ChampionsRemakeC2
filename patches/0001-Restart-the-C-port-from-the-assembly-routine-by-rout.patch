-/*
- * Champions of Krynn - servizi Intuition in C leggibile (H021).
- */
-
-#include <string.h>
-#include <stdio.h>
-
-#include "cok.h"
-#include "cok/globals.h"
-#include "cok/intuition_exec.h"
-
-#if COK_AMIGA
-#define POINTER_ENTRY_COUNT 12u
-#define POINTER_ENTRY_SIZE  10u
-
-static uint8_t *g_pointer_data;
-static uint16_t g_pointer_size;
-
-static uint16_t pointer_be16(const uint8_t *p)
-{
-    return (uint16_t)((p[0] << 8) | p[1]);
-}
-
-static uint32_t pointer_be32(const uint8_t *p)
-{
-    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
-           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
-}
-
-/*
- * H029+$0234: carica pointers.daa (804 byte) e costruisce la tabella di
- * 12 puntatori da 10 byte.  Ogni voce e':
- *   +0 long  offset del dato dall'inizio del file
- *   +4 word  xOffset
- *   +6 word  yOffset
- *   +8 word  altezza (larghezza fissa 16)
- */
-static int ui_load_pointer_file(void)
-{
-    char full_path[512];
-    const char *resolved;
-    BPTR file;
-    LONG length;
-    uint8_t *data;
-
-    if (g_pointer_data != NULL) {
-        return 0;
-    }
-    resolved = cok_data_path("pointers.daa", full_path, sizeof(full_path));
-    file = dos_Open((CONST_STRPTR)resolved, MODE_OLDFILE);
-    if (file == 0) {
-        printf("load file %s fallito\n", resolved);
-        return -1;
-    }
-    dos_Seek(file, 0, OFFSET_END);
-    length = dos_Seek(file, 0, OFFSET_CURRENT);
-    dos_Seek(file, 0, OFFSET_BEGINNING);
-    if (length <= 0) {
-        printf("load file %s fallito\n", resolved);
-        dos_Close(file);
-        return -1;
-    }
-    /* H029+$028C: pointers.daa viene caricato direttamente in CHIP RAM. */
-    data = (uint8_t *)AllocMem((ULONG)length, MEMF_CHIP);
-    if (data == NULL) {
-        printf("load file %s fallito (memoria)\n", resolved);
-        dos_Close(file);
-        return -1;
-    }
-    if (dos_Read(file, data, length) != length) {
-        printf("load file %s fallito\n", resolved);
-        FreeMem(data, (ULONG)length);
-        dos_Close(file);
-        return -1;
-    }
-    dos_Close(file);
-    g_pointer_data = data;
-    g_pointer_size = (uint16_t)length;
-    return 0;
-}
-#endif
-
-/* H029+$01B6: seleziona uno dei puntatori del gioco (0x0A = spada menu). */
-void ui_install_game_pointer(uint16_t index)
-{
-#if COK_AMIGA
-    const uint8_t *entry;
-    const uint8_t *sprite;
-    uint32_t offset;
-    uint16_t height;
-    int16_t x_offset;
-    int16_t y_offset;
-
-    if (G_WINDOW == NULL) {
-        return;
-    }
-    if (index >= POINTER_ENTRY_COUNT) {
-        index = 0;
-    }
-    if (ui_load_pointer_file() != 0) {
-        return;
-    }
-    entry = g_pointer_data + (uint32_t)index * POINTER_ENTRY_SIZE;
-    offset = pointer_be32(entry);
-    height = pointer_be16(entry + 8);
-    x_offset = (int16_t)pointer_be16(entry + 4);
-    y_offset = (int16_t)pointer_be16(entry + 6);
-    if (offset + 4u * (uint32_t)height > g_pointer_size) {
-        return;
-    }
-    sprite = g_pointer_data + offset;
-    ui_set_pointer((APTR)G_WINDOW, (APTR)sprite,
-                   (WORD)height, (WORD)16,
-                   (WORD)(-x_offset), (WORD)(-y_offset));
-#else
-    (void)index;
-#endif
-}
-
-/* H029+$1206: crea lo schermo 320x200 e la finestra di gioco. */
-int ui_prepare_display(void)
-{
-#if COK_AMIGA
-    struct NewScreen ns;
-    struct NewWindow nw;
-    APTR screen;
-    APTR window;
-#endif
-
-    if (G_WINDOW != NULL) {
-        return 0;
-    }
-#if COK_AMIGA
-    memset(&ns, 0, sizeof(ns));
-    memset(&nw, 0, sizeof(nw));
-
-    ns.LeftEdge = 0;
-    ns.TopEdge = 0;
-    ns.Width = 320;
-    ns.Height = 200;
-    ns.Depth = 5;
-    ns.DetailPen = 0;
-    ns.BlockPen = 0;
-    ns.ViewModes = 0;
-    ns.Type = CUSTOMSCREEN;
-    ns.Font = NULL;
-    ns.DefaultTitle = NULL;   /* H024+$002A: il chiamante passa 0 */
