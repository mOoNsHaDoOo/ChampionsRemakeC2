-    /*
-     * H029+$124C/H025+$0028: IDCMPFlags=$408 (RAWKEY|MOUSEBUTTONS),
-     * Flags=$11900 = RMBTRAP|ACTIVATE|BORDERLESS|BACKDROP.  La finestra
-     * deve coprire esattamente il BitMap dello schermo, senza bordo,
-     * titolo o GimmeZeroZero che spostino il RastPort.
-     */
-    nw.IDCMPFlags = IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS;
-    nw.Flags = WFLG_RMBTRAP | WFLG_ACTIVATE |
-               WFLG_BORDERLESS | WFLG_BACKDROP;
-    nw.FirstGadget = NULL;
-    nw.CheckMark = NULL;
-    nw.Title = NULL;
-    nw.Screen = screen;
-    nw.BitMap = NULL;
-    nw.MinWidth = 320;
-    nw.MinHeight = 200;
-    nw.MaxWidth = 320;
-    nw.MaxHeight = 200;
-    nw.Type = CUSTOMSCREEN;
-
-    window = ui_open_window(&nw);
-    if (window == NULL) {
-        ui_close_screen(screen);
-        return -1;
-    }
-
-    H005_G->screen = (uint32_t)(uintptr_t)screen;
-    H005_G->window = (uint32_t)(uintptr_t)window;
-    cok_h005_ptr_set(0x52F2u, screen);
-    cok_h005_ptr_set(0x52F6u, window);
-    ui_set_rastport(((struct Window *)window)->RPort);
-
-    (void)CloseWorkBench();
-    ui_activate_window(window);
-    /* H029+$12AE -> H029+$115C: palette standard del gioco. */
-    ui_restore_game_palette();
-    return 0;
-#else
-    return 0;
-#endif
-}
-
-/*
- * H029+$115C: palette standard del gioco (16 colori da 12 bit).
- * H005+$52AE e' un buffer da 32 word: i primi 16 colori sono quelli
- * EGA-like del gioco, i restanti sono neri.  H042+$0254 ricarica 32
- * colori prima di disegnare il menu in basso.
- *
- * I registri 17-19 sono usati dallo sprite del puntatore (sprite 0):
- * vanno lasciati chiari, altrimenti la spada diventa nera sul nero.
- */
-static const UWORD cok_game_palette[32] = {
-    0x000, 0x00A, 0x0A0, 0x0AA,
-    0x0A00, 0x0A0A, 0x0A50, 0x0AAA,
-    0x0555, 0x055F, 0x05F5, 0x05FF,
-    0x0F55, 0x0F5F, 0x0FF5, 0x0FFF,
-    0x000, 0x000, 0x0AAA, 0x0FFF,
-    0x000, 0x000, 0x000, 0x000,
-    0x000, 0x000, 0x000, 0x000,
-    0x000, 0x000, 0x000, 0x000
-};
-
-/* H022+$0084: carica colori gia' nel formato 0x0RGB di LoadRGB4. */
-void ui_set_palette_rgb4(const UWORD *colors, ULONG count)
-{
-#if COK_AMIGA
-    APTR screen = G_SCREEN;
-
-    if (screen != NULL && colors != NULL && count > 0) {
-        LoadRGB4((APTR)((uint8_t *)screen + 0x2C), colors, (LONG)count);
-    }
-#else
-    (void)colors;
-    (void)count;
-#endif
-}
-
-/* H011+$010C: ripristina la palette di gioco dopo l'introduzione. */
-void ui_restore_game_palette(void)
-{
-    /* H042+$0254 carica 32 colori dal buffer H005+$52AE. */
-    ui_set_palette_rgb4(cok_game_palette, 32);
-}
-
-/* H022+$0084/H029: carica una palette RGB a 4 bit per canale. */
-void ui_set_palette(const uint8_t palette[][3], uint16_t count)
-{
-#if COK_AMIGA
-    UWORD colors[32];
-    uint16_t i;
-    APTR screen = G_SCREEN;
-
-    if (screen == NULL || palette == NULL) {
-        return;
-    }
-    if (count > 32) {
-        count = 32;
-    }
-    for (i = 0; i < count; ++i) {
-        colors[i] = (UWORD)((((UWORD)palette[i][0] >> 4) << 8) |
-                            (((UWORD)palette[i][1] >> 4) << 4) |
-                            ((UWORD)palette[i][2] >> 4));
-    }
-    /* struct Screen: ViewPort a offset 0x2C sul layout AmigaOS 2.x/3.x. */
-    LoadRGB4((APTR)((uint8_t *)screen + 0x2C), colors, (WORD)count);
-#else
-    (void)palette;
-    (void)count;
-#endif
-}
