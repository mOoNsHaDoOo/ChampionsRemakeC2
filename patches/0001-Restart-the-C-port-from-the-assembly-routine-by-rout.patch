-    if (length <= 0) {
-        printf("load file %s fallito\n", resolved);
-        dos_Close(file);
-        return NULL;
-    }
-    data = (uint8_t *)AllocMem((ULONG)length, MEMF_CLEAR);
-    if (data == NULL) {
-        printf("load file %s fallito (memoria)\n", resolved);
-        dos_Close(file);
