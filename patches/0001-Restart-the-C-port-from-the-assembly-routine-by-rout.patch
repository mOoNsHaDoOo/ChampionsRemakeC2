-/*
- * H013+$4C0A imposta un flag per ogni voce del menu, poi H013+$4DBE lo
- * aggiorna in base al personaggio corrente e al party.  H008+$1448 disegna
- * solo le voci con flag attivo, compattandole dall'alto: le altre non sono
- * "disabilitate", semplicemente non esistono nel menu.
- *
- * Flag iniziali H013+$4C0A:
- *   Create=1, Drop=0, Modify=0, Train=0, Knight=0, View=0,
- *   Add=1, Remove=0, Load=1, Save=0, BEGIN=0, Exit=1.
- */
-static int party_item_visible(uint16_t index, int has_char, int has_party,
-                              int can_train)
-{
-    switch (index) {
-    case 0:                         /* Create New Character */
-    case 6:                         /* Add Character to Party */
-    case 11:                        /* Exit to Workbench */
-        return 1;
-    case 8:                         /* Load Saved Game */
-        return !has_char;
-    case 10:                        /* BEGIN Adventuring */
-        return has_party;
-    default:
-        break;
-    }
-
-    if (!has_char) {
-        return 0;
-    }
-    switch (index) {
-    case 1:                         /* Drop Character */
-    case 2:                         /* Modify Character */
-    case 5:                         /* View Character */
-    case 7:                         /* Remove Character from Party */
-    case 9:                         /* Save Current Game */
-        return 1;
-    case 3:                         /* Train Character */
-    case 4:                         /* Knight Change Classes */
-        return can_train;
-    default:
-        return 0;
-    }
-}
