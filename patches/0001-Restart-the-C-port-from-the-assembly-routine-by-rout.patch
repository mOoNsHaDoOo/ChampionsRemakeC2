-void audio_music_update(uint16_t ticks)
-{
-    if (audio_irq_installed) {
-        audio_task_lock = 1;
-        audio_drain_frees();
-        audio_task_lock = 0;
-        return;
-    }
-    audio_drain_frees();
-    audio_music_step(ticks);
-}
