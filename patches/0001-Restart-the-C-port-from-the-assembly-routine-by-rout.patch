-/*
- * Champions of Krynn - caricamento risorse DAX/DAA e RLE.
- *
- * Ricostruisce il livello leggibile di H028+$0DD8/H028+$09DC e del
- * formato DAA big-endian usato dalla grafica.
- */
-
-#include <string.h>
-#include <stdio.h>
-
-#include "cok/platform.h"
-
-#if !COK_AMIGA
-#include <stdlib.h>
-#endif
-
-#include "cok.h"
-
-/* H028+$09DC: RLE DAX */
-int dax_rle_decode(const uint8_t *src, size_t src_len,
-                   uint8_t *dst, size_t expected)
-{
-    size_t i = 0;
-    size_t out = 0;
-
-    while (i < src_len && out < expected) {
-        uint8_t control = src[i++];
-
-        if (control < 128) {
-            size_t count = (size_t)control + 1;
-            if (i + count > src_len) {
-                count = src_len - i;
-            }
-            if (count > expected - out) {
-                count = expected - out;
-            }
-            if (count == 0u) {
-                break;
-            }
-            memcpy(dst + out, src + i, count);
-            i += count;
-            out += count;
-        } else {
-            size_t count = (size_t)(256 - control);
-            if (i >= src_len) {
-                break;
-            }
-            if (count > expected - out) {
-                count = expected - out;
-            }
-            if (count == 0u) {
-                break;
-            }
-            memset(dst + out, src[i++], count);
-            out += count;
-        }
-    }
-    /* H028+$09DC: produce il prefisso richiesto e ignora la coda. */
-    return (out == expected) ? 0 : -1;
-}
-
-/* H088+$000C: ByteRun1 ILBM */
-int byterun1_decode(const uint8_t *src, size_t src_len,
-                    uint8_t *dst, size_t expected)
-{
-    size_t i = 0;
-    size_t out = 0;
-
-    while (i < src_len && out < expected) {
-        int8_t control = (int8_t)src[i++];
-
-        if (control >= 0) {
-            size_t count = (size_t)control + 1;
-            if (i + count > src_len || out + count > expected) {
-                return -1;
-            }
-            memcpy(dst + out, src + i, count);
-            i += count;
-            out += count;
-        } else if (control != -128) {
-            size_t count = (size_t)(1 - control);
-            if (i >= src_len || out + count > expected) {
-                return -1;
-            }
-            memset(dst + out, src[i++], count);
-            out += count;
-        }
-    }
-    return (out == expected) ? 0 : -1;
-}
-
-/* H028+$0DD8: apre un DAX e cerca l'ID, poi decompone il blocco. */
-uint8_t *dax_load_block(CONST_STRPTR path, uint8_t wanted_id, uint16_t *out_size)
-{
-    BPTR file;
-    uint8_t header[2];
-    uint16_t table_size;
-    uint16_t entries;
-    uint8_t *compressed = NULL;
-    uint8_t *output = NULL;
-    uint32_t data_start;
-    uint16_t last_packed = 0;
-    uint16_t last_size = 0;
-    uint16_t i;
-
-    if (out_size != NULL) {
-        *out_size = 0;
-    }
-
-    file = dos_Open(path, MODE_OLDFILE);
-    if (file == 0) {
-        printf("load file %s fallito\n", path);
-        return NULL;
-    }
-
-    if (dos_Read(file, header, 2) != 2) {
-        printf("load file %s fallito\n", path);
-        dos_Close(file);
-        return NULL;
-    }
-    table_size = (uint16_t)(header[0] | (header[1] << 8));
-    entries = (uint16_t)(table_size / 9);
-    data_start = (uint32_t)(2 + table_size);
-
-    for (i = 0; i < entries; ++i) {
-        uint8_t record[9];
-        uint32_t rel;
-        uint16_t size;
-        uint16_t packed;
-
-        if (dos_Read(file, record, 9) != 9) {
-            break;
-        }
-        if (record[0] != wanted_id) {
-            continue;
-        }
-
-        rel = (uint32_t)record[1] |
-              ((uint32_t)record[2] << 8) |
-              ((uint32_t)record[3] << 16) |
-              ((uint32_t)record[4] << 24);
-        size = (uint16_t)(record[5] | (record[6] << 8));
-        packed = (uint16_t)(record[7] | (record[8] << 8));
-
-        last_packed = packed;
-        last_size = size;
-        compressed = (uint8_t *)AllocMem(packed, MEMF_CLEAR);
-        output = (uint8_t *)AllocMem(size, MEMF_CLEAR);
-        if (compressed == NULL || output == NULL) {
-            printf("load file %s fallito (memoria)\n", path);
-            break;
-        }
-
-        dos_Seek(file, (LONG)(data_start + rel), OFFSET_BEGINNING);
-        if (dos_Read(file, compressed, packed) != packed) {
-            printf("load file %s fallito\n", path);
-            break;
-        }
-        if (dax_rle_decode(compressed, packed, output, size) != 0) {
-            printf("load file %s fallito (RLE)\n", path);
-            break;
-        }
-
-        FreeMem(compressed, packed);
-        dos_Close(file);
-        if (out_size != NULL) {
-            *out_size = size;
-        }
-        return output;
-    }
-
-    if (compressed != NULL) {
-        FreeMem(compressed, last_packed);
-    }
-    if (output != NULL) {
-        FreeMem(output, last_size);
-    }
-    printf("load file %s fallito (id %u)\n", path, (unsigned)wanted_id);
-    dos_Close(file);
-    return NULL;
-}
-
