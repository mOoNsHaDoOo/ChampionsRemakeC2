-/*
- * Programma ECL minimo: cinque vettori che puntano tutti a EXIT.
- * Serve solo a lasciare la VM in stato valido se i file ECL non ci sono.
- */
-static void game_ecl_install_exit(GameContext *ctx)
-{
-    uint16_t entry[5];
-    uint16_t i;
-    uint16_t addr_word;
-    uint8_t *program;
-
-    if (ctx == NULL || ctx->ecl.program == NULL) {
-        return;
-    }
-    program = ctx->ecl.program;
-    memset(program, 0, ECL_BUFFER_SIZE);
-
-    /*
-     * Layout del blocco ECL: 2 byte di header non copiati, poi cinque
-     * record da 4 byte.  Il secondo word di ogni record e' l'indirizzo
-     * logico (0x8000 + offset nel buffer).
-     */
-    addr_word = (uint16_t)(ECL_PC_BASE + 0x14 + ECL_ADDR_BIAS);
-    for (i = 0; i < 5; ++i) {
-        program[i * 4 + 0] = 1;
-        program[i * 4 + 1] = 1;
-        program[i * 4 + 2] = (uint8_t)(addr_word & 0xFF);
-        program[i * 4 + 3] = (uint8_t)(addr_word >> 8);
-    }
-    program[0x14] = ECL_OP_EXIT;
-
-    for (i = 0; i < 5; ++i) {
-        entry[i] = (uint16_t)(ECL_PC_BASE + 0x14);
-    }
-    game_ecl_apply_entries(ctx, entry);
-}
-
-static int game_ecl_copy_block(GameContext *ctx, const uint8_t *data,
-                               uint16_t size)
-{
-    uint16_t entry[5];
-    uint16_t i;
-
-    if (ctx == NULL || ctx->ecl.program == NULL || data == NULL || size < 22) {
-        return -1;
-    }
-    if ((size_t)(size - 2) > ECL_BUFFER_SIZE) {
-        return -1;
-    }
-
-    memset(ctx->ecl.program, 0, ECL_BUFFER_SIZE);
-    memcpy(ctx->ecl.program, data + 2, (size_t)(size - 2));
-
-    for (i = 0; i < 5; ++i) {
-        const uint8_t *record = data + 2 + (size_t)i * 4;
-        uint16_t record_word = (uint16_t)(record[2] | (record[3] << 8));
-
-        entry[i] = (uint16_t)(record_word - ECL_ADDR_BIAS);
-    }
-    game_ecl_apply_entries(ctx, entry);
-    return 0;
-}
-
-static int game_ecl_try_file(GameContext *ctx, uint16_t block_id,
-                             const char *file)
-{
-    uint8_t *data;
-    uint16_t size = 0;
-    int result;
-
-    data = cok_dax_load_block(file, (uint8_t)block_id, &size);
-    if (data == NULL) {
-        return -1;
-    }
-    result = game_ecl_copy_block(ctx, data, size);
-    cok_dax_free(data, size);
-    return result;
-}
-
-/*
- * Carica il blocco ECL iniziale.
- *
- * H012+$0912 usa DAT_00152498 = $24 nel gioco normale e $39 nella demo.
- * I blocchi sono in ECL1.DAX (id < 57) e ECL2.DAX (id >= 57).
- */
-int game_ecl_load_block(GameContext *ctx, uint16_t block_id)
-{
-    const char *primary = (block_id >= 57) ? "ECL2.DAX" : "ECL1.DAX";
-    const char *secondary = (block_id >= 57) ? "ECL1.DAX" : "ECL2.DAX";
-
-    if (ctx == NULL || ctx->ecl.program == NULL) {
-        return -1;
-    }
-    if (game_ecl_try_file(ctx, block_id, primary) == 0) {
-        return 0;
-    }
-    if (game_ecl_try_file(ctx, block_id, secondary) == 0) {
-        return 0;
-    }
-    return -1;
-}
-
-/* Esegue il vettore iniziale del blocco ECL caricato. */
-void game_ecl_run_initial(GameContext *ctx)
-{
-    if (ctx == NULL || ctx->ecl.program == NULL) {
-        return;
-    }
-    ecl_run(&ctx->ecl, ctx->ecl.entries.initial);
-}
-
-void game_init(GameContext *ctx)
-{
-    if (ctx == NULL) {
-        return;
-    }
-    memset(ctx, 0, sizeof(*ctx));
-    game_memory_init();
-    if (cok_h005 == NULL || g_ecl_program == NULL) {
-        return;
-    }
-    cok_hunks_init();
-    ctx->save_slot = 'A';
-    ctx->running = 1;
-
-    ctx->ecl.program = g_ecl_program;
-    ctx->ecl.start_pc = ECL_PC_BASE;
-    ctx->ecl.pc = ECL_PC_BASE;
-    ctx->ecl.entries.initial = ECL_PC_BASE;
-
-    ECL_G->program = (uint32_t)(uintptr_t)g_ecl_program;
-    ECL_G->pc = ECL_PC_BASE;
-    ECL_G->start_pc = ECL_PC_BASE;
-    ECL_G->initial = ECL_PC_BASE;
-
-    /*
-     * Blocco iniziale: $24 (36) nel gioco normale, $39 (57) nella demo.
-     * Se i dati non sono disponibili la VM resta valida con un EXIT.
-     */
-    if (game_ecl_load_block(ctx, ctx->ecl.demo_flag ? 57 : 36) != 0) {
-        game_ecl_install_exit(ctx);
