-        if (body != 0) {
-            state.body = (uint16_t)((body - 1u) % COK_ICON_BODY_VARIANTS);
-        }
-        if (head != 0) {
-            state.head = (uint16_t)((head - 1u) % COK_ICON_HEAD_VARIANTS);
-        }
-        /* H066+$0E9E: $144 == 1 -> charT (tall), altrimenti charS (short). */
-        state.size = (size == 1u) ? 0u : 1u;
-    }
-    initial = state;
-
-    for (;;) {
-        uint8_t key;
-
-        cok_icon_screen(&initial, &state);
-        key = ui_request_choice(NULL, 0, 0, 0x0F, 0x0A, 0x0D,
-                                "Parts 1st-color 2nd-color Size Exit", 0,
-                                "", 0);
-        if (key == 'P') {
-            int pi = -1;
-
-            cok_icon_screen(&initial, &state);
-            key = ui_request_choice(NULL, 0, 0, 0x0F, 0x0A, 0x0D,
-                                    cok_icon_parts_menu, 0, "Parts ", 6);
-            switch (key) {
-            case 'H': pi = 0; break;
-            case 'W': pi = 1; break;
-            case 'B': pi = 2; break;
-            case 'S': pi = 3; break;
-            case 'A': pi = 4; break;
-            case 'L': pi = 5; break;
-            default: break;
-            }
-            if (pi >= 0) {
-                active = (uint16_t)pi;
-                if (pi == 0) {
-                    cok_icon_adjust_u16(&state.head, COK_ICON_HEAD_VARIANTS,
-                                        "Head ", &initial, &state);
-                } else if (pi == 2) {
-                    cok_icon_adjust_u16(&state.body, COK_ICON_BODY_VARIANTS,
-                                        "Body ", &initial, &state);
-                } else {
-                    /* Weapon/Shield/Arm/Leg: regola i due colori. */
-                    snprintf(title, sizeof(title), "%s1st-color ",
-                             cok_icon_parts[pi]);
-                    cok_icon_adjust_nibble(&state, (uint16_t)pi, 0, title,
-                                           &initial);
-                    snprintf(title, sizeof(title), "%s2nd-color ",
-                             cok_icon_parts[pi]);
-                    cok_icon_adjust_nibble(&state, (uint16_t)pi, 1, title,
-                                           &initial);
-                }
-            }
-        } else if (key == '1') {
-            snprintf(title, sizeof(title), "%s1st-color ",
-                     cok_icon_parts[active]);
-            cok_icon_adjust_nibble(&state, active, 0, title, &initial);
-        } else if (key == '2') {
-            snprintf(title, sizeof(title), "%s2nd-color ",
-                     cok_icon_parts[active]);
-            cok_icon_adjust_nibble(&state, active, 1, title, &initial);
-        } else if (key == 'S') {
-            cok_icon_adjust_u16(&state.size, 2, "Size ", &initial, &state);
-        } else if (key == 'E') {
-            cok_icon_screen(&initial, &state);
-            key = ui_request_choice(NULL, 0, 0, 0x0F, 0x0A, 0x0D,
-                                    "Yes No", 0, "Is this icon ok? ", 17);
-            if (key == 'Y') {
-                break;
-            }
-        }
-    }
-
-    ch->unknown_124[0x141 - 0x124] = (uint8_t)(state.body + 1u);
-    ch->unknown_124[0x142 - 0x124] = (uint8_t)(state.head + 1u);
-    /* H047+$340: $143 (weapon/piece) resta fisso a 12 durante l'editing. */
-    ch->unknown_124[0x143 - 0x124] = 0x0C;
-    /* H066+$0E9E: $144 = size (1 = tall/charT, 2 = short/charS). */
-    ch->unknown_124[0x144 - 0x124] = (uint8_t)(state.size + 1u);
-    for (i = 0; i < 6; ++i) {
-        ch->unknown_124[0x146 - 0x124 + i] = state.pair[i];
-    }
