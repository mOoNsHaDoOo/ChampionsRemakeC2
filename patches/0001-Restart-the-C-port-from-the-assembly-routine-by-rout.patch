-#endif
diff --git a/src_c/readable/save.c b/src_c/readable/save.c
deleted file mode 100644
index 4be89ad..0000000
--- a/src_c/readable/save.c
+++ /dev/null
@@ -1,476 +0,0 @@
-/*
- * Champions of Krynn - salvataggio/caricamento partita.
- *
- * Formato originale:
- *   savgam<slot>.dat   5481 byte
- *   CHRDAT<slot><n>.sav  426 byte
- *   CHRDAT<slot><n>.swg   72 byte per nodo
- *   CHRDAT<slot><n>.fx    10 byte per nodo
- *
- * Il word del conteggio a 0x1417 e' big-endian: H066+$34E0..$34EE scrive
- * due byte senza swap (00 06 = 6 personaggi).
- * Il manifest contiene i nomi dei file CHRDAT..., non i nomi visualizzati.
- */
-
-#include <stdio.h>
-#include <stdlib.h>
-#include <string.h>
-
-#include "cok.h"
-#include "cok/globals.h"
-#include "cok/inventory.h"
-
-#define SAVE_FILE_SIZE   5481
-#define CHARACTER_SIZE    426
-#define ITEM_NODE_SIZE     72
-#define EFFECT_NODE_SIZE   10
-#define PARTY_MAX           8
-
-static void build_name(char *out, size_t size, const char *base,
-                       char slot, const char *ext)
-{
-    char raw[128];
-    const char *resolved;
-
-    snprintf(raw, sizeof(raw), "SAVE/%s%c%s", base, slot, ext);
-    resolved = cok_data_path(raw, out, size);
-    if (resolved != out) {
-        strncpy(out, resolved, size - 1);
-        out[size - 1] = '\0';
-    }
-}
-
-static void build_char_name(char *out, size_t size, char slot,
-                            unsigned index, const char *ext)
-{
-    char raw[64];
-    const char *resolved;
-
-    snprintf(raw, sizeof(raw), "SAVE/CHRDAT%c%u%s", slot, index, ext);
-    resolved = cok_data_path(raw, out, size);
-    if (resolved != out) {
-        strncpy(out, resolved, size - 1);
-        out[size - 1] = '\0';
-    }
-}
-
-static BPTR open_data(const char *name, LONG mode)
-{
-    char full_path[512];
-    const char *resolved = cok_data_path(name, full_path, sizeof(full_path));
-
-    return dos_Open((CONST_STRPTR)resolved, mode);
-}
-
-static void *node_alloc(size_t size)
-{
-#if COK_AMIGA
-    return AllocMem((ULONG)size, MEMF_CLEAR);
-#else
-    return calloc(1, size);
-#endif
-}
-
-static void node_free(void *node, size_t size)
-{
-    if (node == NULL) {
-        return;
-    }
-#if COK_AMIGA
-    FreeMem(node, (ULONG)size);
-#else
-    (void)size;
-    free(node);
-#endif
-}
-
-int save_game_exists(char slot)
-{
-    char path[256];
-    BPTR file;
-
-    build_name(path, sizeof(path), "savgam", slot, ".dat");
-    file = open_data(path, MODE_OLDFILE);
-    if (file == 0) {
-        return 0;
-    }
-    dos_Close(file);
-    return 1;
-}
-
-static int write_exact(BPTR file, const void *data, LONG length)
-{
-    return dos_Write(file, (APTR)data, length) == length;
-}
-
-/* H066+$19E2..$1AFC: scrive SAV + SWG + FX, svuotando i vecchi sidecar. */
-static int save_character_files(char slot, unsigned index,
-                                const CharacterRecord *ch)
-{
-    char path[256];
-    BPTR file;
-    ItemNode *item;
-    EffectNode *fx;
-
-    build_char_name(path, sizeof(path), slot, index, ".sav");
-    file = open_data(path, MODE_NEWFILE);
-    if (file == 0) {
-        printf("save file %s fallito\n", path);
-        return -1;
-    }
-    if (!write_exact(file, ch, CHARACTER_SIZE)) {
-        printf("save file %s fallito\n", path);
-        dos_Close(file);
-        return -1;
-    }
-    dos_Close(file);
-
-    build_char_name(path, sizeof(path), slot, index, ".swg");
-    file = open_data(path, MODE_NEWFILE);
-    if (file == 0) {
-        printf("save file %s fallito\n", path);
-        return -1;
-    }
-    item = item_head_get(ch);
-    while (item != NULL) {
-        if (!write_exact(file, item, ITEM_NODE_SIZE)) {
-            printf("save file %s fallito\n", path);
-            dos_Close(file);
-            return -1;
-        }
-        item = item_next(item);
-    }
-    dos_Close(file);
