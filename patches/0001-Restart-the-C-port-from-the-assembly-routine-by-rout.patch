-static uint16_t character_hp(const CharacterRecord *ch)
-{
-    return ch->hp_current;
-}
-
-static uint16_t character_hp_max(const CharacterRecord *ch)
-{
-    return ch->hp_or_ac.hp_max;
-}
-
-static void character_set_hp(CharacterRecord *ch, uint16_t hp)
-{
-    if (ch->hp_or_ac.hp_max != 0 && hp > ch->hp_or_ac.hp_max) {
-        hp = ch->hp_or_ac.hp_max;
-    }
-    ch->hp_current = (uint8_t)hp;
-}
-
-/* Cura i PF senza superare il massimo; restituisce i PF effettivamente curati. */
-static uint16_t character_heal(CharacterRecord *ch, uint16_t amount)
-{
-    uint16_t before = character_hp(ch);
-    uint16_t max = character_hp_max(ch);
-    uint16_t after = (uint16_t)(before + amount);
-
-    if (max != 0 && after > max) {
-        after = max;
-    }
-    if (after < before) {
-        after = before;
-    }
-    ch->hp_current = (uint8_t)after;
-    return (uint16_t)(after - before);
-}
-
-/* H062: la lista .fx e' una lista di EffectNode collegata da +$06. */
-static int effect_remove(CharacterRecord *ch, uint8_t code)
-{
-    EffectNode *cur;
-    EffectNode *prev = NULL;
-    int removed = 0;
-
-    if (ch == NULL) {
-        return 0;
-    }
-    cur = effect_head_get(ch);
-    while (cur != NULL) {
-        EffectNode *next = effect_next(cur);
-
-        if (cur->code == code) {
-            if (prev == NULL) {
-                effect_set_head(ch, next);
-            } else {
-                effect_set_next(prev, next);
-            }
-            effect_set_next(cur, NULL);
-            cur = next;
-            ++removed;
-            continue;
-        }
-        prev = cur;
-        cur = next;
-    }
-    return removed;
-}
-
-static int effect_present(const CharacterRecord *ch, uint8_t code)
-{
-    const EffectNode *cur;
-
-    if (ch == NULL) {
-        return 0;
-    }
-    cur = effect_head_get(ch);
-    while (cur != NULL) {
-        if (cur->code == code) {
-            return 1;
-        }
-        cur = effect_next(cur);
-    }
-    return 0;
-}
-
-static int effect_remove_any(CharacterRecord *ch, const uint8_t *codes,
-                             size_t count)
-{
-    int removed = 0;
-    size_t i;
-
-    for (i = 0; i < count; ++i) {
-        removed += effect_remove(ch, codes[i]);
-    }
-    return removed;
-}
-
-static int effect_present_any(const CharacterRecord *ch, const uint8_t *codes,
-                              size_t count)
-{
-    size_t i;
-
-    for (i = 0; i < count; ++i) {
-        if (effect_present(ch, codes[i])) {
-            return 1;
-        }
-    }
-    return 0;
-}
-
-/* H072+$0D24: cerca un oggetto con il flag "maledetto" a +$3C. */
-static int character_has_cursed_item(const CharacterRecord *ch)
-{
-    const ItemNode *item;
-
-    if (ch == NULL) {
-        return 0;
-    }
-    item = item_head_get(ch);
-    while (item != NULL) {
-        if (item->cursed != 0) {
-            return 1;
-        }
-        item = item_next(item);
-    }
-    return 0;
-}
-
-static int character_remove_curses(CharacterRecord *ch)
