- * quella selezionata usa la penna 0x0D, le altre la penna arg3.
- */
-static void ui_choice_draw(const char *title, const char *option,
-                           uint16_t option_col, uint16_t selected_pen,
-                           uint16_t normal_pen, uint16_t title_pen,
-                           uint16_t title_len, uint16_t selected,
-                           int hotkeys)
-{
-    RastPort *rp;
-    uint16_t i;
-    uint16_t word_index;
-
-    rp = ui_get_rastport();
-    if (rp != NULL) {
-        ui_rect_fill(rp, 0, 24 * 8, 319, 24 * 8 + 7, 0);
-    }
-
-    if (title != NULL) {
-        if (text_font_loaded()) {
-            (void)text_font_draw(title, 0, 24 * 8, (int16_t)title_pen,
-                                 (int16_t)title_len);
-        } else {
-            ui_draw_text(title, 0, 24 * 8, (int16_t)title_pen, 0, 0);
-        }
-    }
-    if (option == NULL) {
-        return;
-    }
-    if (!text_font_loaded()) {
-        ui_draw_text(option, (int16_t)(option_col * 8), 24 * 8,
-                     (int16_t)normal_pen, 0, 0);
-        return;
-    }
-
-    i = 0;
-    word_index = 0;
-    while (option[i] != '\0') {
-        uint16_t start;
-        uint16_t len;
-
-        while (option[i] == ' ') {
-            ++i;
-        }
-        if (option[i] == '\0') {
-            break;
-        }
-        start = i;
-        while (option[i] != '\0' && option[i] != ' ') {
-            ++i;
-        }
-        len = (uint16_t)(i - start);
-        if (word_index == selected) {
-            ui_draw_inverse_text(option + start,
-                                 (int16_t)((option_col + start) * 8),
-                                 24 * 8, len, selected_pen);
-        } else if (hotkeys) {
-            uint16_t k;
-
-            for (k = 0; k < len; ++k) {
-                uint16_t cx = (uint16_t)(option_col + start + k);
-
-                if (ui_hotkey_char((uint8_t)option[start + k])) {
-                    /* H008+$03C8: il tasto e' bianco, senza sfondo. */
-                    (void)text_font_draw(option + start + k,
-                                         (int16_t)(cx * 8), 24 * 8,
-                                         (int16_t)selected_pen, 1);
-                } else {
-                    (void)text_font_draw(option + start + k,
-                                         (int16_t)(cx * 8), 24 * 8,
-                                         (int16_t)normal_pen, 1);
-                }
-            }
-        } else {
-            (void)text_font_draw(option + start,
-                                 (int16_t)((option_col + start) * 8),
