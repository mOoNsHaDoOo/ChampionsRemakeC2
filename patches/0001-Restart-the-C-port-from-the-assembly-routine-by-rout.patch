-static uint16_t ui_word_count(const char *s)
-{
-    uint16_t count = 0;
-    uint16_t i = 0;
-
-    if (s == NULL) {
-        return 0;
-    }
-    while (s[i] != '\0') {
-        while (s[i] == ' ') {
-            ++i;
-        }
-        if (s[i] == '\0') {
-            break;
-        }
-        ++count;
-        while (s[i] != '\0' && s[i] != ' ') {
-            ++i;
-        }
-    }
-    return count;
-}
-
-static uint16_t ui_word_start(const char *s, uint16_t index)
-{
-    uint16_t word_index = 0;
-    uint16_t i = 0;
-
-    if (s == NULL) {
-        return 0;
-    }
-    while (s[i] != '\0') {
-        while (s[i] == ' ') {
-            ++i;
-        }
-        if (s[i] == '\0') {
-            break;
-        }
-        if (word_index == index) {
-            return i;
-        }
-        ++word_index;
-        while (s[i] != '\0' && s[i] != ' ') {
-            ++i;
-        }
-    }
