-void tables_init(void)
-{
-    unsigned i;
-
-    if (H005_G == NULL) {
-        return;
-    }
-    for (i = 0; i < COK_H004_COPY_COUNT; ++i) {
-        const CokH004Copy *copy = &cok_h004_copies[i];
-
-        memcpy((uint8_t *)H005_G + copy->dst,
-               cok_h004_data + copy->src,
-               copy->len);
-    }
-}
