-/* H066+$291E */
-LONG load_game(char slot)
-{
-    char path[256];
-    SaveGame save;
-    BPTR file;
-    uint16_t count;
-    CharacterRecord *loaded[PARTY_MAX];
-    uint16_t i;
-    int failed = 0;
-
-    build_name(path, sizeof(path), "savgam", slot, ".dat");
-    file = open_data(path, MODE_OLDFILE);
-    if (file == 0) {
-        printf("load file %s fallito\n", path);
-        return dos_IoErr();
-    }
-    if (dos_Read(file, &save, (LONG)SAVEGAME_BYTES) != (LONG)SAVEGAME_BYTES) {
-        printf("load file %s fallito\n", path);
-        dos_Close(file);
-        return -1;
-    }
-    dos_Close(file);
-
-    count = SAVEGAME_PARTY_COUNT(&save);
-    if (count > PARTY_MAX) {
-        printf("load file %s fallito (party > %u)\n", path,
-               (unsigned)PARTY_MAX);
-        return -1;
-    }
-    for (i = 0; i < PARTY_MAX; ++i) {
-        loaded[i] = NULL;
-    }
-
-    for (i = 0; i < count; ++i) {
-        const char *base = save.character_names[i];
-        char name[256];
-        CharacterRecord *ch;
-        LONG got;
-        BPTR cf;
-
-        if (!manifest_name_valid(base)) {
-            printf("load file %s fallito (nome %u)\n", path, (unsigned)i);
-            failed = 1;
-            break;
-        }
-        snprintf(name, sizeof(name), "SAVE/%s.sav", base);
-        cf = open_data(name, MODE_OLDFILE);
-        if (cf == 0) {
-            printf("load file %s fallito\n", name);
-            failed = 1;
-            break;
-        }
-        ch = (CharacterRecord *)node_alloc(CHARACTER_SIZE);
-        if (ch == NULL) {
-            dos_Close(cf);
-            failed = 1;
-            break;
-        }
-        got = dos_Read(cf, ch, CHARACTER_SIZE);
-        dos_Close(cf);
-        if (got != CHARACTER_SIZE) {
-            printf("load file %s fallito (record troncato)\n", name);
-            node_free(ch, CHARACTER_SIZE);
-            failed = 1;
-            break;
-        }
-
-        /* I puntatori serializzati non sono validi: si ricostruiscono. */
-        item_set_head(ch, NULL);
-        effect_set_head(ch, NULL);
-        party_set_next(ch, NULL);
-        ch->runtime_link = 0;
-
-        if (load_item_chain(ch, base) != 0 ||
-            load_effect_chain(ch, base) != 0) {
-            free_character(ch);
-            failed = 1;
-            break;
-        }
-        loaded[i] = ch;
-    }
-
-    if (failed) {
-        for (i = 0; i < PARTY_MAX; ++i) {
-            if (loaded[i] != NULL) {
-                free_character(loaded[i]);
-            }
-        }
-        return -1;                      /* stato corrente invariato */
-    }
-
-    for (i = 0; i + 1u < count; ++i) {
-        party_set_next(loaded[i], loaded[i + 1u]);
-    }
-
-    /* Solo ora la partita corrente viene sostituita. */
-    G_RESOURCE_GROUP = save.resource_group;
-    memcpy(G_STATE_A, save.state_a, sizeof(save.state_a));
-    memcpy(G_STATE_B, save.state_b, sizeof(save.state_b));
-    memcpy(G_STATE_C, save.state_c, sizeof(save.state_c));
-    memcpy(H005_G->views.position_view, save.position_view,
-           sizeof(save.position_view));
-    H005_G->state_3de2 = save.state_3de2;
-    H005_G->native_context = save.native_context;
-    memcpy(H005_G->wall_sets, save.wall_sets, sizeof(save.wall_sets));
-
-    party_set_head(count > 0 ? loaded[0] : NULL);
-    party_set_current(count > 0 ? loaded[0] : NULL);
-    return 0;
-}
