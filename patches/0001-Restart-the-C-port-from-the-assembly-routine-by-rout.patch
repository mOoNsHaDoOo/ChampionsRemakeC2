-    }
-    length = ftell(file);
-    if (length <= 0 || fseek(file, 0, SEEK_SET) != 0) {
-        printf("load file %s fallito\n", path);
-        fclose(file);
-        return NULL;
-    }
-    data = (uint8_t *)malloc((size_t)length);
-    if (data == NULL) {
-        printf("load file %s fallito (memoria)\n", path);
-        fclose(file);
-        return NULL;
-    }
-    if (fread(data, 1, (size_t)length, file) != (size_t)length) {
-        printf("load file %s fallito\n", path);
-        free(data);
-        fclose(file);
-        return NULL;
-    }
-    fclose(file);
-    if (out_size != NULL) {
-        *out_size = (size_t)length;
-    }
-    return data;
-}
-
-uint8_t *cok_daa_load_block(const char *path, uint8_t wanted_id,
-                            uint16_t *out_size)
-{
-    size_t file_size;
-    uint8_t *file_data;
-    uint16_t table_size;
-    uint16_t entries;
-    size_t data_start;
-    uint16_t i;
-
-    if (out_size != NULL) {
-        *out_size = 0;
-    }
-    file_size = 0;
-    file_data = host_read_daa_file(path, &file_size);
-    if (file_data == NULL || file_size < 2) {
-        printf("load file %s fallito\n", path);
-        free(file_data);
-        return NULL;
-    }
-    table_size = (uint16_t)((file_data[0] << 8) | file_data[1]);
-    if (table_size < 2 || table_size > file_size) {
-        free(file_data);
-        return NULL;
-    }
-    entries = (uint16_t)((table_size - 2) / 9);
-    data_start = table_size;
-
-    for (i = 0; i < entries; ++i) {
-        uint8_t *record;
-        uint32_t rel;
-        uint16_t size;
-        uint16_t packed;
-        uint8_t *output;
-
-        record = file_data + 2 + (size_t)i * 9;
-        if (record[0] != wanted_id) {
-            continue;
-        }
-        rel = ((uint32_t)record[1] << 24) |
-              ((uint32_t)record[2] << 16) |
-              ((uint32_t)record[3] << 8) |
-              (uint32_t)record[4];
-        size = (uint16_t)((record[5] << 8) | record[6]);
-        packed = (uint16_t)((record[7] << 8) | record[8]);
-        if (data_start + rel + packed > file_size) {
-            free(file_data);
-            return NULL;
-        }
-        output = (uint8_t *)malloc(size ? size : 1);
-        if (output == NULL) {
-            free(file_data);
-            return NULL;
-        }
-        if (dax_rle_decode(file_data + data_start + rel, packed,
-                           output, size) != 0) {
-            free(output);
-            free(file_data);
-            return NULL;
-        }
-        free(file_data);
-        if (out_size != NULL) {
-            *out_size = size;
-        }
-        return output;
-    }
-
-    free(file_data);
-    return NULL;
-}
-
-void cok_daa_free(void *data, uint16_t size)
-{
-    (void)size;
-    free(data);
-}
-#endif
