-    }
-}
-
-extern void game_main(void);
-
-#ifndef COK_NO_MAIN
-int main(void)
-{
-    runtime_open_libraries();
-    /* H001+$0066: il prefisso dati deve esistere prima di caricare ECL. */
-    game_memory_init();
-    cok_select_volume_prefix();
-    game_init(&g_game);
-
-#if !COK_AMIGA
-    /*
-     * Diagnostica host: COK_ECL_INFO=1 mostra lo stato della VM ECL dopo
-     * il caricamento del blocco e termina senza aprire il menu grafico.
-     */
-    if (getenv("COK_ECL_INFO") != NULL) {
-        printf("ECL program=%p pc=%04X initial=%04X\n",
-               (void *)g_game.ecl.program,
-               (unsigned)g_game.ecl.pc,
-               (unsigned)g_game.ecl.entries.initial);
-        printf("entries: periodic=%04X after_input=%04X timed=%04X "
-               "conditional=%04X initial=%04X\n",
-               (unsigned)g_game.ecl.entries.periodic,
-               (unsigned)g_game.ecl.entries.after_input,
-               (unsigned)g_game.ecl.entries.timed,
-               (unsigned)g_game.ecl.entries.conditional,
-               (unsigned)g_game.ecl.entries.initial);
-        runtime_close_libraries();
-        return 0;
-    }
-#endif
-
-    game_main();
