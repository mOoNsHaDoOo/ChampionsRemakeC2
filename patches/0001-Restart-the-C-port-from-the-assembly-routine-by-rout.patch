@@ -1,53 +0,0 @@
-/*
- * Champions of Krynn - I/O e diagnostica (H020).
- */
-
-#include <string.h>
-#include <stdio.h>
-
-#include "cok.h"
-
-/* Legge esattamente size byte, gestendo letture parziali. */
-LONG io_read_all(BPTR file, void *buffer, LONG size)
-{
-    uint8_t *p = (uint8_t *)buffer;
-    LONG total = 0;
-
-    while (total < size) {
-        LONG n = dos_Read(file, p + total, size - total);
-        if (n <= 0) {
-            break;
-        }
-        total += n;
-    }
-    return total;
-}
-
-/* Scrive esattamente size byte. */
-LONG io_write_all(BPTR file, const void *buffer, LONG size)
-{
-    const uint8_t *p = (const uint8_t *)buffer;
-    LONG total = 0;
-
-    while (total < size) {
-        LONG n = dos_Write(file, p + total, size - total);
-        if (n <= 0) {
-            break;
-        }
-        total += n;
-    }
-    return total;
-}
-
-/* H020: messaggio diagnostico su file/console. */
-void io_error_report(const char *what, LONG code)
-{
-    /*
-     * H020: diagnostica.  Nei percorsi interattivi l'originale usa H030;
-     * qui si scrive su stdout/stderr per non bloccare la VM o il menu.
-     */
-    if (what == NULL) {
-        what = "I/O error";
-    }
-    fprintf(stderr, "%s: %ld\n", what, (long)code);
-}
