-        if (H005_G != NULL) {
-            H005_G->window = 0;
-        }
-        cok_h005_ptr_set(0x52F6u, NULL);
-    }
-    if (G_SCREEN != NULL) {
-        ui_close_screen(G_SCREEN);
-        if (H005_G != NULL) {
-            H005_G->screen = 0;
-        }
-        cok_h005_ptr_set(0x52F2u, NULL);
-    }
-    ui_set_rastport(NULL);
-    (void)OpenWorkBench();
-    WaitBlit();
-#endif
-}
-
-void input_shutdown(void)
