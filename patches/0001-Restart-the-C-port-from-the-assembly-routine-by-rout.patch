-static void audio_track_update(MusicTrack *track, uint32_t now)
-{
-    uint32_t guard = 0;
-
-    /* H094: il worker gira nell'ISV.  Limita gli eventi elaborati per
-     * chiamata: se la traccia SMUS e' malformata, un loop che non esce qui
-     * bloccherebbe tutta la macchina. */
-    while (track->ptr + 1u < track->end && track->next <= now &&
-           guard < 1024u) {
-        uint8_t sid = track->ptr[0];
-        uint8_t data = track->ptr[1u];
-        int inst;
-        int loop;
-
-        track->ptr += 2;
-        if (sid < 128u) {
-            uint32_t ticks = audio_event_ticks(data, audio_music_tempo);
-
-            if ((data & 0x80u) == 0) {
-                inst = -1;
-                if (track->instrument < 7u) {
-                    inst = audio_music_instr[track->instrument];
-                }
-                loop = 1;
-                audio_note_start(sid, ticks, (uint8_t)(inst < 0 ? 0 : inst),
-                                 track->dynamic, loop);
-                track->next += ticks;
-            }
-        } else if (sid == 128u) {
-            if ((data & 0x80u) == 0) {
-                track->next += audio_event_ticks(data, audio_music_tempo);
-            }
-        } else if (sid == 129u) {
-            track->instrument = data;
-        } else if (sid == 132u) {
-            track->dynamic = data;
-        }
-        ++guard;
-    }
-}
