-#if COK_SASC
-/*
- * SysBase e DOSBase sono forniti da LIB:c.o (startup SAS/C): definirli
- * qui produce "Multiply defined symbol".  Le altre basi sono nostre.
- */
-struct GfxBase       *GfxBase = NULL;
-struct IntuitionBase *IntuitionBase = NULL;
-APTR                  MathBase = NULL;
-#else
-struct ExecBase      *SysBase = NULL;
-struct DosLibrary    *DOSBase = NULL;
-struct GfxBase       *GfxBase = NULL;
-struct IntuitionBase *IntuitionBase = NULL;
-APTR                  MathBase = NULL;
-#endif
-
-#if COK_SASC
-/*
- * snprintf portatile per SAS/C: formatta con vsprintf e garantisce la
- * terminazione entro size byte.  I formati usati dal gioco producono
- * stringhe corte; il troncamento e' comunque esplicito.
- */
-int cok_snprintf(char *buf, size_t size, const char *format, ...)
-{
-    char text[1024];
-    va_list args;
-    int written;
-    size_t n;
-
-    if (buf == NULL || size == 0) {
-        return 0;
-    }
-    va_start(args, format);
-    written = vsprintf(text, format, args);
-    va_end(args);
-
-    n = strlen(text);
-    if (n >= size) {
-        n = size - 1;
-    }
-    memcpy(buf, text, n);
-    buf[n] = '\0';
-    return written;
-}
-#endif
-
-#if COK_AMIGA
-/* Su AmigaOS le basi arrivano dal loader e da OpenLibrary(). */
-static void runtime_open_libraries(void)
-{
-    /* SysBase/DOSBase: gia' inizializzate da LIB:c.o. */
-    GfxBase = (struct GfxBase *)OpenLibrary((CONST_STRPTR)"graphics.library", 0);
-    IntuitionBase = (struct IntuitionBase *)OpenLibrary((CONST_STRPTR)"intuition.library", 0);
-    MathBase = OpenLibrary((CONST_STRPTR)"mathffp.library", 0);
-}
-
-static void runtime_close_libraries(void)
-{
-    if (MathBase != NULL) CloseLibrary(MathBase);
-    if (IntuitionBase != NULL) CloseLibrary(IntuitionBase);
-    if (GfxBase != NULL) CloseLibrary(GfxBase);
-    /* DOSBase/SysBase restano di proprieta' dello startup. */
-}
-#else
-static void runtime_open_libraries(void) { }
-static void runtime_close_libraries(void) { }
-#endif
-
