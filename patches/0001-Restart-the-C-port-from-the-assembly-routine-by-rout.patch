diff --git a/scripts/hunkbytes.py b/scripts/hunkbytes.py
new file mode 100644
index 0000000..6829b0a
--- /dev/null
+++ b/scripts/hunkbytes.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Ricostruisce i byte di un hunk da rebuild/source/Hnnn.asm.
+
+Usa le righe di commento '; Hnnn+$OFFSET: HEX  ...' (codice) e i blocchi
+'Preserved bytes Hnnn+$A..$B' seguiti da dc.w/dc.l/dc.b (dati).
+Uso: hunkbytes.py SRC_DIR HUNK OFFSET [LEN] | --str HUNK OFFSET | --ptr HUNK OFFSET
+"""
+import re, sys, os
+
+def load(src, hunk):
+    path = os.path.join(src, "H%03d.asm" % hunk)
+    mem = {}
+    pos = None
+    ins = re.compile(r"^; H%03d\+\$([0-9A-Fa-f]+): ([0-9a-f]+)\s" % hunk)
+    pres = re.compile(r"Preserved bytes H%03d\+\$([0-9A-Fa-f]+)\.\." % hunk)
+    for line in open(path, encoding="utf-8", errors="replace"):
+        m = ins.match(line)
+        if m:
+            off = int(m.group(1), 16); hx = m.group(2)
+            for i in range(0, len(hx), 2):
+                mem[off + i // 2] = int(hx[i:i + 2], 16)
+            pos = None
+            continue
+        m = pres.search(line)
+        if m:
+            pos = int(m.group(1), 16); continue
+        s = line.strip()
+        if pos is not None and s.startswith("dc."):
+            kind, rest = s[3], s[4:].strip()
+            for item in [x.strip() for x in rest.split(",") if x.strip()]:
+                if item.startswith("$"):
+                    v = int(item[1:], 16)
+                    n = {"b": 1, "w": 2, "l": 4}[kind]
+                elif kind == "l":            # rilocazione: Hnnn+$X -> 4 byte segnaposto
+                    v, n = None, 4
+                else:
+                    continue
+                for i in range(n):
+                    mem[pos + i] = None if v is None else (v >> (8 * (n - 1 - i))) & 0xFF
+                pos += n
+        elif pos is not None and s and not s.startswith(";") and not s.startswith("dc."):
+            pos = None
+    return mem
+
+def reloc(src, hunk, off):
+    path = os.path.join(src, "H%03d.asm" % hunk)
+    pres = re.compile(r"Preserved bytes H%03d\+\$([0-9A-Fa-f]+)\.\." % hunk)
+    pos = None
+    for line in open(path, encoding="utf-8", errors="replace"):
+        m = pres.search(line)
+        if m:
+            pos = int(m.group(1), 16); continue
+        s = line.strip()
+        if pos is not None and s.startswith("dc."):
+            kind, rest = s[3], s[4:].strip()
+            for item in [x.strip() for x in rest.split(",") if x.strip()]:
+                n = {"b": 1, "w": 2, "l": 4}[kind]
+                if pos == off and kind == "l" and not item.startswith("$"):
+                    return item
+                pos += n
+        elif pos is not None and s and not s.startswith(";"):
+            pos = None
+    return None
+
+if __name__ == "__main__":
+    src = sys.argv[1]
+    if sys.argv[2] == "--str":
+        h, o = int(sys.argv[3]), int(sys.argv[4], 16)
+        mem = load(src, h); out = []
+        while mem.get(o) not in (0, None) and len(out) < 200:
+            out.append(chr(mem[o])); o += 1
+        print(repr("".join(out)))
+    elif sys.argv[2] == "--ptr":
+        print(reloc(src, int(sys.argv[3]), int(sys.argv[4], 16)))
+    else:
+        h, o = int(sys.argv[2]), int(sys.argv[3], 16)
+        n = int(sys.argv[4], 16) if len(sys.argv) > 4 else 16
+        mem = load(src, h)
+        print(" ".join("??" if mem.get(o + i) is None else "%02X" % mem[o + i] for i in range(n)))
diff --git a/scripts/port_status.py b/scripts/port_status.py
new file mode 100644
index 0000000..6abdc7d
--- /dev/null
+++ b/scripts/port_status.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Stato del port asm -> C di src_c/readable.
+
+Legge le routine dalle schede '; ROUTINE: nome [livello]' di
+rebuild/source/Hnnn.asm (l'etichetta Lnnn_OFFSET che segue da' l'offset) e
+cerca nei sorgenti C i marcatori
+
+    /* PORT Hnnn+$XXXX */
+
+posti sopra ogni funzione portata.  Scrive src_c/readable/PORT_STATUS.md.
+Uso: scripts/port_status.py [--check]  (--check: esce con 1 se un marcatore
+non corrisponde a nessuna routine dell'asm).
+"""
+import glob, os, re, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ASM = os.path.join(ROOT, "rebuild", "source")
+SRC = os.path.join(ROOT, "src_c", "readable")
+
+def routines():
+    out = {}
+    for path in sorted(glob.glob(os.path.join(ASM, "H[0-9][0-9][0-9].asm"))):
+        hunk = int(os.path.basename(path)[1:4])
+        size = 0
+        pending = None
+        for line in open(path, encoding="utf-8", errors="replace"):
+            m = re.match(r"; H\d+: (\d+) original bytes", line)
+            if m:
+                size = int(m.group(1))
+            m = re.match(r"; ROUTINE: (\S+) \[(\w+)\]", line)
+            if m:
+                pending = (m.group(1), m.group(2))
+                continue
+            m = re.match(r"L(\d{3})_([0-9A-F]{8}):", line)
+            if m and pending:
+                off = int(m.group(2), 16)
+                out.setdefault(hunk, {"size": size, "routines": []})
+                out[hunk]["routines"].append((off, pending[0], pending[1]))
+                pending = None
+        out.setdefault(hunk, {"size": size, "routines": []})
+        out[hunk]["size"] = size
+    return out
+
+def ported():
+    marks = {}
+    for path in sorted(glob.glob(os.path.join(SRC, "*.c"))):
+        for n, line in enumerate(open(path, encoding="utf-8", errors="replace"), 1):
+            for m in re.finditer(r"PORT H(\d{3})\+\$([0-9A-Fa-f]+)", line):
+                key = (int(m.group(1)), int(m.group(2), 16))
+                marks[key] = "%s:%d" % (os.path.basename(path), n)
+    return marks
+
+def main():
+    rs = routines()
+    marks = ported()
+    known = {(h, off) for h, d in rs.items() for off, _, _ in d["routines"]}
+    unknown = sorted(k for k in marks if k not in known)
+    total = sum(len(d["routines"]) for d in rs.values())
+    done = sum(1 for k in marks if k in known)
+    lines = ["# Stato del port asm -> C", "",
+             "Generato da `scripts/port_status.py`: routine delle schede `ROUTINE` "
+             "di `rebuild/source`, portate se un sorgente di questa cartella ha il "
+             "marcatore `/* PORT Hnnn+$XXXX */`.", "",
+             "Routine portate: **%d / %d**." % (done, total), "",
+             "| Hunk | Byte | Routine | Portate |", "| --- | ---: | ---: | ---: |"]
+    for h in sorted(rs):
+        d = rs[h]
+        n = len(d["routines"])
+        p = sum(1 for off, _, _ in d["routines"] if (h, off) in marks)
+        lines.append("| H%03d | %d | %d | %d |" % (h, d["size"], n, p))
+    lines += ["", "## Dettaglio", ""]
+    for h in sorted(rs):
+        d = rs[h]
+        if not d["routines"]:
+            continue
+        lines.append("### H%03d" % h)
+        lines.append("")
+        lines.append("| Offset | Nome nell'analisi | Analisi | Port |")
+        lines.append("| --- | --- | --- | --- |")
+        for off, name, level in d["routines"]:
+            where = marks.get((h, off), "")
+            lines.append("| `$%04X` | `%s` | %s | %s |" % (off, name, level, where))
+        lines.append("")
+    if unknown:
+        lines += ["## Marcatori senza routine nell'asm", ""]
+        lines += ["- `H%03d+$%04X` (%s)" % (h, o, marks[(h, o)]) for h, o in unknown]
+    with open(os.path.join(SRC, "PORT_STATUS.md"), "w") as f:
+        f.write("\n".join(lines) + "\n")
+    print("ported %d/%d routines" % (done, total))
+    if "--check" in sys.argv and unknown:
+        for h, o in unknown:
+            print("marker without routine: H%03d+$%04X (%s)" % (h, o, marks[(h, o)]))
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
