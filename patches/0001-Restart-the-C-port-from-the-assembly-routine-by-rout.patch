diff --git a/src_c/readable/view3d.c b/src_c/readable/view3d.c
deleted file mode 100644
index 4793101..0000000
--- a/src_c/readable/view3d.c
+++ /dev/null
@@ -1,323 +0,0 @@
-/*
- * Champions of Krynn - mappa 16x16 e vista 3D in C leggibile.
- *
- * Ricostruzione di H011+$1876 (GEO), H011+$14EA (WALLDEF),
- * H011+$01AA (lettura cella).
- *
- * GEO: blocco da 1026 byte, due byte di header e quattro aree da 256.
- * WALLDEF: unita' da 780 byte; un blocco puo' contenerne una o due.
- * LOAD PIECES aggiorna il gruppo WALLDEF usato dalla vista.
- */
-
-#include "cok/platform.h"
-#include <string.h>
-#if !COK_AMIGA
-#include <stdio.h>
-#endif
-
-#include "cok.h"
-#include "cok/globals.h"
-#include "cok/intuition_exec.h"
-#include "cok/resources.h"
-#include "cok/tile8.h"
-#include "cok/view3d.h"
-
-/* H011+$1876 */
-int world_load_geo(const char *path, uint8_t block, WorldMap *map)
-{
-    uint16_t size = 0;
-    uint8_t *data;
-
-    if (map == NULL) {
-        return -1;
-    }
-
-    data = cok_dax_load_block(path, block, &size);
-    if (data == NULL || size < GEO_BLOCK_BYTES) {
-        if (data != NULL) {
-            cok_dax_free(data, size);
-        }
-        return -1;
-    }
-
-    memset(map, 0, sizeof(*map));
-    map->geo_set = block;
-
-    /* Il blocco GEO inizia con due byte di header, poi quattro aree da 256. */
-    memcpy(map->planes[0], data + 2, 256);
-    memcpy(map->planes[1], data + 2 + 256, 256);
-    memcpy(map->planes[2], data + 2 + 512, 256);
-    memcpy(map->planes[3], data + 2 + 768, 256);
-    memcpy(map->cells, data + 2, sizeof(map->cells));
-
-    cok_dax_free(data, size);
-    return 0;
-}
-
-/* H011+$01AA: indice y*16+x, coordinate normalizzate 0..15. */
-uint8_t world_cell(const WorldMap *map, uint8_t x, uint8_t y)
-{
-    if (map == NULL) {
-        return 0;
-    }
-    return map->cells[y & 0x0F][x & 0x0F];
-}
-
-uint8_t world_cell_plane(const WorldMap *map, uint8_t plane,
-                         uint8_t x, uint8_t y)
-{
-    if (map == NULL || plane >= 4) {
-        return 0;
-    }
-    return map->planes[plane][(uint16_t)(y & 0x0F) * WORLD_W + (x & 0x0F)];
-}
-
-/* H011+$14EA: carica WALLDEF e conserva le facce nel WorldMap. */
-int wall_load(const char *path, uint8_t block,
-              WorldMap *map, uint16_t max_walls)
-{
-    uint16_t size = 0;
-    uint8_t *data;
-    uint16_t count;
-
-    if (map == NULL) {
-        return -1;
-    }
-
-    data = cok_dax_load_block(path, block, &size);
-    if (data == NULL) {
-        return -1;
-    }
-
-    count = (uint16_t)(size / WALL_UNIT_BYTES);
-    if (max_walls != 0 && count > max_walls) {
-        count = max_walls;
-    }
-    if (count > WORLD_MAX_WALLS) {
-        count = WORLD_MAX_WALLS;
-    }
-
-    memcpy(map->walls, data, (size_t)count * WALL_UNIT_BYTES);
-    map->wall_count = count;
-    map->wall_set = block;
-
-    cok_dax_free(data, size);
-    return (int)count;
-}
-
-/* Passo sulla griglia GEO con wrap 0..15. */
-int world_step(uint8_t *x, uint8_t *y, uint8_t direction)
-{
-    if (x == NULL || y == NULL) {
-        return -1;
-    }
-
-    switch (direction) {
-    case WORLD_DIR_NORTH:
-        *y = (uint8_t)((*y + WORLD_H - 1) & 0x0F);
-        break;
-    case WORLD_DIR_EAST:
-        *x = (uint8_t)((*x + 1) & 0x0F);
-        break;
-    case WORLD_DIR_SOUTH:
-        *y = (uint8_t)((*y + 1) & 0x0F);
-        break;
-    case WORLD_DIR_WEST:
-        *x = (uint8_t)((*x + WORLD_W - 1) & 0x0F);
-        break;
-    default:
-        return -1;
-    }
-    return 0;
-}
-
-const WallDefinition *world_wall(const WorldMap *map, uint16_t index)
-{
-    if (map == NULL || map->wall_count == 0) {
-        return NULL;
-    }
-    return &map->walls[index % map->wall_count];
-}
-
-/*
- * Layout near/mid/far x left/center/right.
- * La corrispondenza precisa con i blocchi WALLDEF resta parziale: qui si
- * usa il gruppo aggiornato da LOAD PIECES e un indice deterministico.
- */
-const WallDefinition *world_view_wall(const WorldMap *map,
-                                      uint8_t distance, uint8_t side)
-{
-    uint16_t index;
-
-    if (map == NULL || map->wall_count == 0) {
-        return NULL;
-    }
-    index = (uint16_t)(distance * 3u + side + map->wall_set);
-    return world_wall(map, index);
-}
-
-/* ---------------------------------------------------------------- */
-/* Vista 3D: H011+$0B78/H011+$0868                                  */
-/* ---------------------------------------------------------------- */
-
-#define WALL_FACE_BYTES 156u
-#define WALL_FACE_W     12u
-#define WALL_FACE_H     13u
-#define WALL_SHEET_COUNT 5u
-
-static WorldMap g_view_map;
-static int g_view_ready;
-static Tile8Sheet *g_wall_sheet[WALL_SHEET_COUNT];
-
-static const uint8_t g_wall_sheet_id[WALL_SHEET_COUNT] = {
-    0x0B, 0x0C, 0x1F, 0x20, 0x17
-};
-
-int world_view_init(uint8_t group)
-{
-    char geo_name[32];
-    char wall_name[32];
-    uint8_t i;
-
-    if (g_view_ready) {
-        return 0;
-    }
-    if (group < 1u || group > 2u) {
-        group = 1;
-    }
-    snprintf(geo_name, sizeof(geo_name), "GEO%u.DAX", (unsigned)group);
-    snprintf(wall_name, sizeof(wall_name), "WALLDEF%u.DAX", (unsigned)group);
-
-    if (world_load_geo(geo_name, 1, &g_view_map) != 0) {
-        return -1;
-    }
-    (void)wall_load(wall_name, 1, &g_view_map, WORLD_MAX_WALLS);
-
-    for (i = 0; i < WALL_SHEET_COUNT; ++i) {
-        g_wall_sheet[i] = tile8_sheet_load_daa("8X8D1.DAA",
-                                               g_wall_sheet_id[i]);
-        if (g_wall_sheet[i] == NULL) {
-            g_wall_sheet[i] = tile8_sheet_load_daa("8X8D0.DAA",
-                                                   g_wall_sheet_id[i]);
-        }
-    }
-    g_view_ready = 1;
-    return 0;
-}
-
-/* H049+$0082: un codice tile sceglie uno dei cinque fogli 8x8D. */
-static void view_draw_tile(RastPort *rp, uint8_t code,
-                           uint16_t cell_x, uint16_t cell_y)
-{
-    uint8_t sheet;
-    uint16_t column;
-
-    if (code == 0) {
-        return;
-    }
-    if (code < 0x2Eu) {
-        sheet = 0;
-        column = (uint16_t)(code - 1u);
-    } else if (code < 0x74u) {
-        sheet = 1;
-        column = (uint16_t)(code - 0x2Eu);
-    } else if (code < 0xBAu) {
-        sheet = 2;
-        column = (uint16_t)(code - 0x74u);
-    } else {
-        sheet = 3;
-        column = (uint16_t)(code - 0xBAu);
-    }
-    if (g_wall_sheet[sheet] != NULL) {
-        tile8_draw(rp, g_wall_sheet[sheet], column, cell_x, cell_y);
-    }
-}
-
-/*
- * H011+$0868: disegna una faccia di parete (12x13 tile) nel viewport.
- * `step` 1 = vicino, 2 = lontano (campionamento del foglio).
- */
-static void view_draw_face(RastPort *rp, const uint8_t *face,
-                           uint16_t x_cell, uint16_t y_cell, uint16_t step)
-{
-    uint16_t fx;
-    uint16_t fy;
-
-    for (fy = 0; fy < WALL_FACE_H; fy += step) {
-        for (fx = 0; fx < WALL_FACE_W; fx += step) {
-            uint16_t sx = (uint16_t)(x_cell + fx / step);
-            uint16_t sy = (uint16_t)(y_cell + fy / step);
-            uint8_t code = face[fy * WALL_FACE_W + fx];
-
-            view_draw_tile(rp, code, sx, sy);
-        }
-    }
-}
-
-void world_view_draw(void)
-{
-    RastPort *rp;
-    uint8_t x;
-    uint8_t y;
-    uint8_t dir;
-    uint8_t distance;
-    int8_t dx[4] = { 0, 1, 0, -1 };
-    int8_t dy[4] = { -1, 0, 1, 0 };
-
-    rp = ui_get_rastport();
-    if (rp == NULL || !g_view_ready) {
-        return;
-    }
-    ui_restore_game_palette();
-    ui_rect_fill(rp, 0, 0, 319, 135, 0);
-
-    if (H005_G == NULL) {
-        return;
-    }
-    x = (uint8_t)H005_G->views.initial.initial_view_0;
-    y = (uint8_t)H005_G->views.initial.initial_view_1;
-    dir = (uint8_t)(H005_G->views.initial.initial_view_2 & 3u);
-
-    for (distance = 0; distance < 3; ++distance) {
-        uint8_t cell;
-        uint16_t block;
-        uint16_t slot;
-        const uint8_t *face;
-        uint16_t x_cell;
-        uint16_t y_cell;
-        uint16_t step;
-
-        x = (uint8_t)((x + dx[dir] + WORLD_W) & 0x0F);
-        y = (uint8_t)((y + dy[dir] + WORLD_H) & 0x0F);
-        cell = world_cell(&g_view_map, x, y);
-        if (cell == 0) {
-            continue;
-        }
-        block = (uint16_t)((cell - 1u) % (g_view_map.wall_count ?
-                                          g_view_map.wall_count : 1u));
-        slot = (uint16_t)(((cell - 1u) + dir) % 5u);
-        face = g_view_map.walls[block].data + slot * WALL_FACE_BYTES;
-
-        if (distance == 0) {
-            x_cell = 14;
-            y_cell = 2;
-            step = 1;
-        } else if (distance == 1) {
-            x_cell = 16;
-            y_cell = 5;
-            step = 2;
-        } else {
-            x_cell = 17;
-            y_cell = 6;
-            step = 2;
-        }
-        view_draw_face(rp, face, x_cell, y_cell, step);
-        break;
-    }
-}
-
-void world_view_reset(void)
-{
-    g_view_ready = 0;
-}
