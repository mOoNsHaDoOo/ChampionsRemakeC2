-/* H094+$0288: prepara ciclo, periodo e forma d'onda della voce. */
-static void audio_voice_prepare(AudioVoice *v, uint8_t note, uint8_t inst,
-                                uint8_t dynamic, int loop)
-{
-    const AudioInstrument *in;
-    const AudioSample *sample = NULL;
-    uint32_t period_base;
-    uint32_t length;
-    uint32_t stride;
-
-    in = (inst < (uint8_t)audio_instrument_count) ?
-         &audio_instruments[inst] : NULL;
-    if (in != NULL && in->sample >= 0 &&
-        in->sample < (int)audio_sample_count &&
-        audio_samples[in->sample].length >= 2u) {
-        sample = &audio_samples[in->sample];
-    }
-    v->sample = sample;
-    v->instrument = inst;
-    v->note = note;
-    v->volume = (uint8_t)((64u * dynamic) / 127u);
-    audio_env_init(&v->vol_env, in != NULL ? in->vol_env : -1, 64);
-    audio_env_init(&v->ptch_env, in != NULL ? in->ptch_env : -1, 0);
-
-    period_base = audio_periods[note];
-    if (period_base == 0u) {
-        period_base = 8000u;
-    }
-    length = sample != NULL ? sample->length : 64u;
-    if (length == 0u) {
-        length = 64u;
-    }
-    while (length > 2u && (period_base / length) < 124u) {
-        length >>= 1;
-    }
-    if (length < 2u) {
-        length = 2u;
-    }
-    if ((length & 1u) != 0u) {
-        --length;
-    }
-    stride = sample != NULL ? sample->length / length : 1u;
-    if (stride == 0u) {
-        stride = 1u;
-    }
-    v->period = (uint16_t)(period_base / length);
-    if (v->period < 124u) {
-        v->period = 124u;
-    }
-    if (v->period > 65535u) {
-        v->period = 65535u;
-    }
-    v->cycle = (uint16_t)length;
-    v->ptch_env.current = (int16_t)v->period;
-    v->oneshot = (uint8_t)(!loop);
-    v->data_len = 0u;
-    v->stopping = 0u;
-    (void)stride;
-}
