-    /*
-     * H006+$06EE: "Loading...Please Wait" nella riga 24 (y=192),
-     * penna 10, lunghezza 21.  Resta visibile durante l'attesa iniziale
-     * dell'introduzione e viene poi coperto dalla prima immagine.
-     */
-    intro_clear_screen();
-    (void)text_font_draw("Loading...Please Wait", 0, 24 * 8, 10, 21);
-
-    /* H007+$09E6: controllo iniziale. */
-    if (ui_wait_key_timeout(1)) {
-        intro_finish();
-        return;
-    }
-
-    for (loop = 0; loop < 3; ++loop) {
-        if (intro_show_image("scrn1b.LBM", 0, 0, 320, 200, 1) != 0) {
-            break;
-        }
-        if (ui_wait_key_timeout(3)) {
-            break;
-        }
-
-        if (intro_show_image("scrn2.LBM", 0, 0, 320, 200, 1) != 0) {
-            break;
-        }
-        if (ui_wait_key_timeout(3)) {
-            break;
