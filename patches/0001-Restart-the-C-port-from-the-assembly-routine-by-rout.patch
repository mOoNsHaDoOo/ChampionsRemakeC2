-
-    if (ch == NULL) {
-        return 0;
-    }
-    item = item_head_get(ch);
-    while (item != NULL) {
-        if (item->cursed != 0) {
-            item->cursed = 0;
-            ++removed;
-        }
-        item = item_next(item);
-    }
-    return removed;
-}
-
-/* Il servizio e' applicabile al personaggio? */
-static int temple_service_applicable(const CharacterRecord *ch,
-                                     TempleService service)
-{
-    uint8_t status = ch->status;
-    uint16_t hp = character_hp(ch);
-    uint16_t max = character_hp_max(ch);
-
-    switch (service) {
-    case CURE_LIGHT_WOUNDS:
-    case CURE_SERIOUS_WOUNDS:
-    case CURE_CRITICAL_WOUNDS:
-    case HEAL:
-        return max == 0 || hp < max;
-
-    case CURE_BLINDNESS:
-        return effect_present(ch, EFFECT_BLINDNESS);
-
-    case CURE_DISEASE:
-        return effect_present_any(ch, disease_effects,
-                                  sizeof(disease_effects));
-
-    case NEUTRALIZE_POISON: {
-        static const uint8_t poison_effects[] = {
-            EFFECT_POISON_A, EFFECT_POISON_B, EFFECT_POISON_C
-        };
-        return effect_present_any(ch, poison_effects,
-                                  sizeof(poison_effects));
-    }
-
-    case REMOVE_CURSE:
-        return character_has_cursed_item(ch);
-
-    case RAISE_DEAD:
-        return status == STATUS_DEAD || status == STATUS_UNCONSCIOUS;
-
-    case STONE_TO_FLESH:
-        return status == STATUS_STONE;
-
-    default:
-        return 0;
-    }
-}
-
-static void temple_apply(CharacterRecord *ch, TempleService service)
-{
-    uint8_t status = ch->status;
-
-    switch (service) {
-    case CURE_LIGHT_WOUNDS:
-        character_heal(ch, 8);          /* 1d8, massimo */
-        break;
-
-    case CURE_SERIOUS_WOUNDS:
-        character_heal(ch, 17);         /* 2d8+1, massimo */
-        break;
-
-    case CURE_CRITICAL_WOUNDS:
-        character_heal(ch, 27);         /* 3d8+3, massimo */
-        break;
-
-    case HEAL:
-        character_set_hp(ch, character_hp_max(ch));
-        break;
-
-    case CURE_BLINDNESS:
-        effect_remove(ch, EFFECT_BLINDNESS);
-        break;
-
-    case CURE_DISEASE:
-        effect_remove_any(ch, disease_effects, sizeof(disease_effects));
-        break;
-
-    case NEUTRALIZE_POISON: {
-        static const uint8_t poison_effects[] = {
