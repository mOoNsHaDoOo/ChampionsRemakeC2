-#if COK_AMIGA
-static uint8_t cok_icon_get_pixel(const BitMap *bm, int x, int y)
-{
-    uint8_t value = 0;
-    int plane;
-
-    for (plane = 0; plane < 5; ++plane) {
-        const uint8_t *p = (const uint8_t *)bm->Planes[plane];
-        if (p[y * bm->BytesPerRow + (x >> 3)] &
-            (uint8_t)(0x80u >> (x & 7))) {
-            value = (uint8_t)(value | (1u << plane));
-        }
-    }
-    return value;
-}
-
-static void cok_icon_set_pixel(BitMap *bm, int x, int y, uint8_t value)
-{
-    uint8_t mask = (uint8_t)(0x80u >> (x & 7));
-    int plane;
-
-    for (plane = 0; plane < 5; ++plane) {
-        uint8_t *p = (uint8_t *)bm->Planes[plane];
-        if ((value & (1u << plane)) != 0) {
-            p[y * bm->BytesPerRow + (x >> 3)] |= mask;
-        } else {
-            p[y * bm->BytesPerRow + (x >> 3)] &= (uint8_t)~mask;
-        }
-    }
-}
-
-/*
- * Copia una cella 24x24.  Con overlay=1 i pixel dello sfondo del foglio
- * (nero 0 + griglia 16..31) vengono lasciati inalterati: serve per
- * sovrapporre testa e corpo sul grigio di sfondo.
- */
-static int cok_icon_copy_cell(BitMap *dst, const BitMap *src,
-                              int16_t sx, int16_t sy, int overlay)
-{
-    int y;
-    int x;
-
-    if (dst == NULL || src == NULL) {
-        return 0;
-    }
-    for (y = 0; y < COK_ICON_SIZE; ++y) {
-        for (x = 0; x < COK_ICON_SIZE; ++x) {
-            uint8_t value = cok_icon_get_pixel(src, sx + x, sy + y);
-            if (overlay && (value == COK_ICON_BG_INDEX || value >= 16u)) {
-                continue;
-            }
-            cok_icon_set_pixel(dst, x, y, value);
-        }
-    }
-    return 1;
-}
-
-/* Rimappa gli indici di palette della cella (colori delle parti). */
-static void cok_icon_remap_cell(BitMap *bm, const uint8_t *remap)
-{
-    int y;
-    int x;
-
-    if (bm == NULL || remap == NULL) {
-        return;
-    }
-    for (y = 0; y < COK_ICON_SIZE; ++y) {
-        for (x = 0; x < COK_ICON_SIZE; ++x) {
-            uint8_t index = cok_icon_get_pixel(bm, x, y);
-            cok_icon_set_pixel(bm, x, y, remap[index & 31u]);
-        }
-    }
-}
-
-/*
- * H029+$0766: costruisce la maschera a partire dal bitmap composto.
- * Un pixel e' opaco (maschera=1) se non e' nero (indice 0); il nero
- * resta trasparente e, nel blit cookie-cut, lascia vedere lo sfondo
- * grigio della schermata (penna 8, vedi H047+$0392).
- */
-static void cok_icon_derive_mask(GraphicRecord *rec)
-{
-    BitMap *mask_bm;
-    uint8_t *mask;
-    int y;
-    int x;
-
-    if (rec == NULL || rec->bitmap == NULL || rec->mask_or_aux == 0) {
-        return;
-    }
-    mask_bm = (BitMap *)(uintptr_t)rec->mask_or_aux;
-    mask = (uint8_t *)mask_bm->Planes[0];
-    for (y = 0; y < COK_ICON_SIZE; ++y) {
-        for (x = 0; x < COK_ICON_SIZE; ++x) {
-            if (cok_icon_get_pixel(rec->bitmap, x, y) != 0) {
-                mask[y * mask_bm->BytesPerRow + (x >> 3)] |=
-                    (uint8_t)(0x80u >> (x & 7));
-            }
-        }
-    }
-}
-#endif
-
-static void cok_icon_make_remap(const uint8_t pair[6], uint8_t remap[32]);
-
-/*
- * Compone corpo + testa e disegna l'icona 24x24.
- * body_cell viene dal foglio charS.LBM (righe 0..3), head_cell dalla
- * riga 5; il colore grigio della testa non copre il corpo.
- */
-static void cok_icon_blit_composed(RastPort *rp, int16_t dx, int16_t dy,
-                                   uint16_t body_cell, uint16_t head_cell,
-                                   uint16_t size, const uint8_t *remap)
-{
-#if COK_AMIGA
-    IlbmImage *sheet = cok_icon_sheet(size);
-    GraphicRecord *rec;
-
-    if (rp == NULL || sheet == NULL || sheet->bitmap == NULL) {
-        return;
-    }
-    rec = graphic_record_alloc(COK_ICON_SIZE, COK_ICON_SIZE, 5, 1);
-    if (rec == NULL || rec->bitmap == NULL) {
-        if (rec != NULL) {
-            graphic_record_free(rec, 5, 1);
-        }
-        return;
-    }
-    if (cok_icon_copy_cell(rec->bitmap, sheet->bitmap,
-                           (int16_t)(COK_ICON_X0 +
-                                     (body_cell % COK_ICON_COLS) *
-                                     COK_ICON_SIZE),
-                           (int16_t)(COK_ICON_Y0 +
-                                     (body_cell / COK_ICON_COLS) *
-                                     COK_ICON_SIZE), 1) &&
-        cok_icon_copy_cell(rec->bitmap, sheet->bitmap,
-                           (int16_t)(COK_ICON_X0 +
-                                     (head_cell % COK_ICON_COLS) *
-                                     COK_ICON_SIZE),
-                           (int16_t)(COK_ICON_Y0 +
-                                     (head_cell / COK_ICON_COLS) *
-                                     COK_ICON_SIZE), 1)) {
-        if (remap != NULL) {
-            cok_icon_remap_cell(rec->bitmap, remap);
-        }
-        /* H029+$0766: maschera = pixel non neri; il blit cookie-cut
-         * (minterm $E0) lascia il nero trasparente. */
-        cok_icon_derive_mask(rec);
-        /* H047+$0392: riempi la cella 24x24 con il grigio (penna 8)
-         * prima del blit, cosi' il nero trasparente mostra il grigio. */
-        ui_rect_fill(rp, dx, dy, (int16_t)(dx + COK_ICON_SIZE - 1),
-                     (int16_t)(dy + COK_ICON_SIZE - 1), 8);
-        /* H029+$0C9E: il blit mascherato prende il PIANO di maschera
-         * (Planes[0] della BitMap), non la BitMap stessa. */
-        BltMaskBitMapRastPort(rec->bitmap, 0, 0, rp, dx, dy,
-                              COK_ICON_SIZE, COK_ICON_SIZE, (UBYTE)0xE0,
-                              ((BitMap *)(uintptr_t)rec->mask_or_aux)->Planes[0]);
-        WaitBlit();
-    }
-    graphic_record_free(rec, 5, 1);
-#else
-    (void)rp; (void)dx; (void)dy; (void)body_cell; (void)head_cell;
-    (void)size; (void)remap;
-#endif
-}
