-/* H094+$050C..$0572: envelope di periodo. */
-static void audio_env_period_tick(EnvState *e)
-{
-    int guard;
-
-    if (!e->active) {
-        return;
-    }
-    if (e->count > 0u) {
-        --e->count;
-        e->current = (int16_t)(e->current + e->delta);
-        if (e->count > 0u) {
-            return;
-        }
-    }
-    for (guard = 0; guard < 64; ++guard) {
-        int b1;
-        int b2;
-
-        if (e->ptr == NULL || e->ptr >= e->end) {
-            e->active = 0;
-            return;
-        }
-        b1 = *e->ptr++;
-        if (b1 == 0xFF) {
-            if (e->ptr >= e->end) {
-                e->active = 0;
-                return;
-            }
-            b2 = *e->ptr++;
-            if (b2 == 0) {
-                e->ended = 1;
-                e->active = 0;
-                e->ptr = NULL;
-                return;
-            }
-            if (b2 == 1) {
-                e->active = 0;
-                e->ptr = NULL;
-                return;
-            }
-            if (e->ptr >= e->end) {
-                e->active = 0;
-                return;
-            }
-            e->current = (int16_t)((b2 << 8) | *e->ptr++);
-            continue;
-        }
-        if (b1 == 0xFE) {
-            if (e->ptr >= e->end) {
-                e->active = 0;
-                return;
-            }
-            b2 = *e->ptr++;
-            {
-                uint32_t off = (uint32_t)(e->ptr - e->base);
-                uint32_t back = (uint32_t)((b2 + 1) * 2);
-
-                if (off < back) {
-                    e->active = 0;
-                    return;
-                }
-                e->ptr = e->base + (off - back);
-            }
-            continue;
-        }
-        if (e->ptr >= e->end) {
-            e->active = 0;
-            return;
-        }
-        b2 = *e->ptr++;
-        e->count = (uint8_t)b1;
-        e->delta = (int16_t)(int8_t)b2;
-        return;
-    }
-    e->active = 0;
-}
