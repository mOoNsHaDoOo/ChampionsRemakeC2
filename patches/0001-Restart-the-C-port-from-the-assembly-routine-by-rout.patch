-/*
- * Menu a lista ricostruito da H008+$13C0/H008+$1448.
- * Titolo in riga 24, voci dalla riga 12, selezione in video inverso.
- */
-int ui_list_menu(const char *title, const char *const *items, uint16_t count)
-{
-    uint16_t selected = 0;
-    uint8_t key;
-
-    if (items == NULL || count == 0) {
-        return -1;
-    }
-    for (;;) {
-        RastPort *rp = ui_get_rastport();
-        uint16_t i;
-
-        ui_restore_game_palette();
-        ui_install_game_pointer(10);
-        if (rp != NULL) {
-            ui_rect_fill(rp, 0, 0, 319, 199, 0);
-            ui_draw_menu_frame(rp, 1);
-        }
-        if (title != NULL) {
-            /* H013+$0B98: titolo del menu di creazione in penna 0x0D. */
-            (void)text_font_draw(title, 1 * 8, 2 * 8,
-                                 (int16_t)0x0D,
-                                 (int16_t)strlen(title));
-        }
-        ui_draw_inverse_text("Select ", 0, 24 * 8, 7, 0x0F);
-        (void)text_font_draw("Exit", 9 * 8, 24 * 8, (int16_t)0x0A, 4);
-        for (i = 0; i < count; ++i) {
-            if (i == selected) {
-                ui_draw_inverse_text(items[i], 2 * 8,
-                                     (int16_t)((4 + i) * 8),
-                                     (uint16_t)strlen(items[i]), 0x0F);
-            } else {
-                (void)text_font_draw(items[i], 2 * 8,
-                                     (int16_t)((4 + i) * 8),
-                                     (int16_t)0x0A, 0);
-            }
-        }
-
-        key = ui_wait_key();
-        {
-            int16_t mx, my;
-            if (ui_mouse_take(&mx, &my)) {
-                int row = my / 8;
-                if (row >= 4 && row < 4 + (int)count) {
-                    uint16_t hit = (uint16_t)(row - 4);
-
-                    /*
-                     * H008+$1AF4/H008+$1E44: il primo click sposta la
-                     * selezione, il click sulla voce gia' evidenziata la
-                     * conferma.
-                     */
-                    if (hit == selected) {
-                        return (int)selected;
-                    }
-                    selected = hit;
-                    continue;
-                }
-                if (row == 24) {
-                    if (mx >= 0 && mx < 7 * 8) {
-                        return (int)selected;      /* Select */
-                    }
-                    if (mx >= 9 * 8 && mx < 13 * 8) {
-                        return -1;                 /* Exit */
-                    }
-                }
-                continue;
-            }
-        }
-        if (key == 0x4C) {
-            selected = (uint16_t)((selected == 0) ? count - 1 : selected - 1);
-            continue;
-        }
-        if (key == 0x4D) {
-            ++selected;
-            if (selected >= count) {
-                selected = 0;
-            }
-            continue;
-        }
-        if (key == 0x0D) {
-            return (int)selected;
-        }
-        if (key == 0x1B) {
-            return -1;
-        }
-        for (i = 0; i < count; ++i) {
-            if ((uint8_t)items[i][0] == key) {
-                return (int)i;
-            }
-        }
-    }
-}
