+{
+    Character *p;                       /* -$4(a5) */
+    u8 k;                               /* -$7(a5) */
+
+    H005_B(0x24E3) = 1;
+    for (p = g_party_head; p != NULL; p = p->next) {
+        if (!is_player(p)) {
+            continue;
+        }
+        for (k = 0; k <= 6; ++k) {
+            SET_POOL(k, POOL(k) + COINS(p, k));
+            sub_weight(p, COINS(p, k));
+        }
+        h029_fill_bytes(0x0D, &p->b[0xF0], 0x0E, 0);
+    }
+}
