+    u16 k;                              /* -$1E(a5) */
+
+    H005_B(0x2499) = 0;
+    H005_B(0x24D0) = 1;
+    s_fled = 0;
+    for (p = g_party_head; p != NULL && TURN(p)->b[0x15] != 1; p = p->next) {
+        if (p->b[0x197] == 3) {
+            s_fled = 1;
+        }
+    }
+    for (p = g_party_head; p != NULL && !alive; p = p->next) {
+        if (p->b[0x198] || p->b[0x197] == 4 || p->b[0x197] == 3 ||
+            p->b[0x197] == 5) {
+            alive = 1;
+        }
+    }
+    if (COK_GET16(g_state_b + 0x5CC) && alive) {
+        H005_B(0x24D0) = 0;
+    }
+    H005_B(0x24C0) = 0;
+    if (H005_B(0x24D7)) {
+        return;
+    }
+    for (p = g_party_head; p != NULL && TURN(p)->b[0x15] != 1; p = p->next) {
+        if ((p->b[0x197] == 3 || p->b[0x197] == 1 || p->b[0x197] == 0) &&
+            p->b[0x199] == 0 && p->b[0xEC] < 0x80) {
+            H005_B(0x24D0) = 0;
+        }
+        if (p->b[0x197] == 1 || p->b[0x197] == 0) {
+            H005_B(0x24C0) = 1;
+            s_fled = 0;
+        }
+        if (!p->b[0x198] || p->b[0x197] == 1) {
+            add_to_byte(&H005_B(0x2499), 1);
+        }
+        for (k = 1; k <= 0x0B; ++k) {
+            remove_effect(p, effects[k - 1], NULL);
+        }
+    }
+    if (H005_B(0x24C0)) {
+        u32 xp = 0;
+
+        compute_experience(&xp);
+        H005_SET_L(0x236E, xp);
+        award_experience(H005_L(0x236E));
+    }
+    p = g_party_head;
+    if (!H005_B(0x24D0)) {
+        while (p != NULL && TURN(p)->b[0x15] != 1) {
+            if (!s_fled) {
+                switch (p->b[0x197]) {
+                case 3:
+                    p->b[0x197] = 0;
+                    p->b[0x198] = 1;
+                    break;
+                case 4:
+                    if (COK_GET16(g_state_b + 0x5CC)) {
+                        p->b[0x197] = 0;
+                        p->b[0x198] = 1;
+                        p->b[0x1A8] = 1;
+                    } else {
+                        p->b[0x197] = 4;
+                    }
+                    break;
+                case 5:
+                    if (p->b[0x1A8] > 0) {
+                        p->b[0x197] = 0;
+                        p->b[0x198] = 1;
+                    } else if (COK_GET16(g_state_b + 0x5CC)) {
+                        p->b[0x197] = 0;
+                        p->b[0x198] = 1;
+                        p->b[0x1A8] = 1;
+                    }
+                    break;
+                default:
+                    break;
+                }
+                p = p->next;
+            } else {
+                COK_PUT16(g_state_b + 0x58E, 0x81);
+                if (p->b[0x197] == 3) {
+                    p->b[0x197] = 0;
+                    p->b[0x198] = 1;
+                    p = p->next;
+                } else {
+                    g_current_char = p;
+                    p = p->next;
+                    remove_from_party(0, 1);
+                }
+            }
+        }
+    } else {
+        stop = 0;
+        while (p != NULL && !stop) {
+            n = p->next;
+            if (TURN(p)->b[0x15] != 1) {
+                g_current_char = p;
+                remove_from_party(0, 1);
+            } else {
+                stop = 1;
+            }
+            p = n;
+        }
+        COK_PUT16(g_state_b + 0x67C, 0);
+    }
+}
