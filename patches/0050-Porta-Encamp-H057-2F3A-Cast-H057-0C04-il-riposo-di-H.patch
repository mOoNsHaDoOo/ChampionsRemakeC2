+    redraw = 1;
+    index = 0;
+    draw_screen_frame(1);
+    (void)list_menu(0, "", 0, "", 0x0B, 0x0A, 0x0F, 1, 4, 0x26, 0x16,
+                    f.head, 1, &redraw, &index, &f.tail);
