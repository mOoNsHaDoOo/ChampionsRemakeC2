+    Character *p = g_party_head;        /* -$8(a5) */
+    Character *next;                    /* -$C(a5) */
+
+    if (p == CUR) {
+        while (p->next != NULL) {
+            p = p->next;
+        }
+    } else {
+        while (p->next != CUR) {
+            before = p;
+            p = p->next;
+        }
+    }
+    next = CUR->next;
+    if (g_party_head == CUR) {
+        if (next != NULL) {
+            g_party_head = next;
+        }
+        p->next = CUR;
+        CUR->next = NULL;
+    } else {
+        p->next = next;
+        CUR->next = p;
+        if (p == g_party_head || before == NULL) {
+            g_party_head = CUR;
+        } else {
+            before->next = CUR;
+        }
+    }
+}
