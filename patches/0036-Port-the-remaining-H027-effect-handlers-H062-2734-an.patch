+                H005_SET_W(0x3154 + (n - 1) * 6, (u16)x);
+                H005_SET_W(0x3154 + (n - 1) * 6 + 2, (u16)y);
+                h043_190e(0x16);
+                revived = revive(s, s->b[0x64], 8, "gates in");
+                s = s->next;
+                if (s == NULL || s->b[0x197] != 9) {
+                    done = 1;
+                }
+            }
+            ++dir;
+        } while (!revived && (s16)dir <= 7);
+    } while (!done && anchor != *cp);
+    remove_effect(*cp, 0x4C, NULL);
+}
