+    u16 b;
+    Character *q;
+
+    H005_B(0x2473) = 0;
+    for (i = 1; i <= H005_W(0x14); ++i) {
+        p = g_h005_0016[i - 1];
+        if (p != NULL) {
+            show_char_message(p, 9, "explodes.", 0x0A, 1);
+            a = h048_0f88(p);
+            b = h048_0fba(p);
+            h077_08ac(h048_110c(a, b, 1, 0xFF, p), g_combat_area);
+            if (H005_B(0x2479) > 1) {
+                n = (u16)(H005_B(0x2479) - 1);
+                for (j = 2; j <= H005_B(0x2479); ++j) {
+                    list[j - 2] = H005_B(0x2A3E + (j - 1) * 4);
+                }
