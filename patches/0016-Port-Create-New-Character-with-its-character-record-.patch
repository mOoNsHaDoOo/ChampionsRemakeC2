@@ -60,6 +60,8 @@ typedef int32_t  s32;
 #define COK_GET32(p)  ((u32)COK_GET16(p) << 16 | COK_GET16((const u8 *)(p) + 2))
 #define COK_PUT16(p, v) do { ((u8 *)(p))[0] = (u8)((u16)(v) >> 8); \
                              ((u8 *)(p))[1] = (u8)(v); } while (0)
+#define COK_PUT32(p, v) do { COK_PUT16((p), (u32)(v) >> 16); \
+                             COK_PUT16((u8 *)(p) + 2, (v)); } while (0)
 
