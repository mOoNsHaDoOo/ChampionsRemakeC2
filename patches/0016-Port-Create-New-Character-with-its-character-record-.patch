+/* Copia con dbeq: al massimo max + 1 byte, NUL compreso. */
+static void copy_text(char *dst, const char *src, u16 max)
+{
+    u16 i;
+
+    for (i = 0; i <= max; ++i) {
+        dst[i] = src[i];
+        if (src[i] == 0) {
+            break;
+        }
+    }
+}
