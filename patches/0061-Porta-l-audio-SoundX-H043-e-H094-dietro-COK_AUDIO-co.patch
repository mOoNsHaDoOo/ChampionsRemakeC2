diff --git a/src_c/readable/host/ndk.h b/src_c/readable/host/ndk.h
index 36daed8..a3a5139 100644
--- a/src_c/readable/host/ndk.h
+++ b/src_c/readable/host/ndk.h
@@ -47,14 +47,78 @@ struct Library {
     UWORD lib_Version;
 };
 
+struct Node {
+    struct Node *ln_Succ;
+    struct Node *ln_Pred;
+    UBYTE ln_Type;
+    BYTE ln_Pri;
+    char *ln_Name;
+};
+
+struct List {
+    struct Node *lh_Head;
+    struct Node *lh_Tail;
+    struct Node *lh_TailPred;
+    UBYTE lh_Type;
+    UBYTE l_pad;
+};
+
 struct Message {
