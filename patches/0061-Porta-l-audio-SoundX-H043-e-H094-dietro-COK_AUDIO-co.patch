     host_display_refresh(0);
     if (s_count == 0) {
@@ -189,7 +198,14 @@ struct Message *GetMsg(struct MsgPort *port)
 
 void ReplyMsg(struct Message *msg)
 {
+#ifdef COK_AUDIO
+    if (msg != NULL && msg->mn_ReplyPort != NULL &&
+        msg->mn_ReplyPort != &s_port) {
+        host_port_put(msg->mn_ReplyPort, msg);
+    }
+#else
     (void)msg;
+#endif
 }
 
