diff --git a/src_c/readable/h030.c b/src_c/readable/h030.c
index 6bcd80d..7661dfb 100644
--- a/src_c/readable/h030.c
+++ b/src_c/readable/h030.c
@@ -3,6 +3,7 @@
 #include "h003_exec.h"
 #include "h028_files.h"
 #include "h040.h"
+#include "h038.h"
 #include "h049.h"
 #include "globals.h"
 
@@ -11,6 +12,34 @@ void h030_init(void)
 {
 }
 
+/*
+ * PORT H030+$019A: riempie con pen width celle di testo (8x8) dalla
+ * colonna col della riga row (griglia 40x25), tagliando a destra alla
+ * colonna 40.  Fuori griglia o con width 0 non fa nulla.  I controlli
+ * "col < 0" e "row < 0" dell'originale (tst.w / bcc) non scattano mai.
+ */
+void fill_text_cells(u16 col, u16 row, u16 pen, u16 width)
+{
+    if (col > 0x27 || row > 0x18 || width < 1) {
+        return;
+    }
+    if ((u16)(col + width) > 0x28) {
+        width = (u16)(0x28 - col);
+    }
+    graphics_set_apen(g_rastport, pen);
+    graphics_set_open(g_rastport, pen);
+    graphics_rect_fill(g_rastport, (u16)(col << 3), (u16)(row << 3),
+                       (u16)(((u16)(col + width) << 3) - 1),
+                       (u16)((row << 3) + 7));
+}
+
+/* PORT H030+$0256 (UI_DrawText): testo nella griglia 40x25 (H049+$0224). */
+void ui_draw_text(u16 col, u16 row, u16 fg, u16 bg, u16 len,
+                  const char *text)
+{
+    draw_text_blitter(col, row, fg, bg, len, text);
+}
+
 /* Dati del modulo (sotto a4). */
 struct BitMap g_gothic_bitmap;          /* -$2C: font "gothic.lbm" */
 u32 g_h030_alloc_size;                  /* -$4: ultima allocazione */
