diff --git a/src_c/readable/windows/get-sdl2-nuget.cmd b/src_c/readable/windows/get-sdl2-nuget.cmd
new file mode 100644
index 0000000..21a4ce7
--- /dev/null
+++ b/src_c/readable/windows/get-sdl2-nuget.cmd
@@ -0,0 +1,4 @@
+@echo off
+rem Scarica SDL2 da nuget.org in third_party\sdl2-nuget (vedi get-sdl2-nuget.ps1).
+powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0get-sdl2-nuget.ps1" %*
