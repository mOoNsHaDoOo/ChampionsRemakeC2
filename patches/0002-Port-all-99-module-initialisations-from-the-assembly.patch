+++ b/src_c/readable/h044_tiles.c
@@ -0,0 +1,96 @@
+/* H044: disegno di elementi 8x8 (glifi o tile) e servizi grafici/UI. */
+#include "cok.h"
+
+/*
+ * Dati del modulo: $B6 byte sotto a4 (da -$B6 a -$1).  H044_M(off) e' il
+ * byte -off(a4); le tabelle sono indici di tile 8x8 (0..5) per le cornici.
+ */
+u8 g_h044_bss[0xB6];
+#define H044_M(off) g_h044_bss[0xB6 - (off)]
+
+/* count byte a value dal byte -at(a4) in su (indirizzi crescenti). */
+static void fill(unsigned at, unsigned count, u8 value)
+{
+    memset(&H044_M(at), value, count);
+}
+
+/* PORT H044+$00BA */
+void h044_init(void)
+{
+    /* -$2A: 40 byte azzerati (riga superiore della cornice). */
+    fill(0x2A, 40, 0);
+    H044_M(0x23) = 1;
+    H044_M(0x21) = 2;
+    H044_M(0x18) = 1;
+    H044_M(0x16) = 2;
+    H044_M(0x0D) = 1;
+    H044_M(0x0B) = 2;
+
+    /* -$42: 24 byte a 4 (bordi laterali). */
+    fill(0x42, 24, 4);
+    H044_M(0x42) = 0;
+    H044_M(0x41) = 3;
+    H044_M(0x33) = 5;
+    H044_M(0x32) = 0;
+    H044_M(0x31) = 3;
+    H044_M(0x2C) = 5;
+    H044_M(0x2B) = 0;
+
+    /* -$54: 17 byte a 4. */
+    fill(0x54, 17, 4);
+    H044_M(0x54) = 0;
+    H044_M(0x53) = 3;
+    H044_M(0x45) = 5;
+    H044_M(0x44) = 0;
+
+    /* -$6C: 24 byte a 4. */
+    fill(0x6C, 24, 4);
+    H044_M(0x6C) = 0;
+    H044_M(0x6B) = 3;
+    H044_M(0x5D) = 5;
+    H044_M(0x5C) = 0;
+    H044_M(0x5B) = 3;
+    H044_M(0x56) = 5;
+    H044_M(0x55) = 0;
+
+    /* -$7A: indici 2..14 a 4. */
+    fill(0x7A, 13, 4);
+    H044_M(0x7A) = 0;
+    H044_M(0x79) = 3;
+    H044_M(0x6F) = 5;
+    H044_M(0x6E) = 0;
+
+    /* -$92: 23 byte a 4. */
+    fill(0x92, 23, 4);
+    H044_M(0x92) = 0;
+    H044_M(0x91) = 3;
+    H044_M(0x7D) = 5;
+    H044_M(0x7C) = 0;
+
+    /* -$AA: 23 byte a 4. */
+    fill(0xAA, 23, 4);
+    H044_M(0xAA) = 0;
+    H044_M(0xA9) = 3;
+    H044_M(0xA3) = 5;
+    H044_M(0xA2) = 0;
+    H044_M(0xA1) = 3;
+    H044_M(0x9B) = 5;
+    H044_M(0x9A) = 0;
+    H044_M(0x99) = 3;
+    H044_M(0x97) = 5;
+    H044_M(0x96) = 0;
+    H044_M(0x95) = 3;
+    H044_M(0x94) = 5;
+
+    /* -$B6: indici 9..19 a 4. */
+    fill(0xB6, 11, 4);
+    H044_M(0xB6) = 3;
+    H044_M(0xB0) = 5;
+    H044_M(0xAF) = 0;
+    H044_M(0xAE) = 3;
