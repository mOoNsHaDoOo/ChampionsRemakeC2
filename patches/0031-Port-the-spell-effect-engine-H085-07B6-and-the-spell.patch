+        break;
+    case 0x10:
+        h026_append(0x50, text, 9, "from Acid");
+        break;
+    default:
+        break;
+    }
+    if (mask_byte(H005_B(0x2473), 8) == H005_B(0x2473)) {
+        h026_append(0x50, text, 0x0A, "from Magic");
+    }
+    show_effect_message(c, 0, 0x50, text);
+    damage_hit_points(c, H005_B(0x2474));
+    if (H005_B(0x3DE3) == 5) {
+        turn = (u8 *)c->block_192;
