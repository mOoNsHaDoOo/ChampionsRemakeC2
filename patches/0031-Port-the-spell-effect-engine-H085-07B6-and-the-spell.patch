+    H005_B(0x24A9) = 1;
+    for (i = 1; i <= H005_B(0x246C); ++i) {
+        if (g_spell_targets[i - 1]->b[0x199] != side) {
+            g_spell_targets[i - 1] = NULL;
+        } else if ((SPELL_NOW == 1 || SPELL_NOW == 0x69) &&
+                   H005_B(0x3DE3) == 5 &&
+                   h063_2bde(g_spell_targets[i - 1], 1) > 0) {
+            g_spell_targets[i - 1] = NULL;
