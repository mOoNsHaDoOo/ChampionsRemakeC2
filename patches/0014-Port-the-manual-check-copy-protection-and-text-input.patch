index 9af2f19..2c2a1c3 100644
--- a/src_c/readable/h009.c
+++ b/src_c/readable/h009.c
@@ -1,7 +1,96 @@
 /* H009: Verifica preliminare della distribuzione fornita; non modificata. */
-#include "cok.h"
+#include "h009.h"
+#include "h023_shared.h"
+#include "h026_string.h"
