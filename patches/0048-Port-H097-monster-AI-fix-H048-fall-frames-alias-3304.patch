+    key = G_KEY;
+    handled = 1;
+    switch (key) {
+    case '2':
+        H005_B(0x24A0) = (u8)(H005_B(0x24A0) == 0);
+        if (H005_B(0x24A0)) {
+            show_message_line(8, "Magic On");
+        } else {
+            show_message_line(9, "Magic Off");
+        }
+        break;
+    case ' ':
+        for (p = g_party_head; p != NULL; p = p->next) {
+            if (p->b[0xEC] < 0x80 && p->b[0x197] != 1) {
+                p->b[0x19A] = 0;
+            }
