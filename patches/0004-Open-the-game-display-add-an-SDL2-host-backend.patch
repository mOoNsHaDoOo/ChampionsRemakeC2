diff --git a/src_c/readable/host/display.c b/src_c/readable/host/display.c
new file mode 100644
index 0000000..b64bd98
--- /dev/null
+++ b/src_c/readable/host/display.c
@@ -0,0 +1,213 @@
+/*
+ * Build host: visualizzazione dello schermo Amiga con SDL2.
+ *
+ * Si mostra la BitMap planare dello schermo aperto con OpenScreen oppure,
+ * dopo LoadView di una View del gioco, quella del suo ViewPort (RasInfo):
+ * i pixel sono convertiti in RGB con la ColorMap (RGB4) e mostrati in una
+ * finestra SDL ingrandita.
+ *
+ * Variabili d'ambiente:
+ *   COK_SCALE=n          ingrandimento della finestra (predefinito 3);
+ *   COK_SCREENSHOT=f.bmp all'uscita salva l'ultimo fotogramma in f.bmp;
+ *   SDL_VIDEODRIVER=dummy  esecuzione senza finestra (test).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <SDL.h>
+#include "ndk.h"
+
+static struct Screen *s_screen;
+static struct View *s_view;             /* View caricata con LoadView */
+static SDL_Window *s_window;
+static SDL_Renderer *s_renderer;
+static SDL_Texture *s_texture;
+static Uint32 *s_pixels;
+static int s_tex_w;
+static int s_tex_h;
+static int s_dirty;
+static Uint32 s_last_present;
+static int s_sdl_ready;
+
+/* ViewPort mostrato: quello della View caricata o quello dello schermo. */
+static struct ViewPort *shown_viewport(void)
+{
+    if (s_view != NULL && s_view->ViewPort != NULL) {
+        return s_view->ViewPort;
+    }
+    return s_screen != NULL ? &s_screen->ViewPort : NULL;
+}
+
+/* Converte la bitmap planare mostrata in s_pixels (ARGB8888). */
+static void convert(void)
+{
+    const struct ViewPort *vp = shown_viewport();
+    const struct BitMap *bm;
+    Uint32 palette[256];
+    int x;
+    int y;
+    int i;
+
+    if (vp == NULL || vp->RasInfo == NULL || vp->RasInfo->BitMap == NULL ||
+        s_pixels == NULL) {
+        return;
+    }
+    bm = vp->RasInfo->BitMap;
+    for (i = 0; i < 256; ++i) {
+        UWORD c = 0;
+
+        if (vp->ColorMap != NULL && vp->ColorMap->Count > 0) {
+            c = vp->ColorMap->ColorTable[i % vp->ColorMap->Count];
+        }
+        palette[i] = 0xFF000000u | (Uint32)((c >> 8) & 15) * 0x110000u |
+                     (Uint32)((c >> 4) & 15) * 0x001100u |
+                     (Uint32)(c & 15) * 0x000011u;
+    }
+    for (y = 0; y < s_tex_h && y < bm->Rows; ++y) {
+        for (x = 0; x < s_tex_w && x < bm->BytesPerRow * 8; ++x) {
+            size_t at = (size_t)y * bm->BytesPerRow + (size_t)(x >> 3);
+            UBYTE mask = (UBYTE)(0x80 >> (x & 7));
+            unsigned pen = 0;
+
+            for (i = 0; i < bm->Depth; ++i) {
+                if (bm->Planes[i] != NULL && (bm->Planes[i][at] & mask)) {
+                    pen |= 1u << i;
+                }
+            }
+            s_pixels[(size_t)y * s_tex_w + x] = palette[pen];
+        }
+    }
+}
+
+static void save_screenshot(void)
+{
+    const char *path = getenv("COK_SCREENSHOT");
+    SDL_Surface *surface;
+
+    if (path == NULL || s_pixels == NULL) {
+        return;
+    }
+    surface = SDL_CreateRGBSurfaceFrom(s_pixels, s_tex_w, s_tex_h, 32,
+                                       s_tex_w * 4, 0x00FF0000, 0x0000FF00,
+                                       0x000000FF, 0xFF000000);
+    if (surface != NULL) {
+        if (SDL_SaveBMP(surface, path) != 0) {
+            fprintf(stderr, "COK_SCREENSHOT: %s\n", SDL_GetError());
+        }
+        SDL_FreeSurface(surface);
+    }
+}
+
+static void at_exit(void)
+{
+    convert();
+    save_screenshot();
+    if (s_sdl_ready) {
+        SDL_Quit();
+    }
+}
+
+static int open_sdl(int w, int h)
+{
+    const char *env = getenv("COK_SCALE");
+    int scale = env != NULL ? atoi(env) : 3;
+
+    if (scale < 1) {
+        scale = 1;
+    }
+    if (!s_sdl_ready) {
+        if (SDL_Init(SDL_INIT_VIDEO) != 0) {
+            fprintf(stderr, "SDL_Init: %s\n", SDL_GetError());
+            return 0;
+        }
+        s_sdl_ready = 1;
+        atexit(at_exit);
+    }
+    if (s_window == NULL) {
+        s_window = SDL_CreateWindow("Champions of Krynn",
+                                    SDL_WINDOWPOS_CENTERED,
+                                    SDL_WINDOWPOS_CENTERED,
+                                    w * scale, h * scale, 0);
+        if (s_window == NULL) {
+            fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError());
+            return 0;
+        }
+        s_renderer = SDL_CreateRenderer(s_window, -1, 0);
+        if (s_renderer == NULL) {
+            s_renderer = SDL_CreateRenderer(s_window, -1,
+                                            SDL_RENDERER_SOFTWARE);
+        }
+    }
+    if (s_texture != NULL && (s_tex_w != w || s_tex_h != h)) {
+        SDL_DestroyTexture(s_texture);
+        s_texture = NULL;
+    }
+    if (s_texture == NULL && s_renderer != NULL) {
+        s_texture = SDL_CreateTexture(s_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                      SDL_TEXTUREACCESS_STREAMING, w, h);
+        SDL_RenderSetLogicalSize(s_renderer, w, h);
+    }
+    free(s_pixels);
+    s_pixels = (Uint32 *)calloc((size_t)w * h, sizeof(Uint32));
+    s_tex_w = w;
+    s_tex_h = h;
+    return s_pixels != NULL;
+}
+
+void host_display_attach(struct Screen *screen)
+{
+    if (open_sdl(screen->Width, screen->Height)) {
+        s_screen = screen;
+        s_dirty = 1;
+        host_display_refresh(1);
+    }
+}
+
+void host_display_detach(struct Screen *screen)
+{
+    if (s_screen == screen) {
+        convert();              /* l'ultimo fotogramma resta per lo screenshot */
+        s_screen = NULL;
+    }
+}
+
+void host_display_view(struct View *view)
+{
+    s_view = view;
+    s_dirty = 1;
+}
+
+void host_display_changed(void)
+{
+    s_dirty = 1;
+}
+
+/*
+ * Mostra lo schermo (al massimo ~60 volte al secondo, oppure subito con
+ * force) e smaltisce gli eventi della finestra.
+ */
+void host_display_refresh(int force)
+{
+    SDL_Event ev;
+    Uint32 now;
+
+    if (!s_sdl_ready) {
+        return;
+    }
+    while (SDL_PollEvent(&ev)) {
+        if (ev.type == SDL_QUIT) {
+            exit(0);
+        }
+    }
+    now = SDL_GetTicks();
+    if (shown_viewport() == NULL || s_texture == NULL ||
+        (!force && (!s_dirty || now - s_last_present < 16))) {
+        return;
+    }
+    convert();
+    SDL_UpdateTexture(s_texture, NULL, s_pixels, s_tex_w * 4);
+    SDL_RenderClear(s_renderer);
+    SDL_RenderCopy(s_renderer, s_texture, NULL, NULL);
+    SDL_RenderPresent(s_renderer);
+    s_last_present = now;
+    s_dirty = 0;
+}
diff --git a/src_c/readable/host/graphics.c b/src_c/readable/host/graphics.c
new file mode 100644
index 0000000..ff330ac
--- /dev/null
+++ b/src_c/readable/host/graphics.c
@@ -0,0 +1,125 @@
+/* Build host: graphics.library emulata (solo quanto usa il port). */
+#include <stdlib.h>
+#include <string.h>
+#include "ndk.h"
+
+/*
+ * I colori arrivano dai dati del gioco (H005), quindi sono word
+ * big-endian: si leggono a byte.
+ */
+void LoadRGB4(struct ViewPort *vp, const UWORD *colors, LONG count)
+{
+    const UBYTE *p = (const UBYTE *)colors;
+    LONG i;
+
+    if (vp->ColorMap == NULL) {
+        return;
+    }
+    for (i = 0; i < count && i < vp->ColorMap->Count; ++i) {
+        vp->ColorMap->ColorTable[i] =
+            (UWORD)((p[i * 2] << 8 | p[i * 2 + 1]) & 0x0FFF);
+    }
+    host_display_changed();
+}
+
+void InitBitMap(struct BitMap *bm, LONG depth, LONG width, LONG height)
+{
+    bm->BytesPerRow = (UWORD)(((width + 15) >> 3) & 0xFFFE);
+    bm->Rows = (UWORD)height;
+    bm->Flags = 0;
+    bm->Depth = (UBYTE)depth;
+    bm->pad = 0;
+}
+
+/* Memoria chip: sull'host memoria normale, non azzerata come sull'Amiga. */
+PLANEPTR AllocRaster(ULONG width, ULONG height)
+{
+    return (PLANEPTR)malloc(RASSIZE(width, height));
+}
+
+void FreeRaster(PLANEPTR p, ULONG width, ULONG height)
+{
+    (void)width;
+    (void)height;
+    free(p);
+}
+
+/*
+ * flags bit 1 = 0: count e' un numero di byte; bit 1 = 1: count e'
+ * righe << 16 | byte per riga.  Il bit 0 (attesa del blitter) non conta.
+ */
+void BltClear(void *memory, ULONG count, ULONG flags)
+{
+    if (flags & 2) {
+        count = (count >> 16) * (count & 0xFFFF);
+    }
+    memset(memory, 0, count);
+    host_display_changed();
+}
+
+static struct GfxBase s_gfx = { { "graphics.library", 34 }, NULL };
+
+struct Library *host_graphics_base(void)
+{
+    return &s_gfx.LibNode;
+}
+
+void InitView(struct View *view)
+{
+    memset(view, 0, sizeof(*view));
+}
+
+void InitVPort(struct ViewPort *vp)
+{
+    memset(vp, 0, sizeof(*vp));
+}
+
+struct ColorMap *GetColorMap(LONG entries)
+{
+    struct ColorMap *cm = (struct ColorMap *)calloc(1, sizeof(*cm));
+
+    if (cm == NULL) {
+        return NULL;
+    }
+    cm->Count = (UWORD)entries;
+    cm->ColorTable = (UWORD *)calloc((size_t)entries, sizeof(UWORD));
+    if (cm->ColorTable == NULL) {
+        free(cm);
+        return NULL;
+    }
+    return cm;
+}
+
+void FreeColorMap(struct ColorMap *cm)
+{
+    if (cm != NULL) {
+        free(cm->ColorTable);
+        free(cm);
+    }
+}
+
+/* Le liste Copper non esistono sull'host: MakeVPort e MrgCop non fanno nulla. */
+void MakeVPort(struct View *view, struct ViewPort *vp)
+{
+    (void)view;
+    (void)vp;
+}
+
+void MrgCop(struct View *view)
+{
+    (void)view;
+}
+
+void LoadView(struct View *view)
+{
+    s_gfx.ActiView = view;
+    host_display_view(view);
+}
+
+void InitRastPort(struct RastPort *rp)
+{
+    memset(rp, 0, sizeof(*rp));
+    rp->FgPen = -1;             /* come InitRastPort di AmigaOS: FgPen e */
+    rp->AOlPen = -1;            /* AOlPen a -1, DrawMode JAM2 */
+    rp->DrawMode = 1;
+}
diff --git a/src_c/readable/host/intuition.c b/src_c/readable/host/intuition.c
new file mode 100644
index 0000000..e418ae5
--- /dev/null
+++ b/src_c/readable/host/intuition.c
@@ -0,0 +1,165 @@
+/*
+ * Build host: intuition.library ed exec emulati (solo quanto usa il port).
+ * Lo schermo e' una BitMap planare in memoria, mostrata da host/display.c.
+ */
+#include <stdlib.h>
+#include <string.h>
+#include "ndk.h"
+
+struct Library *host_graphics_base(void);
+
+static struct Library s_intuition = { "intuition.library", 34 };
+static struct Library s_dos = { "dos.library", 34 };
+static struct Library s_exec = { "exec.library", 34 };
+
+struct Library *OpenLibrary(STRPTR name, ULONG version)
+{
+    const char *n = (const char *)name;
+
+    (void)version;
+    if (strcmp(n, "graphics.library") == 0) {
+        return host_graphics_base();
+    }
+    if (strcmp(n, "intuition.library") == 0) {
+        return &s_intuition;
+    }
+    if (strcmp(n, "dos.library") == 0) {
+        return &s_dos;
+    }
+    if (strcmp(n, "exec.library") == 0) {
+        return &s_exec;
+    }
+    return NULL;
+}
+
+void CloseLibrary(struct Library *library)
+{
+    (void)library;
+}
+
+/*
+ * Preferences: sull'host non ci sono preferenze di sistema; gli
+ * spostamenti del display (usati solo per la View personalizzata) sono 0.
+ */
+struct Preferences *GetPrefs(struct Preferences *prefs, LONG size)
+{
+    (void)size;
+    memset(prefs, 0, sizeof(*prefs));
+    return prefs;
+}
+
+static struct Process s_process = { { "Champions of Krynn" }, NULL };
+
+struct Task *FindTask(STRPTR name)
+{
+    (void)name;                 /* il gioco chiede solo il proprio task */
+    return &s_process.pr_Task;
+}
+
+struct Screen *OpenScreen(struct NewScreen *ns)
+{
+    struct Screen *s = (struct Screen *)calloc(1, sizeof(*s));
+    UWORD bpr;
+    int i;
+
+    if (s == NULL) {
+        return NULL;
+    }
+    s->LeftEdge = ns->LeftEdge;
+    s->TopEdge = ns->TopEdge;
+    s->Width = ns->Width;
+    s->Height = ns->Height;
+    s->Title = ns->DefaultTitle;
+    s->ViewPort.DWidth = ns->Width;
+    s->ViewPort.DHeight = ns->Height;
+    s->ViewPort.Modes = ns->ViewModes;
+    s->ViewPort.ColorMap = GetColorMap(32);
+    s->ViewPort.RasInfo = &s->RasInfo;
+    s->RasInfo.BitMap = &s->BitMap;
+
+    bpr = (UWORD)(((ns->Width + 15) / 16) * 2);
+    s->BitMap.BytesPerRow = bpr;
+    s->BitMap.Rows = (UWORD)ns->Height;
+    s->BitMap.Depth = (UBYTE)ns->Depth;
+    for (i = 0; i < ns->Depth && i < 8; ++i) {
+        s->BitMap.Planes[i] = (PLANEPTR)calloc(1, (size_t)bpr * ns->Height);
+        if (s->BitMap.Planes[i] == NULL) {
+            CloseScreen(s);
+            return NULL;
+        }
+    }
+    s->RastPort.BitMap = &s->BitMap;
+    s->RastPort.FgPen = (BYTE)ns->DetailPen;
+    s->RastPort.BgPen = (BYTE)ns->BlockPen;
+    s->ShowTitle = TRUE;
+    host_display_attach(s);
+    return s;
+}
+
+void CloseScreen(struct Screen *screen)
+{
+    int i;
+
+    if (screen == NULL) {
+        return;
+    }
+    host_display_detach(screen);
+    for (i = 0; i < 8; ++i) {
+        free(screen->BitMap.Planes[i]);
+    }
+    FreeColorMap(screen->ViewPort.ColorMap);
+    free(screen);
+}
+
+struct Window *OpenWindow(struct NewWindow *nw)
+{
+    struct Window *w;
+
+    if (nw->Screen == NULL) {
+        return NULL;            /* nessun Workbench sull'host */
+    }
+    w = (struct Window *)calloc(1, sizeof(*w));
+    if (w == NULL) {
+        return NULL;
+    }
+    w->LeftEdge = nw->LeftEdge;
+    w->TopEdge = nw->TopEdge;
+    w->Width = nw->Width;
+    w->Height = nw->Height;
+    w->IDCMPFlags = nw->IDCMPFlags;
+    w->Flags = nw->Flags;
+    w->WScreen = nw->Screen;
+    /* Finestra BACKDROP|BORDERLESS a schermo intero: disegna sullo schermo. */
+    w->RPort = &nw->Screen->RastPort;
+    return w;
+}
+
+void CloseWindow(struct Window *window)
+{
+    free(window);
+}
+
+void ShowTitle(struct Screen *screen, LONG show)
+{
+    screen->ShowTitle = (BOOL)(show != 0);
+}
+
+LONG CloseWorkBench(void)
+{
+    return TRUE;                /* nessun Workbench da chiudere */
+}
+
+ULONG OpenWorkBench(void)
+{
+    return 0;                   /* nessun Workbench: schermo nullo */
+}
+
+void ActivateWindow(struct Window *window)
+{
+    (void)window;
+}
+
+void ClearPointer(struct Window *window)
+{
+    (void)window;
+}
diff --git a/src_c/readable/host/ndk.h b/src_c/readable/host/ndk.h
new file mode 100644
index 0000000..bf5b2e7
--- /dev/null
+++ b/src_c/readable/host/ndk.h
@@ -0,0 +1,211 @@
+/*
+ * Build host: sottoinsieme dell'NDK di AmigaOS usato dal port.
+ *
+ * Le strutture hanno gli stessi nomi di campo dell'NDK, cosi' il codice
+ * del gioco e' lo stesso sui due target; contengono solo i campi che il
+ * port usa (non hanno la disposizione in memoria dell'originale).  Le
+ * funzioni di libreria omonime sono emulate nei file .c di host/, sopra SDL2.
+ *
+ * Convenzione: la memoria che arriva dai dati del gioco (H005, file) e'
+ * nell'ordine dei byte dell'Amiga; le funzioni emulate che leggono word da
+ * quella memoria (per esempio LoadRGB4) le leggono big-endian.
+ */
+#ifndef COK_HOST_NDK_H
+#define COK_HOST_NDK_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+typedef void          *APTR;
+typedef int32_t        LONG;
+typedef uint32_t       ULONG;
+typedef int16_t        WORD;
+typedef uint16_t       UWORD;
+typedef int8_t         BYTE;
+typedef uint8_t        UBYTE;
+typedef int16_t        BOOL;
+typedef unsigned char *STRPTR;
+typedef unsigned char *PLANEPTR;
+
+#ifndef TRUE
+#define TRUE  1
+#define FALSE 0
+#endif
+
+/* exec */
+struct Task {
+    const char *tc_Name;
+};
+
+struct Process {
+    struct Task pr_Task;
+    APTR pr_WindowPtr;          /* finestra delle richieste di sistema */
+};
+
+struct Library {
+    const char *lib_Name;
+    UWORD lib_Version;
+};
+
+struct Task    *FindTask(STRPTR name);
+struct Library *OpenLibrary(STRPTR name, ULONG version);
+void            CloseLibrary(struct Library *library);
+
+/* graphics */
+struct BitMap {
+    UWORD BytesPerRow;
+    UWORD Rows;
+    UBYTE Flags;
+    UBYTE Depth;
+    UWORD pad;
+    PLANEPTR Planes[8];
+};
+
+struct TextFont;
+
+struct RastPort {
+    struct BitMap *BitMap;
+    struct TextFont *Font;
+    BYTE FgPen;
+    BYTE BgPen;
+    BYTE AOlPen;
+    BYTE DrawMode;
+    WORD cp_x;
+    WORD cp_y;
+};
+
+struct ColorMap {
+    UBYTE Flags;
+    UBYTE Type;
+    UWORD Count;
+    UWORD *ColorTable;          /* Count colori RGB4 */
+};
+
+struct RasInfo {
+    struct RasInfo *Next;
+    struct BitMap *BitMap;
+    WORD RxOffset;
+    WORD RyOffset;
+};
+
+struct ViewPort {
+    struct ViewPort *Next;
+    struct ColorMap *ColorMap;
+    WORD DWidth;
+    WORD DHeight;
+    WORD DxOffset;
+    WORD DyOffset;
+    UWORD Modes;
+    struct RasInfo *RasInfo;
+};
+
+struct View {
+    struct ViewPort *ViewPort;
+    WORD DyOffset;
+    WORD DxOffset;
+    UWORD Modes;
+};
+
+struct GfxBase {
+    struct Library LibNode;
+    struct View *ActiView;      /* View mostrata (NULL: schermo Intuition) */
+};
+
+#define RASSIZE(w, h) ((ULONG)(h) * ((((ULONG)(w) + 15) >> 3) & 0xFFFE))
+
+void     LoadRGB4(struct ViewPort *vp, const UWORD *colors, LONG count);
+void     InitView(struct View *view);
+void     InitVPort(struct ViewPort *vp);
+struct ColorMap *GetColorMap(LONG entries);
+void     FreeColorMap(struct ColorMap *cm);
+void     MakeVPort(struct View *view, struct ViewPort *vp);
+void     MrgCop(struct View *view);
+void     LoadView(struct View *view);
+void     InitRastPort(struct RastPort *rp);
+void     InitBitMap(struct BitMap *bm, LONG depth, LONG width, LONG height);
+PLANEPTR AllocRaster(ULONG width, ULONG height);
+void     FreeRaster(PLANEPTR p, ULONG width, ULONG height);
+void     BltClear(void *memory, ULONG count, ULONG flags);
+
+/* intuition */
+struct TextAttr;
+struct Gadget;
+struct Image;
+
+#define CUSTOMSCREEN  0x000F
+#define WBENCHSCREEN  0x0001
+#define HIRES         0x8000
+#define LACE          0x0004
+#define HAM           0x0800
+
+struct NewScreen {
+    WORD LeftEdge, TopEdge, Width, Height, Depth;
+    UBYTE DetailPen, BlockPen;
+    UWORD ViewModes;
+    UWORD Type;
+    struct TextAttr *Font;
+    UBYTE *DefaultTitle;
+    struct Gadget *Gadgets;
+    struct BitMap *CustomBitMap;
+};
+
+struct Screen {
+    WORD LeftEdge, TopEdge, Width, Height;
+    UBYTE *Title;
+    struct ViewPort ViewPort;
+    struct RastPort RastPort;
+    struct BitMap BitMap;
+    struct RasInfo RasInfo;     /* (host) RasInfo del ViewPort */
+    BOOL ShowTitle;
+};
+
+struct NewWindow {
+    WORD LeftEdge, TopEdge, Width, Height;
+    UBYTE DetailPen, BlockPen;
+    ULONG IDCMPFlags;
+    ULONG Flags;
+    struct Gadget *FirstGadget;
+    struct Image *CheckMark;
+    UBYTE *Title;
+    struct Screen *Screen;
+    struct BitMap *BitMap;
+    WORD MinWidth, MinHeight;
+    UWORD MaxWidth, MaxHeight;
+    UWORD Type;
+};
+
+struct Window {
+    WORD LeftEdge, TopEdge, Width, Height;
+    ULONG IDCMPFlags;
+    ULONG Flags;
+    struct RastPort *RPort;
+    struct Screen *WScreen;
+};
+
+/* Solo i campi di Preferences letti dal gioco. */
+struct Preferences {
+    BYTE ViewXOffset;
+    BYTE ViewYOffset;
+    WORD ViewInitX;
+    WORD ViewInitY;
+};
+
+struct Preferences *GetPrefs(struct Preferences *prefs, LONG size);
+struct Screen *OpenScreen(struct NewScreen *ns);
+void           CloseScreen(struct Screen *screen);
+struct Window *OpenWindow(struct NewWindow *nw);
+void           CloseWindow(struct Window *window);
+void           ShowTitle(struct Screen *screen, LONG show);
+LONG           CloseWorkBench(void);
+ULONG          OpenWorkBench(void);
+void           ActivateWindow(struct Window *window);
+void           ClearPointer(struct Window *window);
+
+/* Display SDL2 (host/display.c). */
+void host_display_attach(struct Screen *screen);   /* schermo visibile */
+void host_display_detach(struct Screen *screen);
+void host_display_changed(void);   /* bitmap o colori modificati */
+void host_display_view(struct View *view);   /* LoadView */
+void host_display_refresh(int force);
+
+#endif
