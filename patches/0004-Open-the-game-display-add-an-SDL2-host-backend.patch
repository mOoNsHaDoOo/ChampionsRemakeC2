+    u16 plane_bytes;            /* +$0A: byte dei 5 piani (word) */
+    struct BitMap *mask;        /* +$0C: maschera, un piano ripetuto 5 volte */
+    struct BitMap *image;       /* +$10: immagine a 5 piani */
+};
