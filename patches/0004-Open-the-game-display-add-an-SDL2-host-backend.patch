diff --git a/src_c/readable/Makefile b/src_c/readable/Makefile
index cc03ace..1084110 100644
--- a/src_c/readable/Makefile
+++ b/src_c/readable/Makefile
@@ -1,15 +1,17 @@
 # Champions of Krynn - port asm -> C, build host.
 #
-#   make          compila build/cok
+#   make          compila build/cok (richiede SDL2: libsdl2-dev, brew sdl2, ...)
 #   make status   aggiorna PORT_STATUS.md
 #   make clean    rimuove build/
 
 CC        ?= cc
 CFLAGS    ?= -std=c99 -O2 -Wall -Wextra -pedantic
+SDL_CFLAGS := $(shell pkg-config --cflags sdl2 2>/dev/null || sdl2-config --cflags)
+SDL_LIBS   := $(shell pkg-config --libs sdl2 2>/dev/null || sdl2-config --libs)
 BUILD_DIR ?= build
 TARGET    := $(BUILD_DIR)/cok
 
-SRCS := $(wildcard *.c)
+SRCS := $(wildcard *.c) $(wildcard host/*.c)
 OBJS := $(SRCS:%.c=$(BUILD_DIR)/%.o)
 
 .PHONY: all status clean
@@ -17,12 +19,12 @@ OBJS := $(SRCS:%.c=$(BUILD_DIR)/%.o)
 all: $(TARGET)
 
 $(TARGET): $(OBJS)
-	$(CC) $(OBJS) -o $@
+	$(CC) $(OBJS) $(SDL_LIBS) -o $@
 
-$(BUILD_DIR)/%.o: %.c $(wildcard *.h) | $(BUILD_DIR)
-	$(CC) $(CFLAGS) -c $< -o $@
+$(BUILD_DIR)/%.o: %.c $(wildcard *.h) $(wildcard host/*.h) | $(BUILD_DIR)/host
+	$(CC) $(CFLAGS) $(SDL_CFLAGS) -c $< -o $@
 
-$(BUILD_DIR):
+$(BUILD_DIR)/host:
 	mkdir -p $@
 
