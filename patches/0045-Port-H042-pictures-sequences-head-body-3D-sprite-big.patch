--- a/src_c/readable/h042_seq.c
+++ b/src_c/readable/h042_seq.c
@@ -3,6 +3,21 @@
 #include "h003_exec.h"
 #include "h029_gfx.h"
 #include "globals.h"
+#include <string.h>
