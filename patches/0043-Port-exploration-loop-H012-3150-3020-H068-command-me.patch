+    s16 y = POS_Y;                      /* -$4(a5) */
+    u16 dir = POS_DIR;                  /* -$6(a5) */
+
+    COK_PUT16(g_state_b + 0x5AA, 0);
+    if (map_door(x, y, dir) == 0) {
+        return;
+    }
+    x = (s16)(x + DX(dir));
+    y = (s16)(y + DY(dir));
+    if (x > 0x0F) {
+        H005_SET_W(0x281C, 0x0F);
+        COK_PUT16(g_state_b + 0x5AA, 1);
+    }
+    if (x < 0) {
+        H005_SET_W(0x281C, 0);
+        COK_PUT16(g_state_b + 0x5AA, 1);
+    }
+    if (y > 0x0F) {
+        H005_SET_W(0x281E, 0x0F);
+        COK_PUT16(g_state_b + 0x5AA, 1);
+    }
+    if (y < 0) {
+        H005_SET_W(0x281E, 0);
+        COK_PUT16(g_state_b + 0x5AA, 1);
+    }
+}
