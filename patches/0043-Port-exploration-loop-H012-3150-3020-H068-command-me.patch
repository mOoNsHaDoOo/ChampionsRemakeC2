+static u8 party_has_class(u8 cls)
+{
+    u8 found = 0;                       /* -$5(a5) */
+    Character *p;                       /* -$4(a5) */
+
+    for (p = g_party_head; p != NULL && !found; p = p->next) {
+        if (p->b[0xFE + cls] > 0) {
+            found = 1;
+        } else if (p->b[0x106 + cls] > 0 && h073_130a(p)) {
+            found = 1;
+        }
+    }
+    return found;
+}
