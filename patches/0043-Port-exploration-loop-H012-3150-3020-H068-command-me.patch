+    Character *p;                       /* -$4(a5) */
+
+    for (p = g_party_head; p != NULL && !ok; p = p->next) {
+        if (roll_dice(1, 0x64) <= p->b[0xE1] && !p->b[0x197]) {
+            ok = 1;
