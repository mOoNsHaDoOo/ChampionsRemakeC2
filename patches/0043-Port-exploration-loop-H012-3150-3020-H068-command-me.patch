+/* Apre la porta davanti al party da entrambi i lati. */
+static void open_door_ahead(void)
+{
+    open_door(POS_X, POS_Y, POS_DIR);
+    open_door((s16)(POS_X + DX(POS_DIR)), (s16)(POS_Y + DY(POS_DIR)),
+              (u8)((POS_DIR + 4) & 7));
