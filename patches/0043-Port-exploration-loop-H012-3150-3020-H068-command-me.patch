+static u8 cast_knock(void)
+{
+    Character *p;                       /* -$4(a5) */
+
+    p = who_has_spell(0x1F);
+    if (p != NULL) {
+        p->b[0x1E + memorized_spell_index(0x1F, p)] = 0;
+        return 1;
+    }
+    return 0;
+}
