     g_handlers_25c0[104] = spell_bless;   /* $2760 */
     g_handlers_25c0[105] = spell_charm_person;   /* $2764 */
     g_handlers_25c0[106] = spell_burning_hands;   /* $2768 */
-    g_handlers_2832[3] = h085_4a02;   /* $283E */
