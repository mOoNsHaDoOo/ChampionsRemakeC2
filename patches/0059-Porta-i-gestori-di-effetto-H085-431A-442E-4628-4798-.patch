     g_handlers_2832[5] = (CokHandler)effect_breath;   /* $2846 */
     g_handlers_2832[103] = (CokHandler)effect_breath;   /* $29CE */
     g_handlers_2832[82] = (CokHandler)effect_breath;   /* $297A */
