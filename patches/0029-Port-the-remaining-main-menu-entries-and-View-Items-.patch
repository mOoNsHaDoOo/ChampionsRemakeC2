+/* PORT H066+$300E: byte da salvare per il party (record, oggetti, effetti). */
+static u16 party_save_size(void)
+{
+    Character *p;                       /* -$4(a5) */
+    CokItem *it;                        /* -$8(a5) */
+    CokEffect *ef;                      /* -$c(a5) */
+    u16 size = 0;                       /* -$e(a5) */
+
+    for (p = g_party_head; p != NULL; p = p->next) {
+        size = (u16)(size + 0x1AA);
+        if (p->items != NULL) {
+            for (it = p->items; it != NULL; it = it->next) {
+                size = (u16)(size + 0x48);
+            }
+        }
+        if (p->effects != NULL) {
+            for (ef = p->effects; ef != NULL; ef = ef->next) {
+                size = (u16)(size + 0x0A);
+            }
+        }
+    }
+    return size;
+}
