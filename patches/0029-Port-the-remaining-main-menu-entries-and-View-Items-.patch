+        copy_text(order, "rose", 5);
+    }
+    copy_text(s_message, "Knight Of The ", 0x50);
+    h026_append(0x50, s_message, 5, order);
+    ui_draw_text(0x0A, 7, 0x0A, 0, 0x50, s_message);
+    if (c->b[0x5D] == 1) {                         /* $46C6 */
