diff --git a/src_c/readable/h045.c b/src_c/readable/h045.c
index 5fd3d8d..f88f0f0 100644
--- a/src_c/readable/h045.c
+++ b/src_c/readable/h045.c
@@ -51,3 +51,64 @@ void format_number(u16 max_len, char *out, s32 value, u8 is_signed,
     }
     out[j] = 0;
 }
+
+/*
+ * PORT H045+$000C (corpo a $0068): legge da s un numero in base base
+ * (cifre 0-9 e A-Z), saltando gli spazi iniziali; con is_signed accetta
+ * un segno.  Restituisce 0 (senza scrivere *out) se non c'e' un numero o
+ * una cifra non e' valida.
+ */
+u8 parse_number(u16 len, const char *s, s32 *out, u8 is_signed, u16 base)
+{
+    u16 pos = 0;                        /* -$2(a5) */
+    u16 digit;                          /* -$4(a5) */
+    u8 ch;                              /* -$5(a5) */
+    s32 value;                          /* -$a(a5) */
+    u8 negative = 0;                    /* -$b(a5) */
+
+    (void)len;
+    /* H045+$0014: salta gli spazi; 0 alla fine della stringa. */
+    while (s[pos] != 0 && s[pos] == ' ') {
+        ++pos;
+    }
+    if (s[pos] == 0) {
+        return 0;
+    }
+    if (is_signed) {
+        negative = 0;
+        if (s[pos] == '-' || s[pos] == '+') {
+            negative = (u8)(s[pos] == '-');
+            ++pos;
+            while (s[pos] != 0 && s[pos] == ' ') {
+                ++pos;
+            }
+            if (s[pos] == 0) {
+                return 0;
+            }
+        }
+    }
+    value = 0;
+    while ((u8)s[pos] > ' ') {
+        ch = (u8)s[pos];
+        if (ch >= 'a' && ch <= 'z') {
+            ch &= 0x5F;
+        }
+        if (ch >= '0' && ch <= '9') {
+            digit = (u16)(ch - '0');
+        } else if (ch >= 'A' && ch <= 'Z') {
+            digit = (u16)(ch - 'A' + 10);
+        } else {
+            return 0;
+        }
+        if (digit >= base) {
+            return 0;
+        }
+        value = (s32)((u32)base * (u32)value) + digit;
+        ++pos;
+    }
+    if (is_signed && negative) {
+        value = -value;
+    }
+    *out = value;
+    return 1;
+}
