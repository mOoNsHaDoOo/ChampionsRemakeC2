+    while (g_acid_pools != NULL) {
+        next = g_acid_pools->next;
+        exec_free_mem(g_acid_pools, sizeof(CokCloud));
+        g_acid_pools = next;
+    }
+    for (p = g_party_head; p != NULL; p = p->next) {
+        if (find_effect(p, 0x0B, &e) && p->b[0x197] == 0) {
+            if (H005_B(0x2A1D) > 1) {
