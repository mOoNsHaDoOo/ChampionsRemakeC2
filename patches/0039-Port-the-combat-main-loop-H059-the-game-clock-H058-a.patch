+    }
+    n = combatant_index(c);
+    show_combatant_cursor(c, 3, 0);
+    show_char_message(c, len, copy, 0x0A, 1);
+    c->b[0x198] = 0;
+    c->b[0x197] = status;
+    if (c->b[0x197] != 3) {
+        c->b[0x1A8] = 0;
+    }
+    redraw_ground(0, 0, n);
+    H005_B(0x3154 + (n - 1) * 6 + 5) = 0;
+    rebuild_occupancy();
+    if (end_combat_turn(c)) {
+        drop_effects(c);
+    }
+}
