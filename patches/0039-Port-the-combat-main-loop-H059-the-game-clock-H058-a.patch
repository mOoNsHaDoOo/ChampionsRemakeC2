+    redraw_ground(0, 0, combatant_index(f->c));
+    *f->done = (u8)!place_combatant(f->c, (u8)f->x0, (u8)f->y0, 0);
+    center_view((s16)combatant_x(f->c), (s16)combatant_y(f->c), 0, 8);
