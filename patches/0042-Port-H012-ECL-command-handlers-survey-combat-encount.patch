+    CokItem *it;                        /* -$C(a5) */
+
+    read_operands(1);
+    t = eval_operand(1);
+    h029_fill_bytes(5, &H005_B(0x237E), 6, 0);
+    H005_B(0x237F) = 1;
+    for (p = g_party_head; p != NULL && !found; p = p->next) {
+        for (it = p->items; it != NULL && !found; it = it->next) {
+            if (it->b[0x30] == t) {
+                H005_B(0x237E) = 1;
+                H005_B(0x237F) = 0;
+                found = 1;
+            }
+        }
