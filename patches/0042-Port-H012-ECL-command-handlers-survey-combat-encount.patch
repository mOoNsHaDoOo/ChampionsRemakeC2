+/* PORT H012+$0B18 (comandi $25 ON GOTO e $26 ON GOSUB). */
+void ecl_on_goto(void)
+{
+    u8 done = 0;                        /* -$9(a5) */
+    u16 v;                              /* -$2(a5) */
+    u16 n;                              /* -$4(a5) */
+    u16 i = 0;                          /* -$8(a5) */
+
+    read_operands(2);
+    v = eval_operand(1);
+    n = eval_operand(2);
+    H005_SET_W(0x3DEA, H005_W(0x3DEA) - 1);
+    read_operands(n);
+    while (i < n && !done) {
+        if (v == i) {
+            if (H005_B(0x2493) == 0x25) {
+                H005_SET_W(0x3DEA, ADDR(i + 1));
+            } else {
+                ecl_gosub((u16)(i + 1));
+            }
+            done = 1;
+        } else {
+            ++i;
+        }
+    }
+}
