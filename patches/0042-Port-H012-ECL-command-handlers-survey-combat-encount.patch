+/*
+ * PORT H012+$2596 (comando $3B): cerca l'incantesimo s fra quelli
+ * memorizzati (+$1F..) dei personaggi: posizione ($FF se no) e numero
+ * del personaggio nelle variabili; poi la traccia di debug H056+$0886.
+ */
+void ecl_find_spell(void)
+{
+    u8 found = 0;                       /* -$B(a5) */
+    u8 stop = 0;                        /* -$C(a5) */
+    u16 s;                              /* -$2(a5) */
+    u16 dst1;                           /* -$E(a5) */
+    u16 dst2;                           /* -$10(a5) */
+    u16 k = 1;                          /* -$4(a5) */
+    u16 idx = 0;                        /* -$6(a5) */
+    Character *p;                       /* -$A(a5) */
+
+    read_operands(3);
+    s = eval_operand(1);
+    dst1 = ADDR(2);
+    dst2 = ADDR(3);
+    p = g_party_head;
+    while (p != NULL && !found) {
+        k = 1;
+        do {
+            if (p->b[0x1E + k] == s) {
+                found = 1;
+            } else if (k <= 0x39) {
+                ++k;
+            } else {
+                stop = 1;
+            }
+        } while (!stop && !found);
+        stop = 0;
+        p = p->next;
+        if (p != NULL && !found) {
+            ++idx;
+        }
+    }
+    if (k > 0x39) {
+        k = 0xFF;
+    }
+    write_var(dst1, k);
+    write_var(dst2, idx);
+    debug_trace(5, "spell", (u8)k, (u8)idx, (u8)s);
+}
