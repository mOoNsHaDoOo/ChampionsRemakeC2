+/*
+ * PORT H012+$29A6 (comando $38): 0 il menu del party (H013+$4BFC), 9 il
+ * campo ($2922) e, fuori dalla citta', EXIT.
+ */
+void ecl_party_menu(void)
+{
+    u8 save;                            /* -$A(a5) */
+    u16 pc;                             /* -$4(a5) */
+    u16 v;                              /* -$2(a5) */
+
+    save = H005_B(0x24B0);
+    H005_B(0x24B0) = 0;
+    if (H064_B(9)) {
+        g_current_char = g_h064_saved_char;
+        H064_B(9) = 0;
+    }
+    pc = H005_W(0x3DEA);
+    read_operands(1);
+    v = eval_operand(1);
+    switch (v) {
+    case 0:
+        H005_B(0x249C) = 0;
+        main_menu();
+        H005_B(0x249C) = 1;
+        if (H005_B(0x2486) != 9 && COK_GET16(g_state_a + 0x270) == 0 &&
+            COK_GET16(g_state_a + 0x1CC) == 0) {
+            redraw_game_screen();
+        }
+        break;
+    case 9:
+        pc = H005_W(0x3DEA);
+        ecl_camp_entry();
+        H005_SET_W(0x3DEA, pc);
+        if (COK_GET16(g_state_a + 0x270) == 0) {
+            ecl_exit();
+        }
+        break;
+    default:
+        break;
+    }
+    (void)pc;
+    H005_B(0x24B0) = save;
+}
