+    Character *save;                    /* -$A(a5) */
+    Character *p;                       /* -$6(a5) */
+    CokItem *it;                        /* -$E(a5) */
+    CokItem *next;                      /* -$12(a5) */
+
+    read_operands(1);
+    t = eval_operand(1);
+    save = g_current_char;
+    for (p = g_party_head; p != NULL; p = p->next) {
+        it = p->items;
+        while (it != NULL) {
+            next = it->next;
+            if (it->b[0x30] == t) {
+                g_current_char = p;
+                if (it->b[0x3A]) {
+                    ready_item(it);
+                }
+                delete_item(p, it);
+            }
+            it = next;
+        }
+        recompute_stats(p);
+    }
+    g_current_char = save;
+}
