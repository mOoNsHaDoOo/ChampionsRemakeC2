+/*
+ * PORT H012+$0208 (annidata in $01FA): scrive minimo, massimo, media e
+ * "trovato" nelle variabili degli operandi 3..6.
+ */
+typedef struct SurveyFrame {
+    u8 found;                           /* -$D(a5) */
+    u16 avg;                            /* -$14(a5) */
+    u16 max;                            /* -$16(a5) */
+    u16 min;                            /* -$18(a5) */
+    u16 dst[4];                         /* -$1A..-$20(a5) */
+} SurveyFrame;
+
+static void survey_store(SurveyFrame *f)
+{
+    write_var(f->dst[0], f->min);
+    write_var(f->dst[1], f->max);
+    write_var(f->dst[2], f->avg);
+    write_var(f->dst[3], f->found);
+}
+
+/*
+ * PORT H012+$01FA (comando $1E, PARTY SURVEY): per la variabile del
+ * personaggio indicata (o il suo valore): effetto presente in qualcuno,
+ * livello (+$1B), uno dei valori +$E0.. o la velocita' +$1A9: minimo,
+ * massimo e media sul party.  Per una variabile non prevista l'indice non
+ * e' inizializzato nell'originale: qui 0 (ricerca dell'effetto).
+ */
+void ecl_party_survey(void)
+{
+    SurveyFrame f;
+    Character *p;                       /* -$C(a5) */
+    CokEffect *e;                       /* -$12(a5) */
+    u16 addr;                           /* -$2(a5) */
+    u16 kind = 0;                       /* -$4(a5) */
+    u16 total = 0;                      /* -$6(a5) */
+    u16 v8;                             /* -$8(a5) */
+    u16 count = 0;                      /* -$22(a5) */
+    u16 k;                              /* -$24(a5) */
+    u8 v;
+
+    read_operands(6);
+    p = g_party_head;
+    f.found = 0;
+    if (OPD(1) == 1) {
+        addr = ADDR(1);
+    } else {
+        addr = eval_operand(1);
+    }
+    v8 = eval_operand(2);
+    f.dst[0] = ADDR(3);
+    f.dst[1] = ADDR(4);
+    f.dst[2] = ADDR(5);
+    f.dst[3] = ADDR(6);
+    f.min = 0xFF;
+    f.max = 0;
+    f.avg = 0;
+    addr = (u16)(addr - 0x3100);
+    if (addr == 0x8400) {
+        kind = 0;
+    } else if (addr == 0x19) {
+        kind = 1;
+    } else if (addr > 0xA4 && addr < 0xAD) {
+        kind = (u16)(addr - 0xA3);
+    } else if (addr == 0x9F) {
+        kind = 0x0A;
+    }
+    switch (kind) {
+    case 0:
+        while (p != NULL && !f.found) {
+            f.found = find_effect(p, v8, &e);
+            p = p->next;
+        }
+        f.min = 0;
+        f.max = 0;
+        f.avg = 0;
+        survey_store(&f);
+        break;
+    case 1:
+        for (; p != NULL; p = p->next) {
+            ++count;
+            v = p->b[0x1B];
+            if (v > f.max) f.max = v;
+            if (v < f.min) f.min = v;
+            total = (u16)(total + v);
+        }
+        f.avg = (u16)(total / count);
+        survey_store(&f);
+        break;
+    case 2: case 3: case 4: case 5: case 6: case 7: case 8: case 9:
+        k = (u16)(addr - 0xA4);
+        for (; p != NULL; p = p->next) {
+            ++count;
+            v = p->b[0xE0 + k - 1];
+            if (v < f.min) f.min = v;
+            if (v > f.max) f.max = v;
+            total = (u16)(total + v);
+        }
+        f.avg = (u16)(total / count);
+        survey_store(&f);
+        break;
+    case 0x0A:
+        for (; p != NULL; p = p->next) {
+            ++count;
+            v = p->b[0x1A9];
+            if (v < f.min) f.min = v;
+            if (v > f.max) f.max = v;
+            total = (u16)(total + v);
+        }
+        f.avg = (u16)(total / count);
+        survey_store(&f);
+        break;
+    default:
+        break;
+    }
+}
