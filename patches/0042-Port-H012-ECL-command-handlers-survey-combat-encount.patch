+/* Tipo dell'oggetto casuale del tesoro (le tabelle di H012+$0BEA). */
+static u16 random_treasure_type(void)
+{
+    u16 r;                              /* -$72(a5) */
+    u16 r2;                             /* -$74(a5) */
+    u16 cat;                            /* -$88(a5) */
+    u16 sub;                            /* -$86(a5) */
+    u16 t = 0;                          /* -$78(a5) */
+
+    r = roll_dice(1, 0x64);
+    if (r < 0x15) cat = 0;
+    else if (r < 0x42) cat = 1;
+    else if (r < 0x47) cat = 2;
+    else if (r < 0x51) cat = 3;
+    else if (r < 0x56) cat = 4;
+    else if (r < 0x60) cat = 5;
+    else cat = 6;
+    switch (cat) {
+    case 0:
+        r2 = roll_dice(1, 0x64);
+        sub = (u16)(r2 < 0x0B ? 0 : (r2 < 0x1A ? 1 : 2));
+        switch (sub) {
+        case 0:
+            r2 = roll_dice(1, 0x0A);
+            if (r2 <= 2) t = 6;
+            else if (r2 <= 6) t = 8;
+            else if (r2 <= 8) t = 0x46;
+            else if (r2 == 9) t = 0x0F;
+            else if (r2 == 0x0A) t = 0x1D;
+            break;
+        case 1:
+            r2 = roll_dice(1, 0x14);
+            if (r2 >= 1 && r2 <= 3) t = 5;
+            else if (r2 <= 5) t = 7;
+            else if (r2 <= 8) t = 0x18;
+            else if (r2 <= 0x0A) t = 0x16;
+            else if (r2 <= 0x0C) t = 0x19;
+            else if (r2 <= 0x0E) t = 0x17;
+            else if (r2 <= 0x10) t = 0x1C;
+            else if (r2 <= 0x12) t = 0x1D;
+            else if (r2 <= 0x14) t = 0x1E;
+            break;
+        default:
+            r2 = roll_dice(1, 4);
+            if (r2 < 4) {
+                r2 = roll_dice(1, 0x14);
+                if (r2 >= 1 && r2 <= 8) t = 0x12;
+                else if (r2 <= 0x0D) t = 0x11;
+                else if (r2 == 0x0E) t = 0x0D;
+                else if (r2 == 0x0F) t = 0x10;
+                else if (r2 <= 0x12) t = 0x13;
+                else if (r2 <= 0x14) t = 0x14;
+            } else {
+                r2 = roll_dice(1, 8);
+                if (r2 == 1) t = 1;
+                else if (r2 <= 3) t = 4;
+                else if (r2 <= 5) t = 8;
+                else if (r2 == 6) t = 0x0A;
+                else if (r2 == 7) t = 0x0E;
+                else if (r2 == 8) t = 0x47;
+            }
+            break;
+        }
+        break;
+    case 1: t = 0x27; break;
+    case 2: t = 0x28; break;
+    case 3: t = 0x25; break;
+    case 4: t = 0x3B; break;
+    case 5:
+        r2 = roll_dice(1, 0x14);
+        if (r2 >= 1 && r2 <= 3) t = 0x1F;
+        else if (r2 <= 0x0B) t = 0x23;
+        else if (r2 <= 0x10) t = 0x24;
+        else if (r2 == 0x11) t = 0x20;
+        else if (r2 == 0x12) t = 0x21;
+        else if (r2 <= 0x14) t = 0x22;
+        break;
+    default:
+        r2 = roll_dice(1, 6);
+        if (r2 >= 1 && r2 <= 2) t = 0x32;
+        else if (r2 <= 4) t = 0x30;
+        else if (r2 == 5) t = 0x34;
+        else if (r2 == 6) t = 0x35;
+        break;
+    }
+    return t;
+}
