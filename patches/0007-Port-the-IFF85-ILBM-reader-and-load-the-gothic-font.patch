diff --git a/src_c/readable/h086.c b/src_c/readable/h086.c
index 3913298..abbf6bd 100644
--- a/src_c/readable/h086.c
+++ b/src_c/readable/h086.c
@@ -1,7 +1,327 @@
-/* H086: Parser generico IFF: chunk e gruppi FORM/LIST/PROP/CAT. */
-#include "cok.h"
+/*
+ * H086: parser IFF generico (iff.c "IFF85" di Electronic Arts, 1985).
+ *
+ * Differenza dall'originale: intestazioni dei chunk e sottotipi sono letti
+ * in un buffer di byte e convertiti da big-endian (COK_GET32), invece di
+ * essere letti direttamente nei campi LONG; sull'Amiga il risultato e' lo
+ * stesso, sull'host (little-endian) e' quello corretto.
+ */
+#include "h086.h"
+#include "h098.h"
 
 /* PORT H086+$0004: link/unlk, nessun effetto. */
 void h086_init(void)
 {
 }
+
+/*
+ * PORT H086+$000C (FileLength): va alla fine del file; la seconda GSeek
+ * (spostamento 0 da OFFSET_CURRENT) restituisce quella posizione, cioe' la
+ * lunghezza.  Il file resta alla fine: lo riavvolge OpenRIFF.
+ */
+s32 iff_file_length(cok_bptr file)
+{
+    s32 length = NO_FILE;
+
+    /* tst.l / bls: con file 0 resta NO_FILE (confronto senza segno). */
+    if (file != 0) {
+        (void)gio_seek(file, 0, OFFSET_END);
+        length = gio_seek(file, 0, OFFSET_CURRENT);
+        if (length < 0) {
+            length = DOS_ERROR;
+        }
+    }
+    return length;
+}
+
+/* PORT H086+$0068 (SkipFwd) */
+s32 iff_skip_fwd(GroupContext *context, s32 bytes)
+{
+    s32 iffp = IFF_OKAY;
+
+    if (bytes > 0) {
+        if (gio_seek(context->file, bytes, OFFSET_CURRENT) == -1) {
+            iffp = BAD_IFF;
+        } else {
+            context->position += bytes;
+        }
+    }
+    return iffp;
+}
+
+/* PORT H086+$00C0 (OpenRIFF): contesto del file intero. */
+s32 iff_open_riff(cok_bptr file, GroupContext *new_ctx,
+                  ClientFrame *client_frame)
+{
+    s32 iffp = IFF_OKAY;
+
+    new_ctx->parent = NULL;
+    new_ctx->client_frame = client_frame;
+    new_ctx->file = file;
+    new_ctx->position = 0;
+    new_ctx->subtype = 0;
+    new_ctx->bytes_so_far = 0;
+    new_ctx->ck_id = 0;
+    new_ctx->ck_size = 0;
+    new_ctx->bound = iff_file_length(file);
+    if (new_ctx->bound < 0) {
+        iffp = new_ctx->bound;
+    } else if (new_ctx->bound < 8) {
+        iffp = NOT_IFF;
+    } else {
+        (void)gio_seek(file, 0, OFFSET_BEGINNING);
+    }
+    return iffp;
+}
+
+/* PORT H086+$015C (OpenRGroup): contesto del gruppo nel chunk corrente. */
+s32 iff_open_rgroup(GroupContext *parent, GroupContext *new_ctx)
+{
+    s32 iffp = IFF_OKAY;
+
+    new_ctx->parent = parent;
+    new_ctx->client_frame = parent->client_frame;
+    new_ctx->file = parent->file;
+    new_ctx->position = parent->position;
+    new_ctx->bound = iff_chunk_more_bytes(parent) + parent->position;
+    new_ctx->subtype = 0;
+    new_ctx->bytes_so_far = 0;
+    new_ctx->ck_id = 0;
+    new_ctx->ck_size = 0;
+    if (new_ctx->bound > parent->bound || (new_ctx->bound & 1) != 0) {
+        iffp = BAD_IFF;
+    }
+    return iffp;
+}
+
+/* PORT H086+$01F8 (CloseRGroup): riporta la posizione nel genitore. */
+s32 iff_close_rgroup(GroupContext *context)
+{
+    s32 position;
+
+    if (context->parent != NULL) {
+        position = context->position;
+        context->parent->bytes_so_far += position - context->parent->position;
+        context->parent->position = position;
+    }
+    return IFF_OKAY;
+}
+
+/*
+ * PORT H086+$022E (GetChunkHdr): salta il resto del chunk corrente (con il
+ * byte di riempimento) e legge l'intestazione del successivo.  Restituisce
+ * l'ID del chunk oppure un IFFP negativo, lasciato anche in ck_id.
+ */
+s32 iff_get_chunk_hdr(GroupContext *context)
+{
+    s32 remaining;
+    s32 result;
+    u8 header[8];
+    u8 subtype[4];
+
+    result = iff_skip_fwd(context, iff_chunk_more_bytes(context) +
+                                   (context->ck_size & 1));
+    if (result != 0) {
+        return result;
+    }
+    context->ck_id = BAD_IFF;
+    context->subtype = 0;
+    context->bytes_so_far = 0;
+    remaining = context->bound - context->position;
+    if (remaining == 0) {
+        context->ck_size = 0;
+        context->ck_id = END_MARK;
+    } else if (remaining < 8) {
+        context->ck_size = remaining;
+    } else {
+        result = gio_read(context->file, header, 8);
+        if (result == -1) {
+            context->ck_id = DOS_ERROR;
+            return DOS_ERROR;
+        }
+        if (result == 0) {
+            context->ck_id = BAD_IFF;
+            return BAD_IFF;
+        }
+        context->ck_id = (s32)COK_GET32(header);
+        context->ck_size = (s32)COK_GET32(header + 4);
+        if (context->parent == NULL && context->ck_id != ID_FORM &&
+            context->ck_id != ID_LIST && context->ck_id != ID_CAT) {
+            context->ck_id = NOT_IFF;
+            return NOT_IFF;
+        }
+        context->position += 8;
+        remaining -= 8;
+        if (context->ck_id <= 0) {
+            context->ck_id = BAD_IFF;
+        } else if (context->ck_size < 0 || context->ck_size > remaining) {
+            context->ck_size = remaining;
+            context->ck_id = BAD_IFF;
+        } else if (context->ck_id == ID_LIST || context->ck_id == ID_FORM ||
+                   context->ck_id == ID_PROP || context->ck_id == ID_CAT) {
+            result = iff_read_bytes(context, subtype, 4);
+            if (result != 0) {
+                context->ck_id = result;
+            } else {
+                context->subtype = (s32)COK_GET32(subtype);
+            }
+        }
+    }
+    return context->ck_id;
+}
+
+/*
+ * PORT H086+$03F2 (IFFReadBytes): legge dal chunk corrente senza
+ * superarne la fine.
+ */
+s32 iff_read_bytes(GroupContext *context, void *buffer, s32 n_bytes)
+{
+    s32 iffp = IFF_OKAY;
+    s32 read;
+
+    if (n_bytes < 0) {
+        iffp = CLIENT_ERROR;
+    } else if (n_bytes > iff_chunk_more_bytes(context)) {
+        iffp = SHORT_CHUNK;
+    } else if (n_bytes > 0) {
+        read = gio_read(context->file, buffer, n_bytes);
+        if (read == -1) {
+            iffp = DOS_ERROR;
+        } else if (read == 0) {
+            iffp = BAD_IFF;
+        } else {
+            context->position += n_bytes;
+            context->bytes_so_far += n_bytes;
+        }
+    }
+    return iffp;
+}
+
+/* Chiamata del callback del client per il gruppo letto. */
+static s32 call_group(GroupContext *context, ClientFrame *frame, s32 id)
+{
+    if (id == ID_FORM) {
+        return frame->get_form(context);
+    }
+    if (id == ID_LIST) {
+        return frame->get_list(context);
+    }
+    if (id == ID_CAT) {
+        return frame->get_cat(context);
+    }
+    return id;
+}
+
+/*
+ * PORT H086+$04BA (ReadIFF): legge il file come un unico gruppo FORM, LIST
+ * o CAT chiamando il callback corrispondente.  Un risultato positivo (un ID
+ * non gestito) diventa NOT_IFF.
+ */
+s32 iff_read_iff(cok_bptr file, ClientFrame *client_frame)
+{
+    GroupContext context;
+    s32 iffp;
+
+    iffp = iff_open_riff(file, &context, client_frame);
+    if (iffp == 0) {
+        iffp = iff_get_chunk_hdr(&context);
+        iffp = call_group(&context, client_frame, iffp);
+    }
+    (void)iff_close_rgroup(&context);
+    if (iffp > 0) {
+        iffp = NOT_IFF;
+    }
+    return iffp;
+}
+
+/*
+ * PORT H086+$0578 (ReadIList): legge un LIST (o un CAT con client_frame
+ * NULL): i PROP sono ammessi solo all'inizio di un LIST.
+ */
+s32 iff_read_ilist(GroupContext *parent, ClientFrame *client_frame)
+{
+    GroupContext list_context;
+    s32 iffp;
+    u8 prop_ok = 1;
+
+    iffp = iff_open_rgroup(parent, &list_context);
+    if (iffp != 0) {
+        return iffp;
+    }
+    if (parent->ck_id == ID_CAT) {
+        prop_ok = 0;
+    } else {
+        list_context.client_frame = client_frame;
+    }
+    do {
+        iffp = iff_get_chunk_hdr(&list_context);
+        if (iffp == ID_PROP) {
+            if (prop_ok) {
+                iffp = client_frame->get_prop(&list_context);
+            } else {
+                iffp = BAD_IFF;
+            }
+        } else {
+            iffp = call_group(&list_context, client_frame, iffp);
+        }
+        if (list_context.ck_id != ID_PROP) {
+            prop_ok = 0;
+        }
+    } while (iffp == IFF_OKAY);
+    (void)iff_close_rgroup(&list_context);
+    if (iffp > 0) {
+        iffp = BAD_IFF;
+    }
+    if (iffp == END_MARK) {
+        iffp = IFF_OKAY;
+    }
+    return iffp;
+}
+
+/* PORT H086+$06BC (ReadICat) */
+s32 iff_read_icat(GroupContext *parent)
+{
+    return iff_read_ilist(parent, NULL);
+}
+
+/* PORT H086+$06D6 (GetFChunkHdr): dentro un FORM un PROP e' un errore. */
+s32 iff_get_fchunk_hdr(GroupContext *context)
+{
+    s32 id = iff_get_chunk_hdr(context);
+
+    if (id == ID_PROP) {
+        id = BAD_IFF;
+        context->ck_id = id;
+    }
+    return id;
+}
+
+/*
+ * PORT H086+$0714 (GetF1ChunkHdr): come GetFChunkHdr, ma legge subito i
+ * gruppi annidati con i callback del client.
+ */
+s32 iff_get_f1chunk_hdr(GroupContext *context)
+{
+    ClientFrame *frame = context->client_frame;
+    s32 iffp = iff_get_chunk_hdr(context);
+
+    if (iffp == ID_PROP) {
+        iffp = BAD_IFF;
+    } else {
+        iffp = call_group(context, frame, iffp);
+    }
+    context->ck_id = iffp;
+    return iffp;
+}
+
+/* PORT H086+$07C0 (GetPChunkHdr): dentro un PROP i gruppi sono errori. */
+s32 iff_get_pchunk_hdr(GroupContext *context)
+{
+    s32 id = iff_get_chunk_hdr(context);
+
+    if (id == ID_LIST || id == ID_FORM || id == ID_PROP || id == ID_CAT) {
+        id = BAD_IFF;
+        context->ck_id = id;
+    }
+    return id;
+}
diff --git a/src_c/readable/h086.h b/src_c/readable/h086.h
new file mode 100644
index 0000000..5847b9b
--- /dev/null
+++ b/src_c/readable/h086.h
@@ -0,0 +1,76 @@
+/*
+ * H086: parser IFF generico (iff.c "IFF85" di Electronic Arts, 1985):
+ * gruppi FORM/LIST/PROP/CAT, intestazioni dei chunk, lettura dei byte.
+ */
+#ifndef COK_H086_H
+#define COK_H086_H
+
+#include "h002_dos.h"
+
+/* Valori IFFP restituiti dalle routine (negativi = fine o errore). */
+#define IFF_OKAY      0
+#define END_MARK     (-1)       /* fine del gruppo */
+#define IFF_DONE     (-2)       /* il client ha finito */
+#define DOS_ERROR    (-3)
+#define NOT_IFF      (-4)
+#define NO_FILE      (-5)
+#define CLIENT_ERROR (-6)
+#define BAD_FORM     (-7)
+#define SHORT_CHUNK  (-8)
+#define BAD_IFF      (-9)
+
+#define COK_MAKE_ID(a, b, c, d) \
+    ((s32)((u32)(a) << 24 | (u32)(b) << 16 | (u32)(c) << 8 | (u32)(d)))
+#define ID_FORM COK_MAKE_ID('F', 'O', 'R', 'M')
+#define ID_LIST COK_MAKE_ID('L', 'I', 'S', 'T')
+#define ID_PROP COK_MAKE_ID('P', 'R', 'O', 'P')
+#define ID_CAT  COK_MAKE_ID('C', 'A', 'T', ' ')
+
+struct GroupContext;
+typedef s32 (*IffGroupFn)(struct GroupContext *parent);
+
+/* ClientFrame: callback per i gruppi (16 byte nell'originale). */
+typedef struct ClientFrame {
+    IffGroupFn get_list;        /* +$00 */
+    IffGroupFn get_prop;        /* +$04 */
+    IffGroupFn get_form;        /* +$08 */
+    IffGroupFn get_cat;         /* +$0C */
+} ClientFrame;
+
+/*
+ * GroupContext ($24 byte nell'originale).  ck_id, ck_size e subtype sono
+ * letti dal file big-endian e qui tenuti come valori numerici.
+ */
+typedef struct GroupContext {
+    struct GroupContext *parent; /* +$00: NULL al livello del file */
+    ClientFrame *client_frame;  /* +$04 */
+    cok_bptr file;              /* +$08 */
+    s32 position;               /* +$0C: posizione nel file */
+    s32 bound;                  /* +$10: fine del gruppo */
+    s32 ck_id;                  /* +$14: chunk corrente (o IFFP) */
+    s32 ck_size;                /* +$18 */
+    s32 subtype;                /* +$1C: sottotipo di FORM/LIST/PROP/CAT */
+    s32 bytes_so_far;           /* +$20: byte del chunk gia' letti */
+} GroupContext;
+
+s32 iff_file_length(cok_bptr file);                          /* H086+$000C */
+s32 iff_skip_fwd(GroupContext *context, s32 bytes);          /* H086+$0068 */
+s32 iff_open_riff(cok_bptr file, GroupContext *new_ctx,
+                  ClientFrame *client_frame);                 /* H086+$00C0 */
+s32 iff_open_rgroup(GroupContext *parent, GroupContext *new_ctx);
+                                                              /* H086+$015C */
+s32 iff_close_rgroup(GroupContext *context);                 /* H086+$01F8 */
+s32 iff_get_chunk_hdr(GroupContext *context);                /* H086+$022E */
+s32 iff_read_bytes(GroupContext *context, void *buffer, s32 n_bytes);
+                                                              /* H086+$03F2 */
+s32 iff_read_iff(cok_bptr file, ClientFrame *client_frame);  /* H086+$04BA */
+s32 iff_read_ilist(GroupContext *parent, ClientFrame *client_frame);
+                                                              /* H086+$0578 */
+s32 iff_read_icat(GroupContext *parent);                     /* H086+$06BC */
+s32 iff_get_fchunk_hdr(GroupContext *context);               /* H086+$06D6 */
+s32 iff_get_f1chunk_hdr(GroupContext *context);              /* H086+$0714 */
+s32 iff_get_pchunk_hdr(GroupContext *context);               /* H086+$07C0 */
+
+s32 iff_chunk_more_bytes(GroupContext *context);             /* H039+$000C */
+
+#endif
diff --git a/src_c/readable/h087.c b/src_c/readable/h087.c
index 2f5d23d..8ffff6b 100644
--- a/src_c/readable/h087.c
+++ b/src_c/readable/h087.c
@@ -1,7 +1,152 @@
 /* H087: Lettura BMHD, palette e BODY delle immagini ILBM. */
-#include "cok.h"
+#include "h087.h"
+#include "h003_exec.h"
+#include "h015_runtime.h"
 
 /* PORT H087+$0004: link/unlk, nessun effetto. */
 void h087_init(void)
 {
 }
+
+/*
+ * PORT H087+$000C (GetBMHD): 20 byte del chunk BMHD.  L'originale li legge
+ * direttamente nella struttura; qui in un buffer, convertiti da big-endian.
+ */
+s32 ilbm_get_bmhd(GroupContext *context, BitMapHeader *bm_hdr)
+{
+    u8 raw[20];
+    s32 iffp = iff_read_bytes(context, raw, 20);
+
+    if (iffp == IFF_OKAY) {
+        bm_hdr->w = COK_GET16(raw);
+        bm_hdr->h = COK_GET16(raw + 2);
+        bm_hdr->x = (s16)COK_GET16(raw + 4);
+        bm_hdr->y = (s16)COK_GET16(raw + 6);
+        bm_hdr->n_planes = raw[8];
+        bm_hdr->masking = raw[9];
+        bm_hdr->compression = raw[0x0A];
+        bm_hdr->pad1 = raw[0x0B];
+        bm_hdr->transparent_color = COK_GET16(raw + 0x0C);
+        bm_hdr->x_aspect = raw[0x0E];
+        bm_hdr->y_aspect = raw[0x0F];
+        bm_hdr->page_width = (s16)COK_GET16(raw + 0x10);
+        bm_hdr->page_height = (s16)COK_GET16(raw + 0x12);
+    }
+    return iffp;
+}
+
+/*
+ * PORT H087+$009C (GetCMAP): al massimo *n_color_regs colori (terne RGB a
+ * 8 bit ridotte a RGB4); *n_color_regs diventa il numero letto.
+ */
+s32 ilbm_get_cmap(GroupContext *context, u16 *color_map, u8 *n_color_regs)
+{
+    u8 n = (u8)h015_divs32(context->ck_size, 3, NULL);
+    u8 rgb[3];
+    s32 iffp;
+
+    if (*n_color_regs < n) {
+        n = *n_color_regs;
+    }
+    *n_color_regs = n;
+    while (n > 0) {
+        iffp = iff_read_bytes(context, rgb, 3);
+        if (iffp != IFF_OKAY) {
+            return iffp;
+        }
+        *color_map++ = (u16)(((rgb[0] >> 4) << 8) + ((rgb[1] >> 4) << 4) +
+                             (rgb[2] >> 4));
+        --n;
+    }
+    return IFF_OKAY;
+}
+
+/*
+ * PORT H087+$0166 (GetBODY): legge il BODY riga per riga nei piani della
+ * bitmap (piani in piu' del file e maschera senza destinazione vanno nel
+ * primo blocco del buffer, che fa da cestino).  buffer/buf_size sono il
+ * buffer di lettura del chunk; servono almeno due righe compresse.
+ */
+s32 ilbm_get_body(GroupContext *context, struct BitMap *bitmap, u8 *mask,
+                  BitMapHeader *bm_hdr, u8 *buffer, s32 buf_size)
+{
+    u16 src_plane_cnt = bm_hdr->n_planes;           /* -$6 */
+    u16 src_row_bytes = ilbm_row_bytes(bm_hdr->w);  /* -$8 */
+    s32 buf_row_bytes = (s32)ilbm_max_packed_size(src_row_bytes); /* -$C */
+    u16 n_rows = bm_hdr->h;                         /* -$E */
+    u8 compression = bm_hdr->compression;           /* -$F */
+    u8 *planes[MAX_SRC_PLANES];                     /* -$6C */
+    u8 *null_dest;                                  /* -$20 */
+    u8 *null_buf;                                   /* -$24 */
+    u8 **p_dest;                                    /* -$28 */
+    u8 *buf;                                        /* -$1C */
+    u16 n_empty;                                    /* -$16 */
+    u16 n_filled;                                   /* -$18 */
+    u16 i_plane;                                    /* -$12 */
+    s32 iffp;
+
+    if (compression > CMP_BYTE_RUN1) {
+        return CLIENT_ERROR;
+    }
+    if (src_row_bytes != bitmap->BytesPerRow ||
+        buf_size < buf_row_bytes * 2 || src_plane_cnt > MAX_SRC_PLANES) {
+        return CLIENT_ERROR;
+    }
+    if (n_rows > bitmap->Rows) {
+        n_rows = bitmap->Rows;
+    }
+    for (i_plane = 0; i_plane < bitmap->Depth; ++i_plane) {
+        planes[i_plane] = (u8 *)bitmap->Planes[i_plane];
+    }
+    for (; i_plane < MAX_SRC_PLANES; ++i_plane) {
+        planes[i_plane] = NULL;
+    }
+    if (bm_hdr->masking == MSK_HAS_MASK) {
+        planes[src_plane_cnt] = mask;   /* NULL se non richiesta */
+        ++src_plane_cnt;
+    }
+
+    null_dest = buffer;
+    buffer += src_row_bytes;
+    buf_size -= src_row_bytes;
+    buf = buffer + buf_size;
+
+    for (; n_rows != 0; --n_rows) {
+        for (i_plane = 0; i_plane < src_plane_cnt; ++i_plane) {
+            p_dest = &planes[i_plane];
+            if (*p_dest == NULL) {
+                null_buf = null_dest;
+                p_dest = &null_buf;
+            }
+            n_empty = (u16)(buf - buffer);
+            n_filled = (u16)(buf_size - n_empty);
+            if ((s32)n_filled < buf_row_bytes) {
+                /* Sposta i dati rimasti all'inizio e riempie il resto. */
+                exec_copy_mem(buf, buffer, n_filled);
+                if ((s32)n_empty > iff_chunk_more_bytes(context)) {
+                    n_empty = (u16)iff_chunk_more_bytes(context);
+                    buf_size = (s32)(u16)(n_filled + n_empty);
+                }
+                iffp = iff_read_bytes(context, buffer + n_filled, n_empty);
+                if (iffp != IFF_OKAY) {
+                    return iffp;
+                }
+                buf = buffer;
+                n_filled = (u16)buf_size;
+                n_empty = 0;
+            }
+            if (compression == 0) {
+                if (n_filled < src_row_bytes) {
+                    return BAD_FORM;
+                }
+                exec_copy_mem(buf, *p_dest, src_row_bytes);
+                buf += src_row_bytes;
+                *p_dest += src_row_bytes;
+            } else if (ilbm_unpack_row(&buf, p_dest, (s16)n_filled,
+                                       (s16)src_row_bytes)) {
+                return BAD_FORM;
+            }
+        }
+    }
+    return IFF_OKAY;
+}
diff --git a/src_c/readable/h087.h b/src_c/readable/h087.h
new file mode 100644
index 0000000..e6c3ea5
--- /dev/null
+++ b/src_c/readable/h087.h
@@ -0,0 +1,53 @@
+/* H087: lettura dei chunk ILBM (ilbmr.c di Electronic Arts): BMHD, CMAP, BODY. */
+#ifndef COK_H087_H
+#define COK_H087_H
+
+#include "h086.h"
+
+#define ID_ILBM COK_MAKE_ID('I', 'L', 'B', 'M')
+#define ID_BMHD COK_MAKE_ID('B', 'M', 'H', 'D')
+#define ID_CMAP COK_MAKE_ID('C', 'M', 'A', 'P')
+#define ID_BODY COK_MAKE_ID('B', 'O', 'D', 'Y')
+
+#define MAX_SRC_PLANES 0x11     /* 16 piani + maschera */
+#define MSK_HAS_MASK   1
+#define CMP_BYTE_RUN1  1
+
+/* BitMapHeader (20 byte nel file, big-endian). */
+typedef struct BitMapHeader {
+    u16 w;                      /* +$00 */
+    u16 h;                      /* +$02 */
+    s16 x;                      /* +$04 */
+    s16 y;                      /* +$06 */
+    u8 n_planes;                /* +$08 */
+    u8 masking;                 /* +$09 */
+    u8 compression;             /* +$0A */
+    u8 pad1;                    /* +$0B */
+    u16 transparent_color;      /* +$0C */
+    u8 x_aspect;                /* +$0E */
+    u8 y_aspect;                /* +$0F */
+    s16 page_width;             /* +$10 */
+    s16 page_height;            /* +$12 */
+} BitMapHeader;
+
+/* ILBMFrame ($66 byte nell'originale): ClientFrame + stato del lettore. */
+typedef struct ILBMFrame {
+    ClientFrame client_frame;   /* +$00 */
+    u8 found_bmhd;              /* +$10 */
+    u8 n_color_regs;            /* +$11 */
+    BitMapHeader bm_hdr;        /* +$12 */
+    u16 color_map[32];          /* +$26: colori RGB4 */
+} ILBMFrame;
+
+s32 ilbm_get_bmhd(GroupContext *context, BitMapHeader *bm_hdr); /* H087+$000C */
+s32 ilbm_get_cmap(GroupContext *context, u16 *color_map, u8 *n_color_regs);
+                                                                 /* H087+$009C */
+s32 ilbm_get_body(GroupContext *context, struct BitMap *bitmap, u8 *mask,
+                  BitMapHeader *bm_hdr, u8 *buffer, s32 buf_size);
+                                                                 /* H087+$0166 */
+u8  ilbm_unpack_row(u8 **source, u8 **dest, s16 src_bytes, s16 dst_bytes);
+                                                                 /* H088+$000C */
+u16 ilbm_row_bytes(u16 width);                                  /* H054+$000C */
+u16 ilbm_max_packed_size(u16 row_size);                         /* H099+$01B0 */
+
+#endif
diff --git a/src_c/readable/h088.c b/src_c/readable/h088.c
index e046da5..afc919a 100644
--- a/src_c/readable/h088.c
+++ b/src_c/readable/h088.c
@@ -1,7 +1,64 @@
 /* H088: UnPackRow ByteRun1 con aggiornamento dei puntatori. */
-#include "cok.h"
+#include "h087.h"
 
 /* PORT H088+$0004: link/unlk, nessun effetto. */
 void h088_init(void)
 {
 }
+
+/*
+ * PORT H088+$000C (UnPackRow, ByteRun1): decodifica dst_bytes byte da
+ * *source a *dest consumando al massimo src_bytes byte; aggiorna i due
+ * puntatori.  Restituisce 1 se i dati non bastano o eccedono, 0 se la riga
+ * e' completa.  n >= 0: n+1 byte letterali; -127..-1: il byte seguente
+ * ripetuto 1-n volte; -128: nessuna operazione.
+ */
+u8 ilbm_unpack_row(u8 **source, u8 **dest, s16 src_bytes, s16 dst_bytes)
+{
+    u8 *s = *source;
+    u8 *d = *dest;
+    u8 error = 1;
+    s16 n;
+    u8 c;
+
+    for (;;) {
+        if (!(dst_bytes > 0)) {
+            error = 0;
+            break;
+        }
+        if ((src_bytes = (s16)(src_bytes - 1)) < 0) {
+            break;
+        }
+        n = (s16)*s++;
+        if (n > 0x7F) {
+            n = (s16)(n - 0x100);
+        }
+        if (n >= 0) {
+            n = (s16)(n + 1);
+            if ((src_bytes = (s16)(src_bytes - n)) < 0) {
+                break;
+            }
+            if ((dst_bytes = (s16)(dst_bytes - n)) < 0) {
+                break;
+            }
+            do {
+                *d++ = *s++;
+            } while ((n = (s16)(n - 1)) > 0);
+        } else if (n != -128) {
+            n = (s16)(-n + 1);
+            if ((src_bytes = (s16)(src_bytes - 1)) < 0) {
+                break;
+            }
+            if ((dst_bytes = (s16)(dst_bytes - n)) < 0) {
+                break;
+            }
+            c = *s++;
+            do {
+                *d++ = c;
+            } while ((n = (s16)(n - 1)) > 0);
+        }
+    }
+    *source = s;
+    *dest = d;
+    return error;
+}
diff --git a/src_c/readable/h098.c b/src_c/readable/h098.c
index 8accfa5..df4f6b4 100644
--- a/src_c/readable/h098.c
+++ b/src_c/readable/h098.c
@@ -1,7 +1,77 @@
-/* H098: Backend di lettura/posizionamento file per il parser IFF. */
-#include "cok.h"
+/*
+ * H098: I/O con buffer per il parser IFF (gio.c di Electronic Arts).
+ *
+ * Dati del modulo (nel codice, H098+$0000..$0013):
+ *   $00 wWaterline  $04 wIndex  $08 wNBytes  $0C wBuffer  $10 wFile
+ * La scrittura con buffer serve solo a GWrite; in lettura wFile e' nullo e
+ * le routine vanno direttamente a Read/Seek.
+ */
+#include "h098.h"
+
+static s32 s_waterline;         /* H098+$0000 */
+static s32 s_index;             /* H098+$0004 */
+static s32 s_nbytes;            /* H098+$0008 (usato da GWriteDeclare) */
+static u8 *s_buffer;            /* H098+$000C */
+static cok_bptr s_file;         /* H098+$0010 */
 
 /* PORT H098+$0018: link/unlk, nessun effetto. */
 void h098_init(void)
 {
+    (void)s_nbytes;
+}
+
+/* PORT H098+$007C (GRead): svuota prima il buffer di scrittura del file. */
+s32 gio_read(cok_bptr file, void *buffer, s32 n_bytes)
+{
+    s32 result = 0;
+
+    if (file == s_file) {
+        result = gio_write_flush(file);
+    }
+    if (result >= 0) {
+        result = dos_read(file, buffer, n_bytes);
+    }
+    return result;
+}
+
+/* PORT H098+$00D0 (GWriteFlush) */
+s32 gio_write_flush(cok_bptr file)
+{
+    s32 result = 0;
+
+    (void)file;
+    if (s_file != 0 && s_buffer != NULL && s_index > 0) {
+        result = dos_write(s_file, s_buffer, s_waterline);
+    }
+    s_waterline = 0;
+    s_index = 0;
+    return result;
+}
+
+/*
+ * PORT H098+$0276 (GSeek): dentro il buffer di scrittura si sposta solo
+ * l'indice (OFFSET_CURRENT entro il livello raggiunto); altrimenti svuota il
+ * buffer e chiama Seek.  -2 significa "usa Seek".
+ */
+s32 gio_seek(cok_bptr file, s32 position, s32 mode)
+{
+    s32 result = -2;
+    s32 new_index = s_index + position;
+
+    if (file == s_file && s_buffer != NULL) {
+        if (mode == OFFSET_CURRENT && new_index >= 0 &&
+            new_index <= s_waterline) {
+            result = s_index;
+            s_index = new_index;
+        } else {
+            result = gio_write_flush(file);
+            if (result >= 0) {
+                result = -2;
+            }
+        }
+    }
+    if (result == -2) {
+        result = dos_seek(file, position, mode);
+    }
+    return result;
 }
