+/*
+ * COK_KEYS="ms=Nome,ms=Nome,...": per i test senza finestra, preme e
+ * rilascia il tasto SDL Nome (es. P, Return, Escape, Left) al tempo
+ * indicato in millisecondi dall'avvio del display.
+ */
+void host_input_script(unsigned long now)
+{
+    static int s_done;
+    const char *list = getenv("COK_KEYS");
+    const char *p = list;
+    int index = 0;
+
+    while (p != NULL && *p != 0) {
+        char name[32];
+        unsigned long t = strtoul(p, NULL, 10);
+        const char *eq = strchr(p, '=');
+        const char *end = strchr(p, ',');
+        size_t n;
+
+        ++index;
+        if (eq == NULL) {
+            break;
+        }
+        n = (size_t)((end != NULL ? end : eq + strlen(eq)) - (eq + 1));
+        if (n >= sizeof(name)) {
+            n = sizeof(name) - 1;
+        }
+        memcpy(name, eq + 1, n);
+        name[n] = 0;
+        if (index > s_done && now >= t) {
+            SDL_Event ev;
+
+            s_done = index;
+            memset(&ev, 0, sizeof(ev));
+            ev.type = SDL_KEYDOWN;
+            ev.key.keysym.scancode = SDL_GetScancodeFromName(name);
+            host_input_event(&ev);
+            ev.type = SDL_KEYUP;
+            host_input_event(&ev);
+        }
+        p = end != NULL ? end + 1 : NULL;
