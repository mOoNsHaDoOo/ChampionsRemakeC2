 }
 
+/*
+ * PORT H030+$00B6: count volte il carattere ch nella cella (col, row) e
+ * seguenti; uno spazio riempie le celle con il colore bg.  Fuori griglia o
+ * count 0: niente; a destra si taglia alla colonna 40.
+ */
+void draw_char_run(u16 col, u16 row, u16 fg, u16 bg, u16 count, u8 ch,
+                   u8 unused)
+{
+    char text[0x2C];                    /* -$2C(a5) */
+    u16 i;
+
+    (void)unused;
+    if (ch == ' ') {
+        fill_text_cells(col, row, bg, count);
+        return;
+    }
+    if (col > 0x27 || row > 0x18 || count < 1) {
+        return;
+    }
+    if ((u16)(col + count) > 0x28) {
+        count = (u16)(0x28 - col);
+    }
+    for (i = 0; i <= (u16)(count - 1); ++i) {
+        text[i] = (char)ch;
+    }
+    text[count] = 0;
+    ui_draw_text(col, row, fg, bg, 0x28, text);
+}
+
+/*
+ * PORT H030+$0A40: ora corrente in centesimi di secondo (CurrentTime:
+ * secondi * 100 + microsecondi / 10000).
+ */
+s32 time_hundredths(void)
+{
+    u32 seconds;
+    u32 micros;
+
+    intuition_current_time(&seconds, &micros);
+    return (s32)h015_mulu32(seconds, 100) +
+           h015_divs32((s32)micros, 10000, NULL);
+}
