+/*
+ * PORT H063+$321A (corpo a $3384): ridisegna la schermata secondo il modo
+ * di gioco $3DE3 (0 cornice del menu, 1 vista, 2 e 6 immagini "PIC" $3B e
+ * $3C, 3 e 4 combattimento/accampamento) e il party; $24E1 = 1.
+ */
+void redraw_game_screen(void)
+{
+    H005_B(0x24E1) = 1;
+    switch (H005_B(0x3DE3)) {
+    case 0:                             /* H063+$3238 */
+        draw_screen_frame(1);
+        break;
+    case 1:                             /* H063+$3244 */
+        if (H005_B(0x24C2)) {
+            h044_0330();
+        }
+        if (COK_GET16(g_state_a + 0x1CC) == 0) {
+            h042_0254(3, 3, 1, g_pic_rec_27c2);
+        } else {
+            h042_0d70(H005_B(0x2488), H005_B(0x2487));
+            h042_0ed2(3, 3, 1);
+        }
+        draw_party(g_current_char);
+        h063_33a0();
+        break;
+    case 2:                             /* H063+$32BC */
+        h044_0330();
+        h042_0406(3, "PIC", 0x3B, 0, &g_h005[0x27BC]);
+        draw_party(g_current_char);
+        h063_33a0();
+        break;
+    case 4:                             /* H063+$32EE */
+        h044_0330();
+        if (COK_GET16(g_state_a + 0x270) == 0) {
+            h060_0018();
+        }
+        draw_party(g_current_char);
+        h063_33a0();
+        H005_B(0x24B2) = 0;
+        break;
+    case 3:                             /* H063+$3320 */
+        if (H005_B(0x2486) != 9 && COK_GET16(g_state_a + 0x270) == 0) {
+            h060_0018();
+        }
+        break;
+    case 6:                             /* H063+$3346 */
+        h044_0330();
+        h042_0406(3, "PIC", 0x3C, 0, &g_h005[0x27BC]);
+        draw_party(g_current_char);
+        break;
+    default:
+        break;
+    }
+}
