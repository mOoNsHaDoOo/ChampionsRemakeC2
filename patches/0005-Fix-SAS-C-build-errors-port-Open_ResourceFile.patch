+    if (strchr(name, ':') != NULL && strchr(name, ':')[1] == 0) {
+        return 1;               /* solo il volume: la directory dei dati */
+    }
+    f = fopen(host_path(name), "rb");
     if (f == NULL) {
         return 0;
     }
@@ -111,9 +192,10 @@ cok_bptr dos_open(const char *name, s32 mode)
 
     for (i = 0; i < HOST_FILES; ++i) {
         if (s_files[i] == NULL) {
-            s_files[i] = fopen(name, how);
+            s_files[i] = fopen(host_path(name), how);
             if (s_files[i] == NULL && mode == MODE_READWRITE) {
-                s_files[i] = fopen(name, "w+b");  /* MODE_READWRITE crea */
+                /* MODE_READWRITE crea il file */
+                s_files[i] = fopen(host_path(name), "w+b");
             }
