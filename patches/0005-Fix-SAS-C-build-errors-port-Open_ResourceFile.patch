+int host_display_wait_key(void)
+{
+    SDL_Event ev;
+
+    if (!s_sdl_ready || s_window == NULL) {
+        return -1;
+    }
+    host_display_refresh(1);
+    while (SDL_WaitEvent(&ev)) {
+        if (ev.type == SDL_QUIT) {
+            exit(0);
+        }
+        if (ev.type == SDL_KEYDOWN) {
