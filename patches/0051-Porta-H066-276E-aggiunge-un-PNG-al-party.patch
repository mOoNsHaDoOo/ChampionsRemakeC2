     u16 v;                              /* -$C(a5) */
 
     read_operands(2);
-    h066_276e(eval_operand(1));
+    add_npc(eval_operand(1));
     v = (u16)(eval_operand(2) >> 1);
     v = or_byte((u8)v, 0x80);
     g_current_char->b[0xEC] = (u8)v;
diff --git a/src_c/readable/h066.c b/src_c/readable/h066.c
index 4ef2c5f..4405840 100644
--- a/src_c/readable/h066.c
+++ b/src_c/readable/h066.c
@@ -730,6 +730,25 @@ void load_character(u16 name_len, const char *name, Character *c,
     level_derived_values(c);
 }
 
+/*
+ * PORT H066+$276E: aggiunge al party il PNG npc (record dei mostri), se
+ * i membri (stato B +$67C) non sono piu' di 7: +$11C e' il suo numero e
+ * le icone 24x24 "CPIC" npc vanno nel suo posto (+$143).
+ */
+void add_npc(u16 npc)
+{
+    Character *c;                       /* -$8(a5) */
+
+    if (COK_GET16(g_state_b + 0x67C) > 7) {
+        return;
+    }
+    c = (Character *)exec_alloc_mem(sizeof(Character), COK_MEMF_CLEAR);
+    load_monster_record(npc, c);
+    c->b[0x11C] = (u8)npc;
+    add_to_party(c);
+    load_sprite_set(4, "CPIC", npc, c->b[0x143]);
+}
+
