+/* PORT H085+$0BC0 (annidata): prepara la linea da (x0, y0) a (x1, y1). */
+static void breath_line(BreathFrame *f, s16 x0, s16 y0, s16 x1, s16 y1)
+{
+    f->line.x0 = x0;
+    f->line.y0 = y0;
+    f->line.x1 = x1;
+    f->line.y1 = y1;
+    line_init(&f->line);
+}
