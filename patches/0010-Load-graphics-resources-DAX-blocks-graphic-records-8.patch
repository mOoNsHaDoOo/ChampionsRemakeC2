diff --git a/src_c/readable/tests/dax_test.c b/src_c/readable/tests/dax_test.c
new file mode 100644
index 0000000..046020b
--- /dev/null
+++ b/src_c/readable/tests/dax_test.c
@@ -0,0 +1,44 @@
+/*
+ * Estrae il blocco id dal contenitore name+ext con DAX_LoadBlock (H028) e
+ * lo scrive in out (byte decompressi, dimensione dichiarata + $100).
+ * Confronto: scripts/check_dax.py.
+ *   ./dax_test 8x8d1 .daa 202 out.bin
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include "../h028_files.h"
+#include "../globals.h"
+
+/* Le routine di errore e uscita non portate: qui segnalano e proseguono. */
+void h014_0018(u16 len, const char *msg, u16 value)
+{
+    (void)len;
+    printf("errore H014: %s %u\n", msg, value);
+}
+
+void h010_0332(void)
+{
+    printf("uscita H010+$0332\n");
+    exit(3);
+}
+
+int main(int argc, char **argv)
+{
+    u16 size = 0;
+    u8 *data = NULL;
+    FILE *out;
+
+    if (argc < 5) {
+        printf("uso: dax_test nome .ext id out.bin\n");
+        return 2;
+    }
+    G_RESOURCE_GROUP = 1;
+    dax_load_block((u16)strlen(argv[1]), argv[1], (u16)strlen(argv[2]),
+                   argv[2], (u16)atoi(argv[3]), &size, &data);
+    out = fopen(argv[4], "wb");
+    if (data != NULL) {
+        fwrite(data, 1, size, out);
+    }
+    fclose(out);
+    return data != NULL ? 0 : 1;
+}
