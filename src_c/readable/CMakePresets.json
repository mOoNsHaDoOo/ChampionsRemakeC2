{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Host (generatore predefinito)",
      "binaryDir": "${sourceDir}/build-cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 - x64 (AMD64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2022-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 - x86 (Win32)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build-vs2022-x86",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "vs2022-x64-debug", "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "vs2022-x86-debug", "configurePreset": "vs2022-x86", "configuration": "Debug" },
    { "name": "vs2022-x86-release", "configurePreset": "vs2022-x86", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default" }
  ]
}
